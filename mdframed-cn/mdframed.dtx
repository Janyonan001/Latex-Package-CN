% \section{钩子与布尔标志}\label{hooksandbools}
% 以下选项与布尔标志可供各类用户使用；当然
% 其中一些需要较深的使用经验。

% \ExplOpt[\{\}]{settings} 
% 本选项允许用户在 \Pack{mdframed} 开头提交一些宏代码。
% 所给内容在保存框开始之前执行。
%
% \ExplOpt[\{\}]{extra}
%      向每一个绘制出的边框追加内容。
% \ExplOpt[\{\}]{singleextra}
%      通过该键，可仅为未拆分的边框，向
%      \Pack{mdframed} 的绘制环境追加额外内容。
% \ExplOpt[\{\}]{firstextra}
%      通过该键，可仅为拆分边框的第一部分，向
%      \Pack{mdframed} 的绘制环境追加额外内容。
% \ExplOpt[\{\}]{middleextra}
%      通过该键，可仅为拆分边框的中间部分，向
%      \Pack{mdframed} 的绘制环境追加额外内容，且仅作用于拆分边框的中间部分。 
%      \limitation[TikZ、PSTricks]
% \ExplOpt[\{\}]{secondextra}
%      通过该键，可仅为拆分边框的最后一部分，向
%      \Pack{mdframed} 的绘制环境追加额外内容。
%
%
% 在能向边框各部分追加内容之外，还可以判断
% 当前绘制的是边框的哪一部分。为此定义了若干布尔标志，
% 可用 \Cmd{ifbool\{布尔标志名\}} 检测。输出
% 内容之前，所有标志均设为 true。
% \ExplOpt[false]{mdfsingleframe}
% 该布尔仅在未拆分的边框上为 true。
% \ExplOpt[false]{mdffirstframe}
% 该布尔仅在边框第一部分上为 true。
% \ExplOpt[false]{mdfmiddleframe}
% 同上。
% \ExplOpt[false]{mdflastframe}
% 同上。
%
% 面向高级用户，还有一些可用于调整输出的钩子：
% \ExplOpt[\{\}]{beforesingleframe}
% 传给本选项的代码在单个边框
% 排版之前执行。
% \ExplOpt[\{\}]{aftersingleframe}
% 传给本选项的代码在单个边框
% 排版之后执行。
% \ExplOpt[\{\}]{beforebreak}
% 本选项的值仅在可拆分的边框上执行。如前所述，
% 可作用于第一段与中间段边框。
% \ExplOpt[\{\}]{afterbreak}
% 本选项的值仅在可拆分的边框上执行。如前所述，
% 可作用于第一段与中间段边框。
% \ExplOpt[\{\}]{beforelastframe}
% 本选项仅在拆分边框的最后一段上执行。
% \ExplOpt[\{\}]{afterlastframe} 
% 本选项仅在拆分边框的最后一段上执行。
%
% \ExplOpt[\{\}]{startcode}
% 传给本选项的代码在环境
% 开头执行。
% \ExplOpt[\{\}]{startinnercode}
% 本选项在保存框开头执行。
% \ExplOpt[\{\}]{endinnercode}
% 本选项在保存框末尾执行。
% \ExplOpt[\{\}]{endcode}
% 本代码在环境末尾执行。
%
% \section{定理环境}
% 本节介绍哪些命令可用于配合 \Pack{mdframed} 定义
% 定理类环境。
% 
% \ExplCmd{newmdtheoremenv} 
% 由于本宏包常用来突出定理类环境，
% 因而提供了一条简化该过程的命令。命令语法
% 如下：
% 
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}[deletekeywords={mdframed}]
 \newmdtheoremenv[<mdframed 选项>]{<环境名>}%
                 [<编号参照>]{<标题>}[<编号层级>]
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 最后四个参数与命令 \Cmd{newtheorem} 相同。
% 只有第一个可选参数用于传递 \Pack{mdframed} 选项。
% 一个简单的示例如下：
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
 \theoremstyle{<定理样式>}
 \newmdtheoremenv[linecolor=blue]{lemma}{引理}[section]
 ...
 \begin{lemma}[标题示例]
   文本   文本   文本   文本   文本   文本
 \end{lemma}
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 目前还没有 \Cmd{renewmdtheoremenv}！
%
%
% \ExplCmd{mdtheorem} 
% 这是 \Cmd{newtheorem} 的一种特殊形式。命令语法
% 如下。
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}[deletekeywords={mdframed}]
 \mdtheorem[<mdframed 选项>]{<环境名>}%
                 [<编号参照>]{<标题>}[<编号层级>]
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 可以看到，各参数与 \Cmd{newtheorem} 相同，但该命令
% 会忽略所有 \Cmd{theoremstyle}。这是基于以下
% 设计。
%
% 命令 \Cmd{mdtheorem} 根据给定的第一个必选参数
% 创建两个环境。第一个环境以该参数命名，生成带编号的定理；
% 第二个环境在第一个必选参数名后加星号，
% 排版格式相同，但不带编号。
%
% 新定义环境的语法与普通定理
% 环境相同。
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}[deletekeywords={mdframed}]
 \begin{环境}[可选标题]
  ...
 \end{环境}
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 原理是：命令的标题文字会被用作边框标题。
% 这样便可使用边框标题的全部选项。此外
% \Pack{mdframed} 还提供了下文说明的附加选项。
%
% \ExplOpt[\{:\}]{theoremseparator}
%      设置定理编号与标题之间的分隔符。
%      仅当给出定理标题时，才会打印
%      \Opt{theoremseparator}。
% \ExplOpt[\{\}]{theoremtitlefont}
%      通过选项 \Opt{frametitlefont} 可以调整
%      边框标题的字体；而选项 \Opt{theoremtitlefont} 允许
%      为定理标题设置另一种字体。
% \ExplOpt[\protect\Cmd{space}]{theoremspace}
%      设置 \Opt{theoremseparator} 之后的间距。
%
% 示例可参见随附文件。
%
%
%
%
% \section{复杂示例 —— Matlab 命令行窗口}
% 下面这个示例改编自 TeX.SX 上的一个提问。
% \definecolor{DarkBlue}{rgb}{.11,.23,.60}
% \mdfdefinestyle{commandline}%
% {leftmargin=5pt, rightmargin=10pt,innerleftmargin=15pt,
%  middlelinecolor=DarkBlue,
%  middlelinewidth=2pt,
%  frametitlerule=false,
%  backgroundcolor=black!10!white,
%  frametitle={命令窗口},
