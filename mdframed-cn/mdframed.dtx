\begin{tltxmdfexample*}
\global\mdfapptodefinestyle{exampledefault}{%
 topline=false,bottomline=false}
\begin{mdframed}[style=exampledefault,frametitle={Inhomogeneous linear}]
\ExampleText
\end{mdframed}
\end{tltxmdfexample*}

