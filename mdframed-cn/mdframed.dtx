% \section{设计动机}
% 许多用户希望（进一步）突出引理、定义、证明等内容。
%  \Pack{mdframed} 宏包允许你创建带可跨页边框的环境。
% 我认为示例是展示其特性的最佳方式。
% 
% \newmdtheoremenv[%
%    outerlinewidth  = 2             ,%
%    roundcorner     = 10pt          ,%
%    leftmargin      = 40            ,%
%    rightmargin     = 40            ,%
%    backgroundcolor = yellow!40     ,%
%    outerlinecolor  = blue!70!black ,% 
%    innertopmargin  = \topskip      ,%
%    splittopskip    = \topskip      ,%
%    ntheorem        = true          ,% 
%   ]{theorem}{定理}[section]
% 
% \begin{theorem}[勾股定理]
%  在任意直角三角形中，以斜边为边长的正方形面积，
%  等于以两条直角边为边长的正方形面积之和。
%  
% \[ a^2+b^2=c^2 \]
% \end{theorem}
% 
% 该边框由以下设置定义。
% 
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}[columns=fixed,fontadjust=false]
 \newmdtheoremenv[%
    outerlinewidth  = 2             ,%
    roundcorner     = 10pt          ,%
    leftmargin      = 40            ,%
    rightmargin     = 40            ,%
    backgroundcolor = yellow!40     ,%
    outerlinecolor  = blue!70!black ,% 
    innertopmargin  = \topskip      ,%
    splittopskip    = \topskip      ,%
    ntheorem        = true          ,% 
   ]{theorem}{定理}[section]
 \begin{theorem}[勾股定理]
 ...
 \end{theorem}
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 
% 
% \section{语法}\label{sec:syntax}
% 
% \minisec{\Pack{mdframed} 所需的宏包}
% 宏包本身会加载以下宏包：
%  \begin{center}
%   \Pack{kvoptions}\qquad\Pack{xparse}\qquad\Pack{etoolbox}
%   \quad\Pack{color}.
%  \end{center}
% 根据选项 \Opt{framemthod} 的不同，\Pack{mdframed} 还会加载：
%  \begin{center}
%   \Pack{xcolor}\qquad\Pack{tikz}\qquad\Pack{pstricks}.
%  \end{center}
% 
% 按常规方式加载本宏包：
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
  \usepackage[<全局选项>]{mdframed}
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 
% 只有选项 \Opt{framemethod} 应当通过 \Cmd{usepackage} 的
% 可选参数传入；其余选项都应通过 \Cmd{mdfsetup} 或相关环境设置。
% 如果你需要用到 \Pack{amsthm}，应在它之后再加载本宏包。
% \minisec{提供的环境}
% 本宏包只定义了一个环境，语法如下：
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
  \begin{mdframed}[<局部选项>]
     <内容>
  \end{mdframed}
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
