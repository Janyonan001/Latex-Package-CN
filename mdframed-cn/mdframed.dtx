% \subsection{\Pack{mdframed} 的工作原理}
% 通过环境 \Cmd{begin\{mdframed\}} \ldots \Cmd{end\{mdframed\}}，
% 全部内容会保存在名为
% \Cmd{mdf@splitbox@one} 的 \Cmd{savebox} 中。在计算出
% \Cmd{mdf@splitbox@one} 的宽度与高度（由 \Pack{mdframed.sty} 完成）之后，
% 依次放置该框（由 \Pack{md-frame-X.mdf} 完成）。下图演示了
% 这一过程。
% 
% \begin{center}
% \begin{tikzpicture}
% \newcommand{\mybox}[1]{\parbox{3.5cm}{\centering\small #1}}
% \tikzstyle{every node}=[font=\sffamily]
% \tikzset{mymatrixnodes/.style={%
%      matrix of nodes,
%      nodes={framed,draw=black,fill=yellow!10,},
%      column sep=4.5cm,
%      row sep=1.5cm,
%      }}
% \matrix(m)[mymatrixnodes]
%   {%
%    \mybox{读入内容并存入 \Cmd{mdf@splitbox@one}}              &
%    \mybox{\Cmd{mdf@putbox@single}}                                         \\
%    \mybox{将 \textbackslash mdf@splitbox@one 拆分到
%           页面剩余空间中的 \Cmd{mdf@splitbox@two}}                                       &
%    \mybox{\Cmd{mdf@putbox@first}}                                          \\
%    \mybox{\Cmd{mdf@splitbox@one} 的内容在新
%           页面上有足够空间}                                                             &
%    \mybox{\Cmd{mdf@putbox@second}}                                         \\
%    \mybox{将 \Cmd{mdf@splitbox@one} 拆分到页面剩余空间中的
%           \Cmd{mdf@splitbox@two}}                                                &
%    \mybox{\Cmd{mdf@putbox@middle}}                                         \\
% };
% 
% \tikzstyle{every path}=[black,-triangle 45,thick,shorten >=4pt,shorten <=4pt]
% \draw  (m-1-1) edge 
%        node[align=center,anchor=south]{页面上空间足够} (m-1-2);
% \draw  (m-2-1) edge 
%        node[align=center,anchor=south]{排出 \Cmd{mdf@splitbox@two}}
%         (m-2-2);
% \draw  (m-3-1) edge 
%        node[align=center,anchor=south]{是} (m-3-2);
% \draw  (m-4-1) edge 
%        node[align=center,anchor=south]{排出 \Cmd{mdf@splitbox@two}}
%         (m-4-2);
% 
% \draw  (m-2-2) edge node[align=center,fill=white]%
%        {计算新 \Cmd{mdf@splitbox@one} 的高度} (m-3-1);
% 
% 
% \draw  (m-1-1) edge 
%        node[align=center,anchor=west]{页面上空间不足} (m-2-1);
% \draw  (m-3-1) edge node[align=center,anchor=west]{否} (m-4-1);
% 
% \draw  let \p1=($(m-4-2.south)-(0,1)$), \p2=($(m-3-1.west)-(0.8,0)$) in
%       (m-4-2.south) -- ($(m-4-2.south)+(0,-1)$) --
%            node[align=center,anchor=north]%
%            {计算新 \Cmd{mdf@splitbox@one} 的高度} (\x2,\y1)
%        -- ($(m-3-1.west)-(0.8,0)$)-- ($(m-3-1.west)$) ;
% 
% 
% \end{tikzpicture}
% 
% \captionof{figure}{\Pack{mdframed} 内容的安放方式}\label{fig:way}
% \end{center}
% 
% 内容宽度由以下设置共同决定：
% \Opt{leftmargin}、\Opt{rightmargin}、\Opt{linewidth}、
% \Opt{innerleftmargin} 与 \Opt{innerrightmargin}
% （见图 \eqref{fig:laengen}）。
% 
% \subsection{边框命令}
% \Pack{mdframed} 认识四种“边框命令”。
% 这些命令告诉 \LaTeX\ 如何安放 \Pack{mdframed} 的内容。 
% \begin{description}
%   \item[\Cmd{mdf@putbox@single}] 
%        安放单个未拆分边框的内容。
%   \item[\Cmd{mdf@putbox@first}]  
%        安放拆分边框第一段的内容。
%   \item[\Cmd{mdf@putbox@middle}] 
%        安放拆分边框中间段的内容。
%   \item[\Cmd{mdf@putbox@second}] 
%        安放拆分边框最后一段的内容。
% \end{description}
% 
% 借助上述命令给出一个示例。命令 \Cmd{box}
% 取出保存框中的内容并排版输出。
% 
% 首先排出不带任何设置（但带有已计算宽度）的单个框。
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
 \makeatletter
  \def\mdf@putbox@single{\box\mdf@splitbox@one}
 \makeatother
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 这里使用命令 \Cmd{leftline}，使“边框命令”从
% 左侧开始。
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}[deletekeywords={leftline},moretexcs={leftline}]
 \makeatletter
  \def\mdf@putbox@single{\leftline{\box\mdf@splitbox@one}}
 \makeatother
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 
% 接下来需要了解各长度的命名方式。所有可由选项
% 修改的长度均采用以下语法：
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
 \mdf@<长度名称>@length
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 例如 leftmargin 对应的长度为：
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
 \mdf@leftmargin@length
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 
% 若只想绘制一条带正确 \Opt{leftmargin} 的左边线，
% 可按如下方式定义 \Cmd{mdf@putboxsingle}。
% 
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}[deletekeywords={leftline},moretexcs={leftline}]
 \makeatletter
 \def\mdf@putbox@single{%
          \leftline{%
              \hspace*{\mdf@leftmargin@length}%
              \rule[-\dp\mdf@splitbox@one]{\mdf@linewidth}%
                   {\ht\mdf@splitbox@one+\dp\mdf@splitbox@one}%
              \box\mdf@splitbox@one
          }%
 }
 \makeatother
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
% 
% 这样便可实现你想要的效果。若创建自己的样式，
% 可将文件保存为 \Pack{md-frame-X.mdf}。
% 其中 \Pack{X} 必须为整数。
% 之后即可通过选项 \Opt{framemethod}，
% 设为 \Opt{framemethod=X} 来载入该文件。
% 
