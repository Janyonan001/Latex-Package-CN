\def\mdf@frame@leftline@single{%
  \llap%
   {%
    \mdf@linecolor@default%
    \rule[-\mdfboundingboxdepth]%
         {\mdf@middlelinewidth@length}%
         {\dimexpr
            \mdfboundingboxtotalheight%
