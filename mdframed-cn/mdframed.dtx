% \subsection{环境内部的标题命令}
%
% 若要在 \Pack{mdframed} 环境内部提供小标题，可使用
% 命令 \Cmd{mdfsubtitle}。相关选项列于下文。
%
% \ExplCmd{mdfsubtitle} 
%      在 \Pack{mdframed} 内部设置内部一级小标题。
%
% 该命令接受一个可选参数和一个
% 必选参数。可选参数用于设置 \Pack{mdframed} 选项，
% 且仅在局部生效；小标题的第二个参数也允许
% 分段。
%
% \Cmd{mdfsubtitle} 内部不支持换行分段。
%
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
  \mdfsubtitle[<选项>]{小标题}
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
%
%
% \subsubsection{与一级标题相关的选项}
% \ExplOpt[false]{subtitleaboveline}
%     是否在小标题上方绘制一条线。
% \ExplOpt[false]{subtitlebelowline}
%     是否在小标题下方绘制一条线。
% \ExplOpt[\string\normalfont\string\bfseries]{subtitlefont}
%     设置小标题的字体。
% \ExplOpt[white]{subtitlebackgroundcolor}
%     设置小标题在上下两条线之间的
%     背景颜色。
% \ExplOpt[black]{subtitleabovelinecolor}
%     设置上方线条的颜色。
% \ExplOpt[black]{subtitlebelowlinecolor}
%     设置下方线条的颜色。
% \ExplOpt[0.8\,pt]{subtitleabovelinewidth}
%     设置上方线条的宽度。
% \ExplOpt[0.6\,pt]{subtitlebelowlinewidth}
%     设置下方线条的宽度。
% \ExplOpt[\string\baselineskip]{subtitleaboveskip}
%     设置绘制上方线之前的间距。
% \ExplOpt[1.2\string\baselineskip]{subtitlebelowskip}
%     设置绘制下方线之后的间距。
% \ExplOpt[0.5\string\baselineskip]{subtitleinneraboveskip}
%     设置上方线与小标题本身之间的间距。
% \ExplOpt[0.5\string\baselineskip]{subtitleinnerbelowskip}
%     设置小标题与下方线之间的间距。
%
% 下面用一个示例演示其效果：
%
%\newmdenv[%
% roundcorner=5pt,nobreak=true,
% subtitlebelowline=true,subtitleaboveline=true,
% subtitlebackgroundcolor=yellow!70!white,
% backgroundcolor=blue!20!white,
% frametitle={定理},frametitlerule=true,
% frametitlebackgroundcolor=yellow!70!white,
% ]{subtitleenv}
%
% \begin{subtitleenv}
%   若干文字 \ldots
%   \mdfsubtitle{注记}
%   若干文字 \ldots
% \end{subtitleenv}
%
% \iffalse
%<*example>
% \fi
\begin{tltxmdfexample}
\newmdenv[%
 roundcorner=5pt,
 subtitlebelowline=true,subtitleaboveline=true,
 subtitlebackgroundcolor=yellow!70!white,
 backgroundcolor=blue!20!white,
 frametitle={定理},frametitlerule=true,
 frametitlebackgroundcolor=yellow!70!white,
 ]{subtitleenv}
\begin{subtitleenv}
  一些文本 \ldots
  \mdfsubtitle{注记}
  一些文本 \ldots
\end{subtitleenv}
\end{tltxmdfexample}
% \iffalse
%</example>
% \fi
