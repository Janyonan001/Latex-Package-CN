        \ifdefempty{\mdf@frametitle}{}%
            {\mdfframedtitleenv{\mdf@frametitle}\mdf@@frametitle@use}%
        \detected@mdf@put@frame}%
   \else%
      \def\mdf@reserveda{%
        \mdf@endinnercode%
