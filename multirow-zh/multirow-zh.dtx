% \changes{v1.9}{2016/09/15}{为 \Package{multirow} 提供独立的临时
% 寄存器，以便把盒子高度安全地传递给 \Package{bigdelim}。}
% \changes{v2.2}{2016/11/25}{移除 \cs{multirow@cnta}。}
% \begin{macro}{\multirow@cntb}
% \begin{macro}{\multirow@dima}
%   定义两个计数器和一个长度，供 \cs{multirow} 内部使用。
