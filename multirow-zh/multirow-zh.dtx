% \begin{macro}{\multirow@setcolwidth}
% 该宏为宽度取“\texttt{=}”的条目计算 \cs{multirow@colwidth}。我们通过检查 \cs{TY@final} 是否定义来判断是否处于 \env{tabulary} 环境中；若否，则 \cs{multirow@colwidth} = \cs{hsize}。\env{tabulary} 会进行两遍排版：第一遍把 \cs{multirow@colwidth} 设为文本在 LR 模式下的尺寸（换行符替换为空格），以使 \env{tabulary} 给出足够空间；第二遍（以 \cs{TY@box} = \cs{TY@box@v} 为标志）则采用 \env{tabulary} 在 \cs{hsize} 中给出的值。该算法并不完美，但在多数情况下足够好用。
%
%
%
%
%
%
%
%
%
% \changes{v2.7}{2021/01/29}{将 \cs{multirow@setcolwidth} 改为 \cs{long} 定义，以支持多段文本}
%
%    \begin{macrocode}
\long\def\multirow@setcolwidth#1{%
    \ifx\TY@final\multirow@undefined \multirow@colwidth=\hsize
    \else
      \ifx\TY@box\TY@box@v\multirow@colwidth=\hsize
      \else \setbox0\hbox
        {\let\\\space\let\newline\space #1}\multirow@colwidth=\wd0
      \fi
    \fi}
%    \end{macrocode}
% \end{macro}
