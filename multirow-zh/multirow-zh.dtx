% \begin{macro}{\multirowsetup}
% \cs{multirowsetup} 在每个 \cs{multirow} 开始处执行。
%    \begin{macrocode}
\newcommand\multirowsetup{\raggedright}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\multirow@vbox}
% 生成 \cs{vbox}。参数：\\
% \texttt{\#1} = \meta{vpos}，\texttt{\#2} = 初始化代码（例如设置 \cs{parbox} 的宽度），\texttt{\#3} = 盒子内容。\\
%
% 根据 \meta{vpos} 参数，盒子将顶部对齐、垂直居中或底部对齐；这通过在相应位置插入 \cs{vfill} 实现。\\
%
%
% 注意：\cs{relax} 用于防止 \meta{vpos} 参数为空。
%
%    \begin{macrocode}
\long\def\multirow@vbox#1#2#3{\setbox0\vtop to \multirow@dima{#2%
    \if #1t\relax\else\vfill\fi
    \multirowsetup #3\if #1b\relax\else\vfill\fi}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\multirow}
% 生成一个跨越表格多行的条目。\\
% 首先收集所有参数，并用默认值补齐缺失的可选参数。
% \changes{v1.8}{2016/09/14}{增加第一个可选参数 \meta{vpos}。}
%    \begin{macrocode}
%% \multirow [vpos] {nrows} [bigstruts] {width} [vmove] {text}
\newcommand\multirow[2][c]{\@multirow[#1]{#2}}
\def\@multirow[#1]#2{\@ifnextchar[{\@@multirow[#1]#2}{\@@multirow[#1]#2[0]}}
\def\@@multirow[#1]#2[#3]#4{\@ifnextchar[{\@xmultirow[#1]{#2}[#3]{#4}}%
                                {\@xmultirow[#1]{#2}[#3]{#4}[0pt]}}
%    \end{macrocode}
% \changes{v1.9a}{2016/09/23}{为 \meta{bigstruts} 参数增加可选前缀。}
% \begin{macro}{\multirow@piii}
% \begin{macro}{\ifmultirow@prefixt}
% \begin{macro}{\multirow@prefixttrue}
% \begin{macro}{\multirow@prefixtfalse}
% \begin{macro}{\ifmultirow@prefixb}
% \begin{macro}{\multirow@prefixbtrue}
% \begin{macro}{\multirow@prefixbfalse}
% 该宏从 \meta{bigstruts} 参数中分离出 \texttt{t}、\texttt{b} 或 \texttt{tb} 前缀，并把数值赋给 \cs{multirow@cntb}。前缀记录在两个布尔开关 \cs{ifmultirow@prefixt} 与 \cs{ifmultirow@prefixb} 中。
%
%
%
%    \begin{macrocode}
\newif\ifmultirow@prefixt
\newif\ifmultirow@prefixb
\def\multirow@piii#1#2#3\end{\multirow@prefixtfalse\multirow@prefixbfalse
  \if t#1\multirow@prefixttrue
    \if b#2\multirow@prefixbtrue \multirow@cntb=#3%
    \else \multirow@cntb=#2#3%
    \fi
  \else
    \if b#1\multirow@prefixbtrue \multirow@cntb=#2#3%
    \else \multirow@cntb=#1#2#3%
    \fi
  \fi}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
% \end{macro}
%
% 这是真正的核心宏。先拆分 \meta{bigstruts} 参数，然后计算跨行盒子的高度。
%
% \changes{v2.2}{2016/11/25}{支持 \meta{nrows} 取小数值。}
% 由于 \meta{nrows}（\verb+#2+）可能为小数，不能用 \cs{ifnum} 判断正负，因此在数字后加上单位（\texttt{pt}）改用 \cs{ifdim}。
%
%
% \changes{v2.4}{2019/01/01}{支持 \meta{width} 与 \meta{vmove} 使用与 \Package{calc} 兼容的表达式。}
%
% \changes{v2.7}{2021/01/29}{将 \cs{@xmultirow} 改为 \cs{long} 定义，以支持多段文本}
%
%    \begin{macrocode}
\long\def\@xmultirow[#1]#2[#3]#4[#5]#6{%
  \expandafter\multirow@piii#3\relax\end%
  \setlength\multirow@dima{#2\ht\@arstrutbox}%
  \addtolength\multirow@dima{#2\dp\@arstrutbox}%
  \ifdim#2pt<\z@\setlength\multirow@dima{-\multirow@dima}\fi
  \addtolength\multirow@dima{\multirow@cntb\bigstrutjot}%
%    \end{macrocode}
% \changes{v1.9a}{2016/09/23}{重做 \cs{vbox} 的计算与定位。}
% 文本通过调用 \cs{multirow@vbox} 排入 \cs{vbox}。\\
% 若 \meta{width} 参数为 \texttt{*}，则只把文本放入 \cs{vbox}。
%    \begin{macrocode}
  \if*#4\multirow@vbox{#1}{}{\hbox{\strut#6\strut}}%
%    \end{macrocode}
% 否则把文本放入 \cs{vbox} 内的 \cs{parbox} 中。\\
% 若 \meta{width} 参数取“\texttt{=}”，则先计算 \cs{multirow@colwidth}，并将其作为 \cs{parbox} 的宽度。
%
%    \begin{macrocode}
  \else \if=#4\multirow@setcolwidth{#6}%
    \multirow@vbox{#1}{\setlength\hsize{\multirow@colwidth}\@parboxrestore}{\strut#6\strut\par}%
%    \end{macrocode}
% 否则把给定参数用作 \cs{parbox} 的宽度。
%    \begin{macrocode}
  \else \multirow@vbox{#1}{\setlength\hsize{#4}\@parboxrestore}{\strut#6\strut\par}%
  \fi \fi
%    \end{macrocode}
% 接下来正确定位 \cs{vbox}。细节见附录；平移量计算的概览见第~\ref{sec:overview} 节。
%
%
%
% 当 \meta{nrows}${}> 0$ 时：\\
% 若 \meta{vpos} = \texttt{[t]}，盒子已定位正确（基线位于该行基线上）。但稍后会以盒子顶部（而非基线）作为参考点，因此取盒子高度 h 作为平移量。见图~\ref{fig:top-t}。\\
%
%
%
%
% 若 \meta{vpos} = \texttt{[c]}，上移 h1（见图~\ref{fig:top-c}），其中 h1 = \cs{ht}\cs{@arstrutbox} +（\cs{bigstrutjot} \cs{ifmultirow@prefixt}）。\\
%
% 若 \meta{vpos} = \texttt{[b]}，上移 h1 + h2（见图~\ref{fig:top-b}），其中 h2 = \cs{dp}\cs{@arstrutbox} +（\cs{bigstrutjot} \cs{ifmultirow@prefixb}）。\\
%
% 所需平移量在 \cs{multirow@dima} 中计算。
%    \begin{macrocode}
  \ifdim#2pt>\z@
    \if#1t\relax\setlength\multirow@dima{\ht0}\else
      \setlength\multirow@dima{\ht\@arstrutbox}%
      \ifmultirow@prefixt \addtolength\multirow@dima{\bigstrutjot}\fi
      \if#1b\relax \addtolength\multirow@dima{\dp\@arstrutbox}%
        \ifmultirow@prefixb \addtolength\multirow@dima{\bigstrutjot}\fi
      \fi
    \fi
%    \end{macrocode}
% 当 \meta{nrows}${}< 0$ 时：\\
% 若 \meta{vpos} = \texttt{[t]}，把盒子上移 $\textrm{H} - \textrm{h1} -\textrm{h2} + \textrm{h}$。见图~\ref{fig:bot-t}。\\
%
% 若 \meta{vpos} = \texttt{[c]}，把盒子上移 $\textrm{H} - \textrm{h2}$。见图~\ref{fig:bot-c}。\\
% 若 \meta{vpos} = \texttt{[b]}，把盒子上移 H。见图~\ref{fig:bot-b}。\\
% H 为 \cs{multirow@dima} 的当前值。
%    \begin{macrocode}
  \else
    \if#1b\relax\else
      \addtolength\multirow@dima{-\dp\@arstrutbox}%
      \ifmultirow@prefixb \addtolength\multirow@dima{-\bigstrutjot}\fi
      \if#1t\relax\addtolength\multirow@dima{-\ht\@arstrutbox}%
        \ifmultirow@prefixt \addtolength\multirow@dima{-\bigstrutjot}\fi
        \addtolength\multirow@dima{\ht0}%
      \fi
    \fi
  \fi
%    \end{macrocode}
% \changes{v2.1}{2016/10/11}{把最终 \cs{vbox} 的深度设为 0，以防止过高的跨行行把后续行向下推。}
%
% 最后加上 \meta{vmove} 参数（\verb+#5+），进入水平模式。然后在盒子上方放置 \cs{vskip} 使其上移，再加入输出。由于该 \cs{vskip}，所得盒子高度为 0；我们把 \cs{vbox} 的深度也设为 0，以免影响当前行的深度。\\
%
%
%
%
% 若 \cs{multirowdebug} 为真，则显示该盒子。
%    \begin{macrocode}
  \addtolength\multirow@dima{#5}%
  \leavevmode
  \setbox0\vtop{\vskip-\multirow@dima\box0\vss}\dp0=\z@
  \ifmultirowdebug{\showboxdepth=5 \showboxbreadth=10 \showbox0}\fi
  \box0
}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\bigstrutjot}
% 若尚未定义，则定义 \cs{bigstrutjot}。
%    \begin{macrocode}
\@ifundefined{bigstrutjot}{\newdimen\bigstrutjot \bigstrutjot=\jot}{}
%    \end{macrocode}
% \end{macro}
