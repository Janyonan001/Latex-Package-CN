%   \item[\UserDefined]
%   也可使用 |\Declare|\-|Caption|\-|List|\-|Format| 自定义目录格式。
%   \SeeUserDefined
% \end{Options}
%
% 编号（即 |\the|\-|figure| 或 |\the|\-|table|）之前的前缀
% （即 |\p@figure| 或 |\p@table|）在目录（如插图/表格目录）和引用中
% 通常为空，因此目录格式 |simple| 与 |subsimple| 结果相同，|parens|
% 与 |subparens| 亦然。但当子插图、子表格列入插图目录或表格目录时，
% 或标签前缀被另作他用时，情况可能不同。\footnote{%
%   子插图与子表格可使用 \pkg{subcaption} 或 \pkg{subfig} 宏包排版。}
