%  设置在盒子 |\@floatcapt| 内部，不带额外竖直间距。
%    \begin{macrocode}
      \renewcommand\caption@setfloatcapt[1]{%
        \let\@makecaption\caption@@make
        \global\setbox\@floatcapt\vbox{%
