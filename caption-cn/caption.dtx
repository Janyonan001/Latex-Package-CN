% \section{支持的文档类}
% \label{classes}
%
% 本节概述 \pkg{caption} 支持哪些文档类：它们在题注方面已提供哪些功能、
% 搭配 \pkg{caption} 宏包使用时会产生哪些副作用，以及各自的“默认”设置
% 是什么。
%
% \NEWfeature{v3.1}
% “默认”设置取决于所使用的文档类，它代表文档类作者所期望的题注外观。
% 因此，例如设置 |format=|\x|default|，在不同文档类下可能得到不同的
% 视觉设计。
%
% \begingroup\setlength\leftmargini{0.3em}% default = 2.5em
% \INFO
% 若本节中找不到你所用的文档类，通常无需担心：许多文档类（例如
% \cls{octavo}）派生自标准文档类 \cls{article}、\cls{report} 或
% \cls{book} 之一，在题注方面行为相同。\Thispackage\ 会自动对照所用
% 文档类进行兼容性检查；若检测到不兼容，将给出明确警告
% \begin{quote}\footnotesize
%   |Package caption Warning: Unsupported document class (or package) detected,|\\
%   |(caption)                usage of the caption package is not recommended.|\\
%   |See the caption package documentation for explanation.|
% \end{quote}
% 未收到此类警告即一切正常；若收到，则不建议使用 \thispackage，
% 尤其不提供支持。
% \endgroup
%
% \begin{Expert}
% 若收到此类兼容性警告，但仍决定使用 \thispackage{}，应仔细观察出现的
% 副作用：通常仅加载不带选项的 \thispackage{}，题注外观就会改变，即不再
% 呈现文档类作者本意的样子。若可以接受，应先通过
% |\use|\-|package[style=|\x|base]{caption}| 或
% |\caption|\-|setup{style=|\x|base}| 指定选项 |style=|\x|base|，把
% \thispackage\ 置于定义明确的状态；之后再逐步添加自己的选项，并
% 祝好运。
% \end{Expert}
%
% \newcommand*\Option{选项}
% \newcommand*\defaultvalue{默认取值}
% \newcommand*\uses{\textit{采用}}
% \newcommand*\settings{\textit{设置}}
% \newcommand*\nofont{\textit{无}}
%
% \subsection{标准 \LaTeX：article、report 与 book}
%
% \begin{tabular}{ll}
% \Option          & \defaultvalue \\\hline
% |format=|        & |plain| \\
% |labelformat=|   & |simple| \\
% |labelsep=|      & |colon| \\
% |justification=| & |justified| \\
% |font=|          & \nofont \\
% |labelfont=|     & \nofont \\
% |textfont=|      & \nofont \\
% \end{tabular}
%
% \begin{Annotation}
% 派生自这些文档类的其他文档类同样适用。
% \end{Annotation}
%
% \subsection{\AmS：amsart、amsproc 与 amsbook}
% \label{AMS}
%
% \begin{tabular}{ll}
% \Option          & \defaultvalue \\\hline
% |format=|        & |plain| \\
% |labelformat=|   & |simple| \\
% |labelsep=|      & |.\enspace| \\
% |justification=| & |justified| \\
% |font=|          & |\@captionfont| \\
% |labelfont=|     & |\@captionheadfont| \\
% |textfont=|      & |\@captionfont\upshape| \\
% \end{tabular}
%
% \begin{Annotation*}
% \AmS\ 文档类会把 |\@caption|\-|font| 设为 |\normal|\-|font|，把
% |\@caption|\-|head|\-|font| 设为 |\sc|\-|shape|。
% \end{Annotation*}
%
% 此外，多行题注的边距设为 |\caption|\-|indent|（\AmS\ 类将其设为
% |3pc|），单行题注的边距则为它的一半。若希望两者使用相同边距，可在
% 加载 \thispackage 之后，于文档导言区插入
