%  |\@float@setevery|\marg{浮动体类型} 由 \pkg{float} 宏包提供；每当用
%  |\newfloat| 或 |\restylefloat| 定义的浮动环境开始时调用。我们利用该
%  钩子做一些适配，并设置合适的题注样式（若已定义）以及通过
%  |\captionsetup|\oarg{浮动体样式} 声明的附加设置。
%    \begin{macrocode}
  \let\caption@ORI@float@setevery\@float@setevery
  \def\@float@setevery#1{%
    \float@ifcaption{#1}{%
%    \end{macrocode}
%
%  首先，通过将 |\@fs@iftopcapt|（浮动体样式的一部分，控制题注排在浮动
%  体内容上方还是下方）转换为本宏包的 |position=| 设置，把题注位置设为
%  正确值。由于题注上下间距由浮动体样式、\emph{而非} 本宏包负责，这看似
%  无用；但实际并非如此，因为基于 \thispackage\ 的某些宏包（如
%  \pkg{subfig}）可能需要该信息，因而会使用本内核提供的
%  |\caption@iftop| 宏。此外，|\captionof| 最终借助 |\@makecaption|
%  排版带间距的题注，本宏包自身也需要该信息。
%    \begin{macrocode}
      \caption@setposition{\@fs@iftopcapt t\else b\fi}%
%    \end{macrocode}
