% \changes{v3.3}{2011/12/28}{加入 \cs{ifcaption@caption}、\cs{ifcaption@subcaption} 与 \cs{ifcaption@ContinuedFloat} 的使用}
% \changes{v3.5e}{2020/09/28}{修复 \cs{stepcounter} 重定义中的缺陷；现使用 \cs{edef} 而非 \cs{def}}
% \changes{v3.6}{2020/09/20}{标志处理抽出到 \cs{caption@ifrefstepcounter}}
% \changes{v3.6}{2020/12/27}{\cs{caption@@@refstepcounter} 改名为 \cs{caption@refstepcounter@}}
% \changes{v3.6}{2021/01/09}{适配 \cs{caption@prepare@stepcounter} 的当前接口}
% |\caption@refstepcounter|\marg{计数器}\\
% 递增浮动体计数器（使用 |\ref|\-|step|\-|counter|），并重置续接计数器。
%    \begin{macrocode}
\newcommand*\caption@refstepcounter{%
  \@nameuse{donemaincaptiontrue}% 支持 memoir 文档类
  \caption@ifrefstepcounter\caption@@refstepcounter\caption@@refcounter}
%    \end{macrocode}
%    \begin{macrocode}
\newcommand*\caption@@refstepcounter[1]{%
  \caption@prepare@stepcounter{#1}%
  \caption@refstepcounter@{#1}}
%    \end{macrocode}
%    \begin{macrocode}
\newcommand*\caption@@refcounter[1]{%
  \let\caption@stepcounter@ORI\stepcounter
  \def\stepcounter##1{%
    \edef\caption@tempa{#1}%
    \edef\caption@tempb{##1}%
    \ifx\caption@tempa\caption@tempb
      % Suppress incrementation of counter
    \else
      \caption@stepcounter@ORI{##1}%
    \fi}%
  \caption@refstepcounter@{#1}%
  \let\stepcounter\caption@stepcounter@ORI}
%    \end{macrocode}
%    \begin{macrocode}
\newcommand*\caption@refstepcounter@{\refstepcounter}
%    \end{macrocode}
% \end{macro}
