% 本宏在环境结束时调用；需在 \pkg{sidecap} 宏包实际排版题注之前完成本
% 宏包相关设置。
%    \begin{macrocode}
  \let\caption@ORI@endSC@FLOAT\endSC@FLOAT
  \def\endSC@FLOAT{%
%    \end{macrocode}
% 排版题注前需把边距设为零，任何额外边距在此都只会造成干扰。\par
% （无需关心题注位置，因为 sidecap 宏包已把 |\abovecaptionskip| 与
%  |\belowcaptionskip| 都设为零间距。）\par
