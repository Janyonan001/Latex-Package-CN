% \section{使用本宏包}
% \label{usage}
%
% 在文档导言区（即 |\document|\-|class| 与 |\begin{doc|\-|u|\-|ment}|
% 之间的部分）插入
% \begin{quote}
%   |\usepackage|\oarg{选项}|{caption}[|\texttt{\filedate}|]|
% \end{quote}
% 这些选项用于控制题注的外观；例如：
% \begin{quote}
%   |\usepackage[margin=10pt,font=small,labelfont=bf,|\\
%   |            labelsep=endash]{caption}|%
%   %|[|\texttt{\filedate}|]|
% \end{quote}
% 得到的题注将与简介中第二个示例的样式相同。
%
% \DescribeMacro{\captionsetup}
% 若要在之后修改选项，\thispackage\ 提供了命令
% \begin{quote}
%   |\captionsetup|\oarg{浮动体类型}\marg{选项}\quad。
% \end{quote}
% 因此
% \begin{quote}
%   |\usepackage[margin=10pt,font=small,labelfont=bf]{caption}|
% \end{quote}
% 与
% \begin{quote}
%   |\usepackage{caption}|\\
%   |\captionsetup{margin=10pt,font=small,labelfont=bf}|
% \end{quote}
% 效果完全相同。
%
% 需要了解的是，|\caption|\-|setup| 只对当前环境生效。因此，若只想修改
% 当前 |figure| 或 |table| 的设置，只需把 |\caption|\-|setup| 命令放在
% 该 |figure| 或 |table| 内部、|\caption| 命令之前即可。例如：
% \begin{quote}
%   |\begin{figure}|\\
%   |  |\ldots\\
%   |  \captionsetup{singlelinecheck=off}|\\
%   |  \caption{|\ldots|}|\\
%   |\end{figure}|
% \end{quote}
% 仅关闭了这一个 |figure| 的单行检查，其余题注不受影响。
%
% \begin{Annotation}
% 有关 |\caption|\-|setup| 的详细说明参见 \longref{captionsetup}。
% \end{Annotation}
%
% \iffalse
% --------------------------------------------------------------------------- %
% \fi
