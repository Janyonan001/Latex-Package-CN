% \DescribeMacro{\caption}
% 命令
% \begin{quote}
%   |\caption|\oarg{目录条目}\marg{标题文字}
% \end{quote}
% 在 |figure| 或 |table| 等浮动环境中排版题注。这一点你已经知道了，
% 而 \thispackage\ 还提供了一项扩展：若将参数 \meta{目录条目} 留空，
% 则不向插图目录或表格目录添加条目。例如：
% \begin{quote}
%   |\caption[]{一则不含目录条目的插图。}|
% \end{quote}
%
% \begin{Expert}
% 请记住：当未给出 \meta{目录条目} 时，\meta{标题文字} 是所谓的
% \emph{移动}参数；若给出了 \meta{目录条目}，则该参数变为移动参数。
% 所谓\emph{移动}参数，是指会写入目录文件、从而出现在“插图目录”或
% “表格目录”中的参数。\emph{移动}参数中不允许包含\emph{脆弱}命令，
% 所有内容都必须是\emph{稳固}的，否则参数可能被\emph{破坏}，在下一次
% \LaTeX\ 编译时产生奇怪的错误。部分\emph{脆弱}命令可在前面加
% |\protect| 加以\emph{保护}；自定义定义则可改用
% |\Declare|\-|Robust|\-|Command| 代替 |\new|\-|command|，使其
% 变得\emph{稳固}。
%
% 例如：|\caption{${}^{137}_{\phantom{1}55}$Cs}| 会报错，因为
% |\phantom| 是\emph{脆弱}命令。此时要么使用可选参数 \meta{目录条目}
% （例如 |\caption[${}^|\x|{137}_|\x|{55}$|\x|Cs]|\x|{${}^|\x|{137}_|\x|{\phantom{1}55}$|\x|Cs}|），
% 要么加上 |\protect|，避免 |\phantom| 命令被\emph{破坏}：
% |\caption{${}^|\x|{137}_|\x|{|\textcolor{blue}{\cs{protect}}|\phantom{1}55}$|\x|Cs}|。
%
% 但有时这样仍不够。其原因在于所谓的单行检查：它会把 \meta{标题文字}
% 放入水平盒子以测定题注宽度，这同样可能引发错误。例如：
% |\caption{一则| |示意图。| |\[V_{C}| |\sim| |\left| |\{| |\begin{array}{cc}|
% |E_{g}| |&| |\textrm{p-n}| |\\| |e\phi_{B}| |&| |\textrm{M-S}| |\end{array}|
% |\right.| |\]}|.
% 这里仅用 |\caption[一则| |示意图]{|\ldots|}| 仍不足以避免错误（仍会出现
% “\texttt{Missing \$ inserted.}”）。因此还必须在 |\caption| 命令正前方
% 加上 |\caption|\-|setup{single|\-|line|\-|check=|\x|off}|。
%
% 有关\emph{移动}参数以及\emph{脆弱}与\emph{稳固}命令的更多信息，请参阅
% 你的 \LaTeX\ 手册，或访问
% \url{http://www-h.eng.cam.ac.uk/help/tpl/textprocessing/teTeX/latex/latex2e-html/fragile.html}。
% \end{Expert}
