% \begin{macro}{\caption@patch@addmargin}
% \changes{v3.6j}{2023/03/12}{加入本宏定义}
% \env{addmargin} 与 \env{addmargin*} 两个环境都会开启一个 \env{list}
%  \cs{item}。但在 \env{list} 项内部 \cs{hsize} 未被正确设置，因此文档类
%  提供的 \cs{@makecaption} 在 \env{addmargin} 内部使用时无法正常工作。
%  为此我们在 \cs{@makecaption} 内部尝试判断“当前是否处于
%  \env{addmargin} 环境中”，并加以修正。（唉！）
%    \begin{macrocode}
  \let\caption@addmargin@env\@addmargin
  \renewcommand*\@addmargin{%
    \@testopt\caption@@addmargin\@tempa}%
  \def\caption@@addmargin[#1]#2{%
    \caption@addmargin@env[{#1}]{#2}%
    \caption@set@addmargin
    \ignorespaces}%
%    \end{macrocode}
% \end{macro}
