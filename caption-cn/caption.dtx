% \label{beamer}
%
% \begin{tabular}{ll}
% \Option          & \defaultvalue \\\hline
% |format=|        & |plain| \\
% |labelformat=|   & \textit{不编号} \\
% |labelsep=|      & |colon| \\
% |justification=| & |raggedright| \\
% |font=|          & \cls{beamer} “题注” \settings \\
% |labelfont=|     & \cls{beamer} “题注名称” \settings \\
% |textfont=|      & \nofont \\
