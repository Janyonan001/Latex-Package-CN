% \begin{macro}{\caption@reset@continuedfloat}
%  |\caption@reset@continuedfloat|\marg{题注类型}\\
%  将续接计数器重置为零，并把所给题注类型绑定到该计数器。
%    \begin{macrocode}
\newcommand*\caption@reset@continuedfloat[1]{%
  \xdef\continuedfloat@captype{#1}%
  \@stpelt{continuedfloat}}
%    \end{macrocode}
% \end{macro}
