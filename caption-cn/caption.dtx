% \begin{macro}{\caption@startanchor}
% \changes{v3.1b}{2007/09/17}{缺陷修复 06-09-17：改用 \cs{caption@anchor} 代替 \cs{hyper@@anchor}}
% \changes{v3.1g}{2008/03/16}{把关于 TeX 模式的警告改为调试信息}
% |\caption@startanchor|\marg{超链接锚点}
% 在 |\caption@start| 内部设置一个 \pkg{hyperref} 锚点。\par
% 本代码取自 \pkg{hypcap} 宏包\cite{hypcap}并作了适配。
% \Note{由于 \cs{hyper@@anchor}\marg{超链接锚点}\csmarg{\string\relax} 可能导致
% 由竖直模式进入水平模式（疑为 \pkg{hyperref} 宏包的设计缺陷！），而
% \pkg{hypcap} 宏包中的变通写法 \cs{let}\cs{leavevmode}\cs{relax}
% 并非总是有效（例如在“直接 pdfmark 支持”与
% \texttt{breaklinks=true} 情形下），因此此处改用 \cs{caption@anchor}
% 代替 \cs{hyper@@anchor}。}
%    \begin{macrocode}
    \newcommand*\caption@startanchor[1]{%
      \ifvmode\begingroup
        \caption@Debug{hypcap anchor: #1 (vertical mode)}%
        \@tempdima\prevdepth
        \nointerlineskip
        \vspace*{-\caption@hypcapspace}%
        \caption@anchor{#1}%
        \vspace*{\caption@hypcapspace}%
        \prevdepth\@tempdima
      \endgroup\else
        \caption@Debug{hypcap anchor: #1 (horizontal mode)}%
        \caption@anchor{#1}%
      \fi}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\caption@anchor}
% \changes{v3.1c}{2007/10/17}{变通写法 07-10-17：现改用 \cs{caption@raisedlink} 代替 \cs{Hy@raisedlink}}
% |\caption@anchor|\marg{超链接锚点} 设置一个 \pkg{hyperref} 锚点。
%    \begin{macrocode}
    \newcommand*\caption@anchor[1]{%
      \ifmeasuring@ \else
        \caption@raisedlink{\hyper@anchorstart{#1}\hyper@anchorend}%
      \fi}%
%    \end{macrocode}
% \Note{由于 \cs{Hy@raisedlink} 会改动 \cs{@tempdima}，我们用 \cs{ifvmode}
% 将其包裹起来，以消除 \texttt{sideways} 浮动体中
% “\texttt{LaTeX Warning: Float too large for page by 1.0pt}” 的警告。
% （自 \pkg{hyperref} \version{6.77} 起已无此必要。）}
%    \begin{macrocode}
    \ifx\HyperRaiseLinkLength\@tempdima
      \def\caption@raisedlink#1{\ifvmode#1\else\Hy@raisedlink{#1}\fi}%
    \else
      \let\caption@raisedlink\Hy@raisedlink
    \fi
%    \end{macrocode}
% \end{macro}
