% \section{供 babel 语言宏包作者使用的命令}
%
% \NEWfeature{v3.5}
% \DescribeMacro{\caption@switchdefault}
% 若已加载 \pkg{caption3} 内核宏包，则可使用命令
% \begin{quote}|\caption@switchdefault|\marg{选项}\marg{含 \#1 的代码}\marg{新默认值}\end{quote}
% 它通过 \meta{代码} 保存所给选项的旧默认值，随后设置新默认值。
%
% \DescribeMacro{\caption@restoredefault}
% 命令
% \begin{quote}|\caption@restoredefault|\marg{选项}\marg{旧值}\end{quote}
% 用于恢复此前存放在 \meta{旧值} 中的旧默认值。
%
% 示例：
% \begin{quote}
%   |\DeclareCaptionLabelSeparator{french}{|\ldots|}|\\
%   |\addto\extrasfrench{%|\\
%   |  \caption@switchdefault{labelseparator}{\babel@save #1}{french}}|\\
%   |% 注意：此处不需要 \caption@restoredefault|
% \end{quote}
%
% 另一示例：
% \begin{quote}
%   |\caption@switchdefault{font}{\let\original@captionfont#1}{it}%|\\
%   \ldots\\
%   |\caption@restoredefault{font}{\original@captionfont}%|\\
% \end{quote}
%
% 由于这两个命令在 \pkg{caption3} 内核内均以 |\def| 定义，可在 babel
% 语言宏包内预先定义：
% \begin{quote}
%   |\providecommand\caption@switchdefault[3]{}|\\
%   |\providecommand\caption@restoredefault[2]{}|
% \end{quote}
% 这样使用前便无需再检测它们是否存在。
%
% 此外，若已加载 \pkg{caption} 宏包（即已定义
% |\caption@makecaption|），babel 语言宏包不应重定义
% |\@make|\-|caption|。（遗憾的是，此处不能使用 \LaTeX{} 内核命令
% |\@if|\-|package|\-|loaded{caption}|，因为它只能在文档导言区使用。）
%
% 请注意，如下代码
% \begin{quote}
%   |\addto\extraswhatever{%|\\
%   |  \@ifundefined{caption@makecaption}{%|\\
%   |    \babel@save\@makecaption|\\
%   |    \let\@makecaption\my@makecaption|\\
%   |  }{%|\\
%   |    \caption@switchdefault{|\ldots|}{\babel@save #1}{|\ldots|}%|\\
%   |  }}|
% \end{quote}
% 是错误的，因为它混淆了 \pkg{caption3} 内核与 \pkg{caption} 宏包是否
% 存在。加载 \pkg{caption3} 内核并不等于也加载了 \pkg{caption} 宏包：
% 后者重定义 |\caption|、|\@caption| 与 |\@make|\-|caption|，而
% \pkg{caption3} 内核并不重定义其中任何一个，只为 \pkg{caption}、
% \pkg{floatrow} 与 \pkg{subfig} 宏包提供（默认）值。
%
% 目前内建支持以下 babel 语言选项：|arabic|、|farsi|、|french|、
% |hungarian|、|latvian| 与 |magyar|。可通过定义
% \begin{quote}
%   |\def\caption@ifbabel@|\meta{宏包}|{false}|
% \end{quote}
% 停用对应支持，其中 \meta{宏包} 可为 |arabi|、|french|、|frenchle|、
% |hungarian| 或 |latvian|。
%
