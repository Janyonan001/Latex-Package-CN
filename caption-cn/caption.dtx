% \begin{macro}{\continuedfloat}
% \changes{v3.0i}{2005/11/12}{加入可选参数}
% \changes{v3.0g}{2005/06/28}{缺陷修复：\cs{newcounter} 由 \cs{newcount} 取代}
% \changes{v3.1}{2007/07/02}{更改 \pkg{hyperref} 扩展格式}
% \changes{v3.1}{2007/07/07}{加入 \cs{caption@setoptions}}
% \changes{v3.1g}{2008/01/29}{新增带星号形式}
% \changes{v3.2f}{2011/12/17}{移除未文档化的可选参数}
% \changes{v3.2f}{2011/12/17}{加入对 \cs{caption@@@continuedfloat} 的重定义}
% \changes{v3.3}{2011/12/28}{现使用 \cs{ifcaption@ContinuedFloat}}
% \changes{v3.3}{2013/05/01}{加入 \cs{caption@restorecounters} 的使用}
% \changes{v3.3}{2013/12/16}{缺陷修复：不再使用 \cs{caption@ContinuedFloat}，因其会破坏 \pkg{subfig} 提供的 \cs{ContinuedFloat}}
% \changes{v3.4}{2015/09/16}{由 \cs{ContinuedFloat} 改名为 \cs{continuedfloat}}
% \changes{v3.5f}{2020/10/06}{移除 \cs{caption@restorecounters} 的使用}
% \changes{v3.6}{2020/12/27}{计数器题注类型的检查抽出到 \cs{caption@check@continuedfloat}}
% \changes{v3.6}{2022/01/05}{\cs{caption@Error} 的使用改为 \cs{caption@OutsideFloat}}
%  |\continuedfloat|\\
%  |\continuedfloat*|\par
%  主要用于设置“续接浮动体”标志、递增续接计数器，并执行所给选项。
%    \begin{macrocode}
\def\continuedfloat{%
  \caption@teststar\caption@continuedfloat\@firstoftwo\@secondoftwo}
%    \end{macrocode}
%    \begin{macrocode}
\newcommand*\caption@continuedfloat[1]{%
  \caption@iftype
    {#1{\caption@@refstepcounter\@captype}{}%
     \caption@@continuedfloat\@captype}%
    {\caption@OutsideFloat\continuedfloat}}
%    \end{macrocode}
%    \begin{macrocode}
\newcommand*\caption@@continuedfloat{%
  \caption@clrflags
  \caption@set@continuedfloat
    {\caption@setcontinued
     \caption@@@continuedfloat}%
    {\@gobble}}
%    \end{macrocode}
%    \begin{macrocode}
\newcommand*\caption@@@continuedfloat[1]{%
  \caption@setoptions{ContinuedFloat}% 出于兼容性考虑
  \caption@setoptions{continuedfloat}%
  \caption@setoptions{continued#1}%
  \expandafter\l@addto@macro\csname the#1\endcsname\thecontinuedfloat
%    \end{macrocode}
%  使用 \pkg{hyperref} 宏包时，存在如下问题：使用 |\continued|\-|float|
%  会产生重复的超链接——主浮动体与其续接浮动体的 |\@current|\-|Href|
%  相同。因此必须确保每次都生成唯一的标签与引用。做法是扩展
%  |\the|\-|H|\-|figure| 与 |\the|\-|H|\-|table|，使续接浮动体采用
%  如下形式
%  \begin{quote}\meta{类型}|.|\meta{类型编号}|\alph{|\meta{续接编号}|}|\end{quote}
%  而非
%  \begin{quote}\meta{类型}|.|\meta{类型编号}\quad\quad。\end{quote}
%  \par{\small（本实现采用了 Steven Douglas Cochran 的思路。）}
%  \Note{若设置了 \pkg{hyperref} 宏包选项 \texttt{naturalnames=true}，本措施无效。}
%    \begin{macrocode}
  \@ifundefined{theH#1}{}{%
    \expandafter\l@addto@macro\csname theH#1\endcsname{%
      \@alph\c@continuedfloat}}%
%    \end{macrocode}
% 确保选项与 \pkg{hyperref} 修补只应用一次（每组一次）。
%    \begin{macrocode}
  \let\caption@@@continuedfloat\@gobble}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\ContinuedFloat}
% 出于兼容考虑，仍支持已过时的 |\Continued|\-|Float|。
%    \begin{macrocode}
\def\ContinuedFloat{\continuedfloat} % 为兼容而定义
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\caption@ContinuedFloat}
% \changes{v3.0f}{2005/06/11}{新增本宏}
% \changes{v3.3}{2013/12/16}{缺陷修复：修订并改用 \cs{def} 而非 \cs{newcommand} 定义}
% |\caption@ContinuedFloat|\marg{题注类型}\par
% 本宏供 \pkg{subfig} 宏包提供的 \cs{ContinuedFloat} 使用。由于
%  \pkg{subfig} 自行处理计数器，我们尽量不通过更改计数器相关标志加以
%  干预。
%    \begin{macrocode}
\def\caption@ContinuedFloat{%
  \caption@set@continuedfloat\caption@@@continuedfloat\@gobble}
%    \end{macrocode}
% \end{macro}
