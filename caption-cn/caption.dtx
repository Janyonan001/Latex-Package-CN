%  的用法在不同 \pkg{sidecap} 版本间存在差异：\par
%  \begin{tabular}{ll}
%    版本 1.4：& |\SC@justify| 未定义\\
%    版本 1.5：& 未设置时 |\SC@justify| 为 |\relax|\\
%    版本 1.6：& 未设置时 |\SC@justify| 为 |\@empty|\\
%  \end{tabular}
%    \begin{macrocode}
    \def\caption@setSC@justify{%
      \caption@clearmargin
        \ifx\SC@justify\@empty \else
