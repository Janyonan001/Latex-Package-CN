% \subsection{名称}
% \label{names}
%
% \DescribeMacro{name=}
% \NEWfeature*{v3.1}
% 选项
% \begin{quote}
%   |name=|\meta{名称}
% \end{quote}
% 用于更改 \emph{当前} 环境的名称。它与 |\caption|\-|setup| 的可选参数
% 搭配时会很有用，例如
% \begin{quote}
%   |\captionsetup[wrapfigure]{name=Fig.}|
