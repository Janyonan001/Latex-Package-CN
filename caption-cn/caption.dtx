% \begingroup
%   \captionsetup{type=figure}
%   \ContinuedFloat
%   \example*{singlelinecheck=false}{一则简短的题注。}
% \endgroup
%
% \meta{布尔值} 取 |true|、|yes|、|on| 或 |1| 时重新开启额外居中
