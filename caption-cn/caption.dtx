% \nopagebreak[3]
% 可以指定插图目录或表格目录中编号的排版方式。内置五种标准目录格式：
%
% \begin{Options}{\OptionLabel}
%   \item[empty]
%   不排版编号。
%
%   \item[simple]
%   编号连同标签前缀一起排版。
%
%   \item[parens]
%   编号放在圆括号内，连同标签前缀一起排版。
