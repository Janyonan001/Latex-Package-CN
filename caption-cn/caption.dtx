% \begin{macro}{\caption@set@addmargin}
% \changes{v3.6j}{2023/03/12}{加入本宏定义}
% 此处不能简单设置并检测一个标志，因为例如在 \env{addmargin} 环境内的
%  \cs{parbox} 中，本宏包不应调整 \cs{hsize}；因而改为保存 \cs{hsize} 与
%  \cs{linewidth}，并将当前 \cs{hsize}、\cs{linewidth} 与保存值比较。
%  若二者相等，则（有望）可以相当有把握地假定当前处于普通
%  \env{addmargin} 环境中，需在排版题注前修正 \cs{hsize}。（长叹！）
%    \begin{macrocode}
  \newdimen\caption@addmargin@hsize
  \newdimen\caption@addmargin@linewidth
%    \end{macrocode}
%    \begin{macrocode}
  \providecommand*\caption@set@addmargin{%
    \caption@addmargin@hsize\hsize
    \caption@addmargin@linewidth\linewidth
    \l@addto@macro\caption@beginex@hook\caption@test@addmargin}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\caption@test@addmargin}
% \changes{v3.6j}{2023/03/12}{加入本宏定义}
% 检测 \cs{hsize} 与 \cs{linewidth} 的当前值是否与 \env{addmargin}
% 环境中保存的值相同；若是，则把 \cs{hsize} 设为正确值。
%    \begin{macrocode}
  \providecommand\caption@test@addmargin{%
    \ifdim\hsize=\caption@addmargin@hsize
      \ifdim\linewidth=\caption@addmargin@linewidth
        \hsize=\linewidth
      \fi
    \fi}%
%    \end{macrocode}
% \end{macro}
