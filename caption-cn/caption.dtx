% \DescribeMacro{\ContinuedFloat*}
% 假定你希望这一系列的第一个插图或表格编号为“图 7a”，而不是
% “图 7”（第二个则为“图 7b”，而非“图 7a”）。
% 这同样可以做到：使用带星号的变体 |\Continued|\-|Float*|。它与
% |\Continued|\-|Float| 一样会执行与类型名 “|Continued|\-|Float|”
% 关联的选项，并使 \LaTeX\ 计数器 |Continued|\-|Float| 加一，\emph{但}
% 把它标记为系列中的第一个插图或表格：
% \begin{quote}
%   |\renewcommand\theContinuedFloat{\alph{ContinuedFloat}}|\\
%   \ldots\\
%   |\begin{figure}\ContinuedFloat*|\\
%   |  |\ldots\\
%   |  \caption{系列插图之一}|\\
%   |\end{figure}|\\
%   \ldots\\
%   |\begin{figure}\ContinuedFloat|\\
%   |  |\ldots\\
%   |  \caption{系列插图之二}|\\
%   |\end{figure}|\\
%   \ldots\\
%   |\begin{figure}\ContinuedFloat|\\
%   |  |\ldots\\
%   |  \caption{系列插图之三}|\\
%   |\end{figure}|
% \end{quote}
% \begin{Example}
%   \captionsetup{type=figure,position=b,skip=0pt}
%   \renewcommand\theContinuedFloat{\alph{ContinuedFloat}}
%   \begingroup
%     \ContinuedFloat*
%     \centerline{\ldots}
%     \caption{系列插图之一}
%   \endgroup
%   \begingroup
%     \ContinuedFloat
%     \centerline{\ldots}
%     \caption{系列插图之二}
%   \endgroup
%   \begingroup
%     \ContinuedFloat
%     \centerline{\ldots}
%     \caption{系列插图之三}
%   \endgroup
% \end{Example}
%
% \begin{Note}
%   遗憾的是，加载 \pkg{subfig} 宏包\cite{subfig} 时，
%   \cs{ContinuedFloat*} 不可用。
% \end{Note}
%
% \pagebreak[3]
% \subsubsection*{关于 longtable 宏包的说明}
% 若希望在 \pkg{longtable} 宏包\cite{longtable} 提供的 |long|\-|table|
% 跨页之后使用不同的题注标签，\emph{不能}借助 |\Continued|\-|Float|
% 实现；可以改为编写类似下面的代码：
% \begin{quote}
%   |\DeclareCaptionLabelFormat{continued}{Continued #1~#2}|\\
%   \ldots\\
%   |\begin{longtable}{|\ldots|}|\\
%   |  \caption{长表格}\\|\\
%   |\endfirsthead|\\
%   |  \captionsetup{labelformat=continued}|\\
%   |  \caption[]{长表格}\\|\\
%   |\endhead|\\
%   |  |\ldots\\
%   |\end{longtable}|
% \end{quote}
