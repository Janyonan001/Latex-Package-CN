%        for empty body of verbatim text.
%        Suggested by Nelson Beebe.}
%    \begin{macrocode}
  \def\@noitemerr{\@warning{No verbatim text}}%
%    \end{macrocode}
%    现在调用 |\obeylines| 使行尾字符成为活动字符。
%    \begin{macrocode}
  \obeylines
%    \end{macrocode}
%    所有特殊字符的类别码都改为 $12$（其他）。
%    \changes{v1.5i}{1996/06/04}{Moved \cs{verbatim@font} after
%           \cs{dospecials}.}
%    \begin{macrocode}
  \let\do\@makeother \dospecials
%    \end{macrocode}
%    我们切换到要使用的字体。
%    \begin{macrocode}
  \verbatim@font
%    \end{macrocode}
%    为了避免在标签盒子之后断行，我们去掉列表宏在那里放置的惩罚值：
%    又一次用到了 |\unpenalty|！
% \changes{v1.5f}{1994/10/25}{Change to \cs{everypar} added.}
%    \begin{macrocode}
  \everypar \expandafter{\the\everypar \unpenalty}}
%    \end{macrocode}
