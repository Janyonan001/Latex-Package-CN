% 下面四个宏以适合 \texttt{verbatim} 和 \texttt{verbatim*} 环境的方式
% 全局定义。
% \begin{macro}{\verbatim@startline}
% \begin{macro}{\verbatim@addtoline}
% \begin{macro}{\verbatim@processline}
%    |\verbatim@startline| 通过清空字符缓冲区（|\verbatim@line|）
%    来开始处理一行。
%    \begin{macrocode}
\def\verbatim@startline{\verbatim@line{}}
%    \end{macrocode}
%    |\verbatim@addtoline| 把其参数中的记号添加到缓冲区寄存器
%    |\verbatim@line|，不展开它们。
%    \begin{macrocode}
\def\verbatim@addtoline#1{%
  \verbatim@line\expandafter{\the\verbatim@line#1}}
%    \end{macrocode}
%    在 \texttt{verbatim} 或 \texttt{verbatim*} 环境中处理一行
%    意味着打印它。
% \changes{v1.2c}{1989/10/31}{Changed \cs{@@par} to \cs{par} in
%    \cs{verbatim@processline}.  Removed \cs{leavevmode} and \cs{null}
%    (i.e.\ the empty \cs{hbox}).}
%    结束一行意味着我们必须开始新段落。我们用 |\par| 来做这件事。
%    注意 |\par| 在 |\@verbatim| 中被重定义，以迫使 \TeX{} 进入水平模式
%    并插入一个空盒子，这样输入中的空行才会在输出中出现。
% \changes{v1.2f}{1990/01/31}{\cs{verbatim@startline} removed.}
%    \begin{macrocode}
\def\verbatim@processline{\the\verbatim@line\par}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
