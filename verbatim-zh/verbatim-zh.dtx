% \begin{macro}{\verbatim@finish}
%    默认情况下，|\verbatim@finish| 处理剩余字符。
%    调用这个宏时我们面临如下问题：当遇到 |\end{verbatim}| 命令时，
%    |\verbatim@processline| 被调用来处理该命令同一行上前面的字符。
%    如果没有字符，而我们不检查这种情况，就会输出一个空行。
%
%    如果行为空，|\the\verbatim@line| 展开为空。为检测这一点，
%    我们使用一个与 \TeX{}book 第 376 页类似的技巧，
%    但用 |$|\ldots|$| 代替那里的 |!| 记号。这些 |$| 记号的类别码
%    永远不可能与记号寄存器 |\verbatim@line| 中可能出现的 |$| 记号
%    相同，因为后者总是以类别码 $12$（其他）读取的。
%    注意 |\ifcat| 会展开后面的记号，使 |\the\verbatim@line|
%    被累积的字符替换。
% \changes{v1.2d}{1989/11/29}{Changed \cs{ifx} to \cs{ifcat} test.}
% \changes{v1.1b}{1989/10/18}{Corrected bug in if test (found by CRo).}
%    \begin{macrocode}
\def\verbatim@finish{\ifcat$\the\verbatim@line$\else
  \verbatim@processline\fi}
%    \end{macrocode}
