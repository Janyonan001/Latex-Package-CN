% \begin{abstract}
%   本宏包重新实现了 \LaTeX{} 的 \texttt{verbatim} 和
%   \texttt{verbatim*} 环境。此外它还提供了一个 \texttt{comment}
%   环境，用于跳过 |\begin{comment}| 与下一个 |\end{comment}|
%   之间的所有命令或文本。它还定义了 |\verbatiminput| 命令，
%   用于以 verbatim 方式包含整个文件。
% \end{abstract}
%
% \section{使用说明}
%
% \let\docDescribeMacro\DescribeMacro
% \let\docDescribeEnv\DescribeEnv
% \def\DescribeMacro#1{}
% \def\DescribeEnv#1{}
% \LaTeX{} 的 \texttt{verbatim} 和 \texttt{verbatim*} 环境
% 有几个可能引发问题的特性：
% \begin{itemize}
%   \item
%     由于检测 |\end{verbatim}| 的方式（即宏参数定界），
%     你不能在 |\end| 记号与 |{verbatim}| 之间留空格。
%   \item
%     由于 \TeX{} 必须先读取 |\begin{verbatim}| 与
%     |\end{verbatim}| 之间的全部文本才能输出任何内容，
%     过长的 verbatim 列表可能会耗尽 \TeX{} 的内存。
% \end{itemize}
% 这两点中，前者只能算小麻烦，后者却是真正的限制。
%
%
% \DescribeEnv{verbatim}
% \DescribeEnv{verbatim*}
% 本宏包文件包含了对 \texttt{verbatim} 和 \texttt{verbatim*}
% 环境的重新实现，克服了上述限制。不过新旧实现之间有一处不兼容：
% 旧版本会把 |\end{verbatim}| 命令同一行上的文本当作单独一行处理。
% \begin{center}
%   \bf 新版本则会直接忽略这些文本。
% \end{center}
% （这是消除旧 \texttt{verbatim} 环境大小限制所必须付出的代价。）
% 不过它会发出如下形式的警告信息：
% \begin{verbatim}
%LaTeX warning: Characters dropped after \end{verbatim*}!
%\end{verbatim}
% 这并不是真正的问题，因为这些文本很容易移到下一行而不影响输出。
%
% 新实现还解决了上面提到的第二个问题：现在可以在 |\end| 与
% |{verbatim}| 或 |{verbatim*}| 之间留空格（但\emph{不能}开始新行）：
% \begin{verbatim}
%\begin {verbatim*}
%   test
%   test
%\end {verbatim*}
%\end{verbatim}
%
% \DescribeEnv{comment}
% 此外我们引入了一个 \texttt{comment} 环境，其效果是：
% |\begin{comment}| 与 |\end{comment}| 之间的文本无论长什么样都被直接忽略。
% 乍看之下这与 verbatim 列表的用途大不相同，但实际上这两个概念的
% 实现非常相似。二者都依赖于这样一个事实：|\begin{...}| 与
% |\end{...}| 之间的文本由 \TeX{} 读取，不解释任何命令或特殊字符。
% \texttt{verbatim} 与 \texttt{comment} 之间剩下的唯一区别是：
% 前者的文本要排版出来，后者的文本则被丢弃。注意这些环境不能嵌套。
%
% \DescribeMacro{\verbatiminput}
% |\verbatiminput| 是一个带一个参数的命令，用于以 verbatim 方式
% 包含一个文件；也就是说，命令 |\verbatiminput{xx.yy}| 的效果等价于\\[2pt]
%   \hspace*{\MacroIndent}|\begin{verbatim}|\\
%   \hspace*{\MacroIndent}\meta{文件 \texttt{xx.yy} 的内容}\\
%   \hspace*{\MacroIndent}|\end{verbatim}|\\[2pt]
% 该命令还有一个 |*|-变体，会把空格打印为 \verb*+ +。
%
%
% \MaybeStop{}
%
%
% \section{面向宏包作者的接口}
%
% \LaTeXe{} 的 \texttt{verbatim} 环境没有为程序员提供良好的接口。
% 与之不同，本宏包提供了一个简单的机制来实现类似功能，
% 这里实现的 \texttt{comment} 环境就是一个示例，展示了能做什么以及怎么做。
%
%
% \subsection{简单示例}
%
% 现在可以使用 \texttt{verbatim} 环境来定义你自己的环境了。
% 例如，
%\begin{verbatim}
% \newenvironment{myverbatim}%
%   {\endgraf\noindent MYVERBATIM:%
%    \endgraf\verbatim}%
%   {\endverbatim}
%\end{verbatim}
% 之后就可以像 \texttt{verbatim} 环境一样使用它，即
% \begin{verbatim}
%\begin {myverbatim}
%  test
%  test
%\end {myverbatim}
%\end{verbatim}
% 另一种用法是写
% \begin{verbatim}
%\let\foo=\comment
%\let\endfoo=\endcomment
%\end{verbatim}
% 此后环境 \texttt{foo} 就与 comment 环境相同，即其内部的所有内容都被忽略。
%
% 你还可以在 |\verbatim| 宏被调用之后添加特殊命令，例如
%\begin{verbatim}
%\newenvironment{myverbatim}%
%  {\verbatim\myspecialverbatimsetup}%
%  {\endverbatim}
%\end{verbatim}
% 不过此时你可能想了解下面要讲的 |\every@verbatim| 钩子。
% \changes{v1.5h}{1995/09/21}{Clarified documentation on use of other
%               environments to define new verbatim-type ones.}
% 不过仍有若干限制：
% \begin{enumerate}
%   \item
%     你不能在定义内部使用 |\begin| 或 |\end| 命令，
%     例如下面两个示例\emph{不能}工作：
%\begin{verbatim*}
%\newenvironment{myverbatim}%
%{\endgraf\noindent MYVERBATIM:%
% \endgraf\begin{verbatim}}%
%{\end{verbatim}}
%\newenvironment{fred}
%{\begin{minipage}{30mm}\verbatim}
%{\endverbatim\end{minipage}}
%\end{verbatim*}
%     如果你尝试这些示例，\TeX{} 会报 ``runaway argument'' 错误。
%     更一般地说，在新环境的定义中不能使用
%     |\begin|\ldots\allowbreak|\end| 或相关环境。正确的定义方式应该是
%    \begin{verbatim*}
%\newenvironment{fred}
%{\minipage{30mm}\verbatim}
%{\endverbatim\endminipage}
%\end{verbatim*}
%   \item
%     你\emph{不能}在用户自定义的\emph{命令}内部使用
%     \texttt{verbatim} 环境；例如
% \changes{v1.4g}{1991/11/21}{Corrected wrong position of optional
%        argument to \cs{newcommand}. Discovered by Piet van Oostrum.}
%     \begin{verbatim*}
%\newcommand{\verbatimfile}[1]%
%           {\begin{verbatim}\input{#1}\end{verbatim}}
%\end{verbatim*}
%     不\emph{能}工作；下面这个也不行：
%     \begin{verbatim}
%\newcommand{\verbatimfile}[1]{\verbatim\input{#1}\endverbatim}
%\end{verbatim}
%   \item 新定义环境的名字不能包含字符类别不是 $11$（字母）
%     或 $12$（其他）的字符，否则将无法工作。
% \end{enumerate}
%
%
% \subsection{接口}
%
% \DescribeMacro{\verbatim@font}
% 从简单的开始讲起。有时你可能需要为 verbatim 文本使用特殊字体，
% 或者使用较小字号的计算机现代打字机字体。
%
% 你可以通过重定义宏 |\verbatim@font| 来选择字体。
% 该宏在每段 verbatim 文本开始时被调用，用于选择字体形状。
% 不要把它用于其他用途；如果你发现自己在滥用它，
% 可以去看看下面的 |\every@verbatim| 钩子。
%
% 默认情况下，|\verbatim@font| 切换到打字机字体并禁用其中的连字。
%
%
% \DescribeMacro{\every@verbatim}
% \DescribeMacro{\addto@hook}
% 有一个钩子（即记号寄存器）叫做 |\every@verbatim|，
% 其内容会在每段 verbatim 文本之前被插入到 \TeX{} 的"嘴"中。
% 请使用 |\addto@hook| 宏向这个钩子添加内容。用法如下：\\[2pt]
% \hspace*{\MacroIndent}|\addto@hook|\meta{钩子名}^^A
%  |{|\meta{要添加的命令}|}|
% \vspace*{2pt}
%
%
%
% \DescribeMacro{\verbatim@start}
% 在完成所有特定设置（如切换字符类别）之后，会调用
% |\verbatim@start| 宏。它启动本宏包实现的扫描机制主循环。
% 任何想利用此功能的其他环境都应把该宏作为最后一个动作来执行。
%
%
% \DescribeMacro{\verbatim@startline}
% \DescribeMacro{\verbatim@addtoline}
% \DescribeMacro{\verbatim@processline}
% \DescribeMacro{\verbatim@finish}
% 这些是与 verbatim 环境启动相关的宏。
% 完成这些（及其他）设置后，本宏包中的代码按以下方式从输入流中
% 读取并处理字符：
% \begin{enumerate}
%   \item 在读取一行输入的第一个字符之前，
%     执行宏 |\verbatim@startline|。
%   \item 读取若干字符后，以这些字符为唯一参数调用宏
%     |\verbatim@addtoline|。每行可能发生多次
%     （当该行含有 |\end| 命令时）。
%   \item 到达行尾时，调用宏 |\verbatim@processline|
%     来处理 |\verbatim@addtoline| 累积的字符。
%   \item 最后，在环境被 |\end| 宏调用结束之前，
%     会调用宏 |\verbatim@finish|。
% \end{enumerate}
%
%
% 为说明这一点，我们看一下标准 \texttt{verbatim} 环境。
% 在这种情况下，上述三个宏定义如下：
% \begin{enumerate}
%   \item |\verbatim@startline| 清空字符缓冲区（一个记号寄存器）。
%   \item |\verbatim@addtoline| 把其参数中的记号
%     添加到字符缓冲区 |\verbatim@line|，不展开它们。
%   \item |\verbatim@processline| 排版缓冲区中累积的字符。
% \end{enumerate}
% 有了这些，实现 \texttt{comment} 环境就非常简单了：
% 在这种情况下，|\verbatim@startline| 和 |\verbatim@processline|
% 被定义为空操作，而 |\verbatim@addtoline| 丢弃其参数。
%
%
% 让我们用这个机制来定义一个 |verbatim| 环境的变体，
% 在左边距打印行号。假设用一个叫 |VerbatimLineNo| 的计数器来实现。
% 假设该计数器已由环境正确初始化，那么在这种情况下
% |\verbatim@processline| 定义为：
% \begin{verbatim}
%\def\verbatim@processline{%
%  \addtocounter{VerbatimLineNo}{1}%
%  \leavevmode
%  \llap{\theVerbatimLineNo\ \hskip\@totalleftmargin}%
%  \the\verbatim@line\par}
%\end{verbatim}
%
% 另一种可能是定义一个 |verbatim| 环境的变体，
% 把整段 verbatim 文本放入盒子并居中。
% 注意盒子中的文本应少于一页，否则你需要修改这个示例。
%
%\begin{verbatim}
%\def\verbatimboxed#1{\begingroup
%  \def\verbatim@processline{%
%    {\setbox0=\hbox{\the\verbatim@line}%
%     \hsize=\wd0
%     \the\verbatim@line\par}}%
%  \setbox0=\vbox{\parskip=0pt\topsep=0pt\partopsep=0pt
%                 \verbatiminput{#1}}%
%  \begin{center}\fbox{\box0}\end{center}%
% \endgroup}
%\end{verbatim}
%
% 最后一个稍有分量的示例是描述一个叫 \texttt{verbatimwrite} 的环境的定义。
% 它把其内部所有文本写入一个文件，文件名作为参数给出。
% 我们假设有一个叫 |\verbatim@out| 的流号已经通过 |\newwrite| 宏预留。
%
% 从宏 |\verbatimwrite| 的定义开始。
% \begin{verbatim}
%\def\verbatimwrite#1{%
%\end{verbatim}
% 首先调用 |\@bsphack|，使该环境不影响间距。
% 然后打开文件并设置所有特殊字符的类别码：
% \changes{v1.5t}{2020-07-05}{Added quotes around the filename in
%    order to allow a filename with spaces; also added a space and
%    comment-character to allow for thespace dlimited argument.}
% \begin{verbatim}
%  \@bsphack
%  \immediate\openout \verbatim@out "#1" %
%  \let\do\@makeother\dospecials
%  \catcode`\^^M\active
%\end{verbatim}
% 下面几个宏的默认定义
% \begin{verbatim}
%  \verbatim@startline
%  \verbatim@addtoline
%  \verbatim@finish
%\end{verbatim}
% 也在这个环境中使用。只需要在调用 |\verbatim@start| 之前
% 修改宏 |\verbatim@processline|：
% \begin{verbatim}
%  \def\verbatim@processline{%
%    \immediate\write\verbatim@out{\the\verbatim@line}}%
%  \verbatim@start}
%\end{verbatim}
% |\endverbatimwrite| 的定义非常简单：
% 关闭流并调用 |\@esphack| 来恢复正确间距。
% \begin{verbatim}
%\def\endverbatimwrite{\immediate\closeout\verbatim@out\@esphack}
%\end{verbatim}
