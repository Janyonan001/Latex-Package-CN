% \section{实现}
%
% \let\DescribeMacro\docDescribeMacro
% \let\DescribeEnv\docDescribeEnv
%
% \changes{v1.4e}{1991/07/24}{Avoid reading this file twice.}
% 我们做的第一件事是确保本文件不会被读取两次。为此我们检查
% 宏 |\verbatim@@@| 是否已定义。如果已定义，就停止读取本文件。
% 这里的"宏包"守卫使得在抽取用于测试本宏包的 driver 文件时，
% 大部分代码可以被排除。
%    \begin{macrocode}
%<*package>
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{verbatim}
     [2026-08-17 v1.5z LaTeX2e package for verbatim enhancements]
\@ifundefined{verbatim@@@}{}{\endinput}
%    \end{macrocode}
%
% 我们使用与 \AmSTeX 中 |\comment|\ldots\allowbreak|\endcomment|
% 宏类似的机制：一次读取一行，检查它是否包含 |\end{...}| 记号。
% 然后就可以判断是否到达了 verbatim 文本的末尾，还是需要继续。
%
%
% \subsection{预备工作}
%
% \begin{macro}{\every@verbatim}
%    钩子（即记号寄存器）|\every@verbatim| 初始化为 \meta{空}。
%    \begin{macrocode}
\newtoks\every@verbatim
\every@verbatim={}
%    \end{macrocode}
% \end{macro}
%
%
% \begin{macro}{\@makeother}
% \changes{v1.1a}{1989/10/16}{\cs{@makeother} added.}
%    |\@makeother| 以一个字符为参数，把它的类别码改为 $12$（其他）。
%    \begin{macrocode}
\def\@makeother#1{\catcode`#112\relax}
%    \end{macrocode}
