% \subsection{把 verbbatim 文本送入参数}
%
% 实现这一点的一种方法是定义一个宏（命令），其展开结果就是所需的
% verbatim 文本。这个命令随后可以在任何需要 verbatim 文本的地方使用。
% 它可以用在参数中，甚至是移动参数中，但它是脆弱的（至少这里的版本是）。
%
% 下面这段代码声称提供了这个功能。它是我（Chris）约两年前所写东西的
% 大幅修订版。也许还需要进一步修订。
%
% 它只打算作为 |\verb| 的扩展，而不是 \texttt{verbatim} 环境的扩展。
% 因此，它或许应该以对 |\verb| 最合适的方式来处理行尾。
%
% \begin{macro}{\newverbtext}
% 这是产生一个新宏的命令，其展开结果是 verbatim 文本。
% 这个命令本身当然不能用在参数中！它的用法如下：
%
% \begin{verbatim}
%    \newverbtext{\myverb}"^%{ &~_\}}@ #"
% \end{verbatim}
%
% 界定 verbatim 文本的规则与 |\verb| 相同。
%
%    \begin{macrocode}
%<*verbtext>
\def \newverbtext {%
  \@ifstar {\@tempswatrue \@verbtext }{\@tempswafalse \@verbtext *}%
}
%    \end{macrocode}
% \end{macro}
%    我认为在这里使用一个临时开关是安全的：如果不安全，可以用合适的
%    |\let|。
%    \changes{v1.5i}{1996/06/04}{Moved processing of
%              \cs{verbatim@nolig@list} after \cs{dospecials}.}
%    \changes{v1.5p}{2001/03/12}{Added missing right brace in
%               definition of \cs{@verbtext} (PR 3314).}
%    \begin{macrocode}
\def \@verbtext *#1#2{%
   \begingroup
     \let\do\@makeother \dospecials
     \let\do\do@noligs \verbatim@nolig@list
     \@vobeyspaces
     \catcode`#2\active
     \catcode`~\active
     \lccode`\~`#2%
     \lowercase
%    \end{macrocode}
%    我们在这里用一个临时宏和一个技巧，使命令本身的定义可以在组内完成，
%    并且是局部定义（也许有更好的方法来实现这一点）。
%    \begin{macrocode}
     {\def \@tempa ##1~%
           {\whitespaces
%    \end{macrocode}
%    如果这些 |\noexpand| 改成 |\noexpand\protect\noexpand|，
%    会不会让这些东西变得健壮？
%    \begin{macrocode}
            \edef #1{\noexpand \@verbtextmcheck
                     \bgroup
                     \if@tempswa
                       \noexpand \visiblespaces
                     \fi
                     \noexpand \@verbtextsetup
                     ##1%
                     \egroup}%
            }%
      \expandafter\endgroup\@tempa
     }
}
%    \end{macrocode}
%    这为当前模式设置正确类型的组：它绝不能在定义时被展开！
%    \begin{macrocode}
\def \@verbtextmcheck {%
   \relax\ifmmode
           \hbox
         \else
           \leavevmode
           \null
         \fi
}
%    \end{macrocode}
%    这里包含其他一些在定义期间不应展开的东西。
%    \begin{macrocode}
\def \@verbtextsetup {%
   \frenchspacing
   \verbatim@font
   \verbtextstyle
}
%    \end{macrocode}
%    命令 |\verbtextstyle| 是一个文档级钩子，可用于覆盖用
%    |\newverbtext| 命令定义的命令的预定义排版处理。
%
%    |\visiblespaces| 和 |\whitespaces| 是这个钩子可能取值的例子。
%    \begin{macrocode}
\let \verbtextstyle \relax
\def \visiblespaces {\chardef \  32\relax}
\def \whitespaces {\let \ \@@space}
\let \@@space \ %
%</verbtext>
%    \end{macrocode}
