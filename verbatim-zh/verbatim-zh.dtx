% \subsection{\texttt{comment} 环境}
%
% \begin{macro}{\comment}
% \begin{macro}{\endcomment}
% \changes{v1.1c}{1989/10/19}{Added \cs{@bsphack}/\cs{@esphack} to the
%            \texttt{comment} environment.  Suggested by Chris Rowley.}
%    |\comment| 宏与 |\verbatim*| 类似。不过我们不需要切换字体或设置
%    诸如 |\parindent|、|\parskip| 之类的特殊排版参数。
%    只需把所有特殊字符的类别码设为 $12$（其他），
%    把 |^^M|（行尾字符）的类别码设为 $13$（活动）。
%    后者是下面内部宏进行宏参数定界匹配所需要的。
%    与 |\verbatim|、|\verbatim*| 宏的默认定义不同，
%    我们把 |\verbatim@addtoline| 定义为丢弃其参数，
%    把 |\verbatim@processline|、|\verbatim@startline|、
%    |\verbatim@finish| 定义为空操作。然后调用 |\verbatim@|。
%    但我们做的第一件事是调用 |\@bsphack|，
%    使该环境对间距完全没有影响。
% \changes{v1.1c}{1989/10/19}{Changed \cs{verbatim@start} to
%                           \cs{verbatim@}.  Suggested by Chris Rowley.}
% \changes{v1.1c}{1989/10/19}{\cs{verbatim@startline} and
%                           \cs{verbatim@finish} are now
%                           also redefined to do nothing.}
%    \begin{macrocode}
\def\comment{\@bsphack
             \let\do\@makeother\dospecials\catcode`\^^M\active
             \let\verbatim@startline\relax
             \let\verbatim@addtoline\@gobble
             \let\verbatim@processline\relax
             \let\verbatim@finish\relax
             \verbatim@}
%    \end{macrocode}
%    |\endcomment| 非常简单：它只调用 |\@esphack| 来处理间距。
%    |\end| 宏关闭组，因此负责恢复我们所做的一切更改。
%    \begin{macrocode}
\let\endcomment=\@esphack
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
%
%
% \subsection{主循环}
%
% 下面是最巧妙的部分：在定义这些宏时，我们不仅需要以正常类别码
% 使用特殊字符 |\|、|{| 和 |}|，还需要以类别码 $12$（其他）使用它们。
% 我们通过下面的技巧实现：先告诉 \TeX{}，|\|、|{| 和 |}|
% 分别是 |!|、|[| 和 |]| 的小写形式。然后把每个应该以类别码 $12$
% 读取的 |\|、|{|、|}| 分别替换为 |!|、|[|、|]|，
% 把整串记号交给 |\lowercase|，因为我们知道这个原语不会改变类别码！
%
% 但首先我们必须确保 |!|、|[|、|]| 本身有正确的类别码！
% \changes{v1.3b}{1990/02/07}{Introduced \cs{vrb@catcodes} instead
%                  of explicit setting of category codes.}
% 为了允许对这些类别码做特殊设置，我们把它们的设置隐藏在宏
% |\vrb@catcodes| 中。如果它已经定义，就跳过我们的新定义。
%    \begin{macrocode}
\@ifundefined{vrb@catcodes}%
  {\def\vrb@catcodes{%
     \catcode`\!12\catcode`\[12\catcode`\]12}}{}
%    \end{macrocode}
% 这个技巧使我们的代码可以用于其他类别码生效的场合。
%
% 我们启动一个组，使类别码改动局部化。
%    \begin{macrocode}
\begingroup
 \vrb@catcodes
 \lccode`\!=`\\ \lccode`\[=`\{ \lccode`\]=`\}
%    \end{macrocode}
% \changes{v1.2f}{1990/01/31}{Code for TABs removed.}
%    我们还需要把行尾字符 |^^M| 作为活动字符。
%    如果直接写 |\catcode`\^^M=\active|，那么在下面每个宏定义行的末尾
%    都会出现一个不想要的活动行尾字符。因此我们用与上面相同的技巧：
%    用波浪号 |~| 代替 |^^M|，假装后者是前者的小写形式。
%    因此我们现在必须确保波浪号字符有类别码 $13$（活动）。
%    \begin{macrocode}
 \catcode`\~=\active \lccode`\~=`\^^M
%    \end{macrocode}
%    使用 |\lowercase| 原语带来一个问题：下面的代码中需要使用大写字母
%    |C|，并且必须保持其大小写。因此我们添加如下命令：
%    \begin{macrocode}
 \lccode`\C=`\C
%    \end{macrocode}
%    现在开始交给 |\lowercase| 的记号表。我们用下面这个小技巧
%    （由 Bernd Raichle 提出）：交给 |\lowercase| 的记号表中第一个记号
%    是 |\endgroup| 原语。这意味着 \TeX{} 在 |\lowercase| 完成操作后
%    立即处理它，从而结束上面 |\begingroup| 启动的组。
%    这样就避免了所有宏的全局定义。
%    \begin{macrocode}
 \lowercase{\endgroup
%    \end{macrocode}
% \begin{macro}{\verbatim@start}
%    |\verbatim@start| 的作用是检查 |\begin{verbatim}| 同一行上
%    是否还有其他字符，并把它们当作单独一行处理。另一方面，如果当前行
%    上没有剩余字符，我们只会遇到一个行尾字符。|\verbatim@start|
%    通过先抓取后面的字符（即其参数）来完成任务。然后把这个参数与
%    活动的行尾字符 |^^M| 比较。
%    \begin{macrocode}
    \def\verbatim@start#1{%
      \verbatim@startline
      \if\noexpand#1\noexpand~%
%    \end{macrocode}
%    如果为真，我们把控制权交给 |\verbatim@| 来处理下一行。
%    我们用 |\next| 作为继续工作的宏。
%    \begin{macrocode}
        \let\next\verbatim@
%    \end{macrocode}
%    否则，我们把 |\next| 定义为展开为对 |\verbatim@| 的调用，
%    后面紧跟刚读入的字符，使它被重新插回文本。这意味着该行上剩余的
%    字符被当作单独一行处理。
%    \begin{macrocode}
      \else \def\next{\verbatim@#1}\fi
%    \end{macrocode}
%    Finally we call |\next|.
%    \begin{macrocode}
      \next}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@}
%    The three macros |\verbatim@|, |\verbatim@@|,
%    三个宏 |\verbatim@|、|\verbatim@@|、|\verbatim@@@| 构成
%    \texttt{verbatim} 环境的"主循环"。|\verbatim@| 的作用是恰好读取
%    一行输入。|\verbatim@@| 和 |\verbatim@@@| 协同工作，
%    找出该行中是否出现四个字符 |\end|（均为类别码 $12$（其他））。
%    如果出现，|\verbatim@@@| 会调用 |\verbatim@test| 检查这个 |\end|
%    是否是 |\end{verbatim}| 的一部分，如果是就结束环境。
%    否则我们就像什么都没发生一样继续。下面看 |\verbatim@| 的定义：
% \changes{v1.1a}{1989/10/16}{Replaced \cs{verbatim@@@} by \cs{@nil}.}
%    \begin{macrocode}
    \def\verbatim@#1~{\verbatim@@#1!end\@nil}%
%    \end{macrocode}
%    注意：在这个宏的定义真正生效之前，|!| 字符已经被管辖本代码的
%    |\lowercase| 原语替换为一个类别码 $12$（其他）的 |\|。
%    也就是说，它取一行，在后面放上 |\end|（四个字符记号）和
%    |\@nil|（一个控制序列记号）作为定界符，然后调用 |\verbatim@@|。
% \end{macro}
%
% \begin{macro}{\verbatim@@}
%    |\verbatim@@| 把直到下一次出现四个字符 |\end| 之前的所有内容
%    作为其参数。
%    \begin{macrocode}
    \def\verbatim@@#1!end{%
%    \end{macrocode}
%    也就是说：如果原行中没有出现它们，那么参数 |#1| 就是整行输入，
%    下一个要处理的记号是 |\@nil|。但是，如果四个字符 |\end|
%    是原行的一部分，那么 |#1| 由 |\end| 前面的字符组成，
%    下一个记号是后面的字符（永远记住该行被加长了五个记号）。
%    无论 |#1| 是什么，它都是 verbatim 文本，所以 |#1| 被添加到
%    当前正在构建的行中。
%    \begin{macrocode}
       \verbatim@addtoline{#1}%
%    \end{macrocode}
%    输入流中的下一个记号对我们特别重要。因此在调用 |\verbatim@@@|
%    之前，|\futurelet| 把 |\next| 定义为等于该记号。
%    \begin{macrocode}
       \futurelet\next\verbatim@@@}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@@@}
% \changes{v1.1a}{1989/10/16}{Replaced \cs{verbatim@@@} by
%                           \cs{@nil} where used as delimiter.}
%    |\verbatim@@@| 现在读取当前行上剩余的记号，直到最后的 |\@nil| 记号。
%    \begin{macrocode}
    \def\verbatim@@@#1\@nil{%
%    \end{macrocode}
%    如果上述两种情况中的第一种发生，即该行上没有 |\end| 字符，
%    那么 |#1| 为空，且 |\next| 等于 |\@nil|。这很容易检查。
%    \begin{macrocode}
       \ifx\next\@nil
%    \end{macrocode}
%    如果为真，这就是一个简单行。我们处理迄今累积的行来结束它。
%    然后准备读取下一行。
% \changes{v1.2f}{1990/01/31}{Added \cs{verbatim@startline}.}
%    \begin{macrocode}
         \verbatim@processline
         \verbatim@startline
         \let\next\verbatim@
%    \end{macrocode}
%    否则我们必须检查这些 |\end| 记号后面跟着什么。
%    \begin{macrocode}
       \else
%    \end{macrocode}
%    在继续之前，最好停下来想一下我们在哪儿：我们刚读完四个字符记号
%    |\end|，现在必须检查后面是否跟着环境名（用花括号括起来）。
%    为此我们定义一个叫 |\@tempa| 的宏，它恰好读取一个字符并决定
%    下一步做什么。这个宏应该做下面的事：跳过空格，直到遇到左花括号
%    或行尾。但重要的是记住跳过了哪些字符。|\end|\meta{可选空格}|{|
%    这些字符可能是 verbatim 文本的一部分，即这些字符必须被打印。
%
%    例如，假设当前行包含
%    \begin{verbatim*}
%      \end {AVeryLongEnvironmentName}
%\end{verbatim*}
%    正如我们很快会看到的，这里实现的扫描机制在读完右花括号之前
%    不会发现这是要打印的文本。因此我们需要一种累积已读字符的方法，
%    以便在必要时把它们重新插回。记号寄存器 |\@temptokena| 用于此目的。
%
%    在做这件事之前，我们必须先去掉行末多余的 |\end| 记号。
% \changes{v1.4j}{1992/06/30}{Removed use of \cs{toks@}. Suggested by
%           Bernd Raichle.}
%    为此我们定义一个临时宏，其参数由 |\end\@nil|（四个字符记号和一个
%    控制序列记号）界定，用于下面处理该行剩余部分——先在该行末尾追加一个
%    |\@nil| 记号。（注意这个记号永远不可能出现在 |#1| 中。）
%    我们用下面的 |\@tempa| 定义来获取该行（第一个 |\end| 之后）的剩余部分。
%    \begin{macrocode}
         \def\@tempa##1!end\@nil{##1}%
%    \end{macrocode}
%    我们前面已经提到，用记号寄存器 |\@temptokena| 来记住跳过的字符，
%    以防再次需要它们。我们用在 |\@tempa| 调用中丢弃的那个 |\end|
%    来初始化它。
%    \begin{macrocode}
         \@temptokena{!end}%
%    \end{macrocode}
%    现在我们要调用 |\verbatim@test| 来处理当前行上剩余的字符。
%    但等一下：我们不能直接调用这个宏，因为我们已经读完了整行。
%    因此我们必须先展开宏 |\@tempa|，把这些字符重新插回到
%    |\verbatim@test| 记号之后。末尾追加一个 |^^M| 字符表示行尾。
%    （记住这个字符伪装成波浪号。）
% \changes{v1.2}{1989/10/20}{Taken local definition of \cs{@tempa} out
%                          of \cs{verbatim@@@} and introduced
%                          \cs{verbatim@test} instead.}
%    \begin{macrocode}
         \def\next{\expandafter\verbatim@test\@tempa#1\@nil~}%
%    \end{macrocode}
%    差不多就这些了，但我们还需要调用 |\next| 来完成工作。
%    \begin{macrocode}
       \fi \next}%
%    \end{macrocode}
% \end{macro}
%
%
% \begin{macro}{\verbatim@test}
% \changes{v1.2}{1989/10/20}{Introduced \cs{verbatim@test}.}
%    我们定义 |\verbatim@test| 来依次检查每个记号。
%    \begin{macrocode}
    \def\verbatim@test#1{%
%    \end{macrocode}
%    首先，我们把 |\next| 设为 |\verbatim@test|，
%    以防这个宏需要递归调用来跳过空格。
%    \begin{macrocode}
           \let\next\verbatim@test
%    \end{macrocode}
%    我们必须区分四种情况：
%    \begin{enumerate}
%      \item 下一个记号是 |^^M|，即我们到达了行尾。这意味着没有发现
%            任何特殊内容。注意我们在下面的比较中使用 |\if|，
%            这样字符的类别码就无关紧要了。
%    \begin{macrocode}
           \if\noexpand#1\noexpand~%
%    \end{macrocode}
%            我们把记号寄存器 |\@temptokena| 中累积的字符添加到当前行。
%            由于 |\verbatim@addtoline| 不展开其参数，我们必须在此处展开。
%            然后用 |\let| 把 |\next| 设为 |\verbatim@|，
%            准备读取下一行。
% \changes{v1.2f}{1990/01/31}{Added \cs{verbatim@startline}.}
%    \begin{macrocode}
             \expandafter\verbatim@addtoline
               \expandafter{\the\@temptokena}%
             \verbatim@processline
             \verbatim@startline
             \let\next\verbatim@
%    \end{macrocode}
%      \item 后面是空格字符。这是允许的，所以我们把它添加到
%            |\@temptokena| 并继续。
%    \begin{macrocode}
           \else \if\noexpand#1
             \@temptokena\expandafter{\the\@temptokena#1}%
%    \end{macrocode}
% \changes{v1.2f}{1990/01/31}{Code for TABs removed.}
%      \item 后面是左花括号。这是最有趣的情况。我们现在必须收集字符，
%            直到读到右花括号，并检查它们是否构成环境名。
%            这将由 |\verbatim@testend| 完成，所以这里我们把
%            |\next| 设为这个宏。我们将再次逐字符处理该行剩余部分。
%            构成环境名的字符将累积在 |\@tempc| 中。
%            我们把这个宏初始化为展开为空。
% \changes{v1.3b}{1990/02/07}{\cs{noexpand} added.}
%    \begin{macrocode}
           \else \if\noexpand#1\noexpand[%
             \let\@tempc\@empty
             \let\next\verbatim@testend
%    \end{macrocode}
%            注意：当这个宏被定义时，|[| 字符将是一个 |{|。
%      \item 任何其他字符都意味着这个 |\end| 是 verbatim 文本的一部分。
%            把这些字符添加到当前行，并准备调用 |\verbatim@|
%            来处理该行剩余部分。
%  \changes{v1.0f}{1989/10/09}{Fixed \cs{end} \cs{end} bug
%                            found by Chris Rowley}
%    \begin{macrocode}
           \else
             \expandafter\verbatim@addtoline
               \expandafter{\the\@temptokena}%
             \def\next{\verbatim@#1}%
           \fi\fi\fi
%    \end{macrocode}
%    \end{enumerate}
%    这个宏做的最后一件事是调用 |\next| 来继续处理。
%    \begin{macrocode}
           \next}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@testend}
%    当看到 |\end|\meta{可选空格}|{| 时调用 |\verbatim@testend|。
%    它的任务是扫描直到下一个 |}| 的所有内容，并调用 |\verbatim@@testend|。
%    如果没找到 |}|，它必须重新插回所读字符并返回 |\verbatim@|。
%    下面的定义与 |\verbatim@test| 类似：它取下一个字符并决定做什么。
% \changes{v1.2}{1989/10/20}{Removed local definition of \cs{@tempa}
%                          from \cs{verbatim@testend} which now
%                          does the work itself.}
%    \begin{macrocode}
    \def\verbatim@testend#1{%
%    \end{macrocode}
%    同样，我们有四种情况：
%    \begin{enumerate}
%      \item |^^M|：由于当前行中没有找到 |}|，把这些字符添加到缓冲区。
%            为避免展开 |\@temptokena| 和 |\@tempc| 的复杂构造，
%            我们分两步做。然后继续用 |\verbatim@| 处理下一行。
% \changes{v1.2f}{1990/01/31}{Added \cs{verbatim@startline}.}
%    \begin{macrocode}
         \if\noexpand#1\noexpand~%
           \expandafter\verbatim@addtoline
             \expandafter{\the\@temptokena[}%
           \expandafter\verbatim@addtoline
             \expandafter{\@tempc}%
           \verbatim@processline
           \verbatim@startline
           \let\next\verbatim@
%    \end{macrocode}
%      \item |}|：调用 |\verbatim@@testend| 检查这是否是正确的环境名。
% \changes{v1.3b}{1990/02/07}{\cs{noexpand} added.}
%    \begin{macrocode}
         \else\if\noexpand#1\noexpand]%
           \let\next\verbatim@@testend
%    \end{macrocode}
%  \changes{v1.0f}{1989/10/09}{Introduced check for
%              {\tt\string\verb!\string|!\string\!\string|} to fix
%              single brace bug found by Chris Rowley}
%      \item |\|：这个字符不应出现在环境名中。因此我们停止收集字符。
%            原则上，同样的理由也适用于其他字符，例如 |{|。
%            不过 |\| 是一种特殊情况，因为它可能是 |\end| 的第一个字符。
%            这意味着我们必须重新寻找 |\end{|\meta{环境名}|}|。
%            注意我们在 |!| 前面加了一个 |\noexpand| 原语，
%            以防止它是一个活动字符。
% \changes{v1.3b}{1990/02/07}{\cs{noexpand} added.}
%    \begin{macrocode}
         \else\if\noexpand#1\noexpand!%
           \expandafter\verbatim@addtoline
             \expandafter{\the\@temptokena[}%
           \expandafter\verbatim@addtoline
             \expandafter{\@tempc}%
           \def\next{\verbatim@!}%
%    \end{macrocode}
%      \item 任何其他字符：收集它并继续。我们不能用 |\edef| 来定义
%            |\@tempc|，因为它的替换文本可能包含活动字符记号。
%    \begin{macrocode}
         \else \expandafter\def\expandafter\@tempc\expandafter
           {\@tempc#1}\fi\fi\fi
%    \end{macrocode}
%    \end{enumerate}
%    和前面一样，这个宏最后通过递归调用来处理下一个字符（如果合适的话）。
%    \begin{macrocode}
         \next}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@@testend}
%    与前面的宏不同，|\verbatim@@testend| 很简单：
%    它只需检查 |\begin{|\ldots|}| 是否与对应的
%    |\end{|\ldots|}| 匹配。
%    \begin{macrocode}
    \def\verbatim@@testend{%
%    \end{macrocode}
%    我们再次用 |\next| 来定义要做的事。记住当前环境名存放在
%    |\@currenvir| 中，由 |\verbatim@testend| 累积的字符在 |\@tempc| 中。
%    所以我们只需比较这两者，如果匹配就准备执行
%    |\end{|\meta{当前环境}|}| 宏。在做这件事之前，我们调用
%    |\verbatim@finish| 来处理最后一行。我们通过 |\edef| 定义 |\next|，
%    这样 |\@currenvir| 就会被其展开替换。因此我们需要 |\noexpand|
%    来抑制此时 |\end| 的展开。
%    \begin{macrocode}
       \ifx\@tempc\@currenvir
         \verbatim@finish
         \edef\next{\noexpand\end{\@currenvir}%
%    \end{macrocode}
%    没有这个技巧，|\end| 命令将无法正确检查其参数是否与当前环境名匹配，
%    你会得到一条有趣的 \LaTeX{} 错误信息，例如：
%    \begin{verbatim}
%! \begin{verbatim*} ended by \end{verbatim*}.
%\end{verbatim}
%    但是，那一行上剩余的字符怎么办？我们调用 |\verbatim@rescan|
%    来处理。它的第一个参数是刚结束的环境名（以防我们还需要它）。
%    |\verbatim@rescan| 把待重新处理的字符列表作为第二个参数。
%    （这个记号表是由 |\verbatim@@@| 插入到当前宏之后的。）
%    由于我们仍在 |\edef| 中，我们用 |\noexpand| 保护它。
%    \begin{macrocode}
                    \noexpand\verbatim@rescan{\@currenvir}}%
%    \end{macrocode}
%    如果名称不匹配，我们把迄今读到的所有字符重新插回，并准备调用
%    |\verbatim@| 来处理该行剩余部分。
%    \begin{macrocode}
       \else
         \expandafter\verbatim@addtoline
           \expandafter{\the\@temptokena[}%
           \expandafter\verbatim@addtoline
             \expandafter{\@tempc]}%
         \let\next\verbatim@
       \fi
%    \end{macrocode}
%    最后我们调用 |\next|。
%    \begin{macrocode}
       \next}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@rescan}
%    原则上，|\verbatim@rescan| 可以用来分析 |\end{...}| 命令之后
%    剩余的字符，并假装这些字符是在"标准"类别码生效下被"正确"读取的。
% \footnote{记住它们都是以类别码 $11$（字母）和 $12$（其他）读取的，
%          这样控制序列就不会被识别为控制序列。}
%    但这并非总是可行（当该行剩余部分中有不匹配的花括号时）。
%    此外，我们认为这不值得费力：在 \texttt{verbatim} 或
%    \texttt{verbatim*} 环境之后，输出反正会开始新行，
%    而 |\end{comment}| 很容易单独放在一行上。因此这里没有理由
%    出现任何文本。对于确实在那里放了东西（也许是注释）的用户，
%    我们简单地发出一条警告并丢弃它们。
%    测试方法在 \TeX{}book 附录 D 第 376 页有说明。
%    我们用 |^^M| 代替那里用的 |!| 字符，因为这个字符不可能出现在
%    |#1| 中。两个 |\noexpand| 原语是必要的，以避免活动字符和宏的展开。
%
%    这里还应注意一个额外的微妙之处：记住我们当前正在构建的记号表，
%    会先被 |\lowercase| 原语处理，然后 \TeX{} 才执行这些定义。
%    这意味着 |\@warning| 宏参数中的 |C| 字符必须受到保护，
%    防止被改成 |c|。这就是我们在上面添加 |\lccode`\C=`\C| 赋值的原因。
%    现在我们可以结束 |\lowercase| 的参数以及改变类别码的那个组了。
%    \begin{macrocode}
    \def\verbatim@rescan#1#2~{\if\noexpand~\noexpand#2~\else
        \@warning{Characters dropped after `\string\end{#1}'}\fi}}
%    \end{macrocode}
% \end{macro}
%
% \subsection{\cs{verbatiminput} 命令}
%
% \begin{macro}{\verbatim@in@stream}
%    我们首先分配一个输入流（从可用的 16 个输入流中）。
%\iffalse
%  Vorstellbar ist auch der Aufruf von |`verbatiminput| innerhalb eines
%  |`verbatiminput| (z.B: wenn man |`input|-Anweisungen im zu lesenden
%  File hat und auch diese Files automatisch lesen will).  Dies kann
%  man jedoch nur ermoeglichen, wenn man einen besseren Mechanismus
%  verwendet als es das simple, statische |`newread| darstellt.
%  Vorstellbar fuer eine neuere \LaTeX-Version ist eine (lokale)
%  Allokation des Streams durch ein |`open| und eine Freigabe des
%  Streams durch |`close| oder Verlassen der Gruppe.
%\fi
%    \begin{macrocode}
\newread\verbatim@in@stream
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@readfile}
%    宏 |\verbatim@readfile| 通过分别调用 |\verbatim@startline| 和
%    |\verbatim@finish| 宏来包围主循环。这样可以确保当文件为空或不存在时，
%    用户仍能正确初始化和结束该命令。\texttt{verbatim} 环境在以空文本
%    调用时有类似行为。
%    \begin{macrocode}
\def\verbatim@readfile#1{%
  \verbatim@startline
%    \end{macrocode}
%    当找不到文件时，我们发出一条警告。
%    \begin{macrocode}
  \openin\verbatim@in@stream #1\relax
  \ifeof\verbatim@in@stream
    \typeout{No file #1.}%
  \else
%    \end{macrocode}
%    此时我们把文件名传给 |\@addtofilelist|，使它出现在
%    |\listfiles| 命令的输出中。
%    此外，我们使用 |\ProvidesFile| 在日志文件中记录一条日志项，
%    并区分通过 |\verbatiminput| 读入的文件与其他文件。
%    \begin{macrocode}
    \@addtofilelist{#1}%
    \ProvidesFile{#1}[(verbatim)]%
%    \end{macrocode}
%    从文件读取时，关闭对行尾字符的识别是有用的。这样我们就不必
%    从行内容中去掉空格。
%    \begin{macrocode}
    \expandafter\endlinechar\expandafter\m@ne
    \expandafter\verbatim@read@file
    \expandafter\endlinechar\the\endlinechar\relax
    \closein\verbatim@in@stream
  \fi
  \verbatim@finish
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@read@file}
%    所有工作都在 |\verbatim@read@file| 中完成。它逐行读取输入文件，
%    并递归调用自己直到文件末尾。
%    \begin{macrocode}
\def\verbatim@read@file{%
  \read\verbatim@in@stream to\next
  \ifeof\verbatim@in@stream
  \else
%    \end{macrocode}
%    对每一行，我们用该行内容调用 |\verbatim@addtoline|。
% \hskip0pt plus 3cm\penalty0\hskip0pt plus -3cm
%    接着调用 |\verbatim@processline|。
%    \begin{macrocode}
    \expandafter\verbatim@addtoline\expandafter{\next}%
    \verbatim@processline
%    \end{macrocode}
%    处理完一行后，我们在读取下一行之前调用 |\verbatim@startline|
%    来重新初始化一切。
%    \begin{macrocode}
    \verbatim@startline
%    \end{macrocode}
%    如果没有 |\expandafter|，每次调用 |\verbatim@read@file| 都会在
%    \TeX 的输入栈中占用空间。\footnote{标准 \TeX{} 在你试图读取
%    超过约 200 行的文件时会报告溢出错误。如果 \textsl{``TeX: The Program''}\S 390
%    中的第一行代码缺失，也会发生同样的错误。}
%    \begin{macrocode}
    \expandafter\verbatim@read@file
  \fi
}
%    \end{macrocode}
% \end{macro}
%
%
% \begin{macro}{\verbatiminput}
%    |\verbatiminput| 首先启动一个组，使字体和类别码改动局部化。
%    然后它根据后面是否跟星号，带附加参数调用宏 |\verbatim@input|。
%    \begin{macrocode}
\def\verbatiminput{\begingroup
%    \end{macrocode}
% 
%   \changes{v1.5x}{2024/01/22}{Added TAB marking support into the
%   starred version (gh/1245)}
%   如果是星号版本，我们标记空格和 TAB，这两个新增部分与 verbatim* 相同。
%    \begin{macrocode}
  \@ifstar{\verbatim@input{\@setupverbvisiblespace\@vobeyspaces}}%
          {\verbatim@input{\frenchspacing\@vobeyspaces}}}
%    \end{macrocode}
% \changes{v1.5z}{2026-08-17}{Add tagging support if format is new.}
%    \begin{macrocode}
\IfDocumentMetadataT
 {
  \def\verbatiminput{\begingroup
    \@ifstar{\verbatim@input{final-code=\legacyverbatimsetup{visible}}}%
            {\verbatim@input{final-code=\legacyverbatimsetup{invisible}}}}
 }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\verbatim@input}
% \changes{1.5k}{1997/04/30}{Have \cs{verbatim@input} check for
%    existence of file.}
%    |\verbatim@input| 首先用标准宏 |\IfFileExists| 检查文件是否存在，
%    它会把找到的文件名留在 |\@filef@und| 中。然后像 |\verbatim| 宏一样
%    做好一切设置。但是，由于 |\@verbatim| 包含对 |\every@verbatim| 的调用，
%    而后者\emph{可能}包含一条 |\input| 语句，会覆盖 |\@filef@und| 的内容，
%    我们需要先展开它来保存。使用 |\@swaptwoargs| 使得
%    |\@filef@und| 的\emph{展开结果}成为 |\verbatim@readfile| 的第二个参数。
% \changes{v1.5t}{2020-07-06}{Expand \cs{@filef@und} before the call
%    of \cs{@verbatim} (gh/222)}
%    \begin{macrocode}
\def\verbatim@input#1#2{%
  \IfFileExists {#2}{%
    \expandafter\@swaptwoargs\expandafter
      {\expandafter{\@filef@und}}%
      {\@verbatim #1\relax
%    \end{macrocode}
%    然后它读入文件，结束由 |\@verbatim| 启动的 \texttt{trivlist} 环境，
%    并关闭组。这会把一切恢复到正常设置。
%    \begin{macrocode}
        \verbatim@readfile}%
      \endtrivlist\endgroup\@doendpe}%
%    \end{macrocode}
%    如果找不到文件，会打印一条多少有点用的信息。最后的 |\endgroup|
%    是为了关闭上面 |\verbatiminput| 中启动的组。
%    \begin{macrocode}
   {\typeout {No file #2.}\endgroup}}
%    \end{macrocode}
% \changes{v1.5z}{2026-08-17}{Add tagging support}
%    \begin{macrocode}
\IfDocumentMetadataT
  {
    \def\verbatim@input#1#2{%
      \IfFileExists {#2}{%
        \expandafter\@swaptwoargs\expandafter
         {\expandafter{\@filef@und}}%
         {%
          \SimpleBlockEnv{verbatim} {#1}\obeyedline       
          \verbatim@readfile}        
          \BlockEnvEnd\endgroup
        }%
     {\typeout {No file #2.}\endgroup}}
  }    
%    \end{macrocode}
%    \begin{macrocode}
%</package>
%    \end{macrocode}
% \end{macro}
