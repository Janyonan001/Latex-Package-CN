% %%BoundingBox: 0 0 60 12
% 0 0 60 12 rectfill
% 0.75 setgray
% 2 2 56 8 rectfill
% \end{verbatim}
% 现在通过 \LaTeX{} 和 \Program{dvips} 运行以下代码：
% \begin{verbatim}
