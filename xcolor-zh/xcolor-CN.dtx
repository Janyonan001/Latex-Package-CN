% \subsection{颜色蒙版与分色}
%
% \emph{颜色分色（color separation）}的目的是将文档中出现的所有颜色表示为有限基色子集及其色调的组合。
% 最常见的是 \Model{cmyk} 分色，基色为 \Color{cyan}, \Color{magenta}, \Color{yellow}, \Color{black}，这是打印机所要求的。
% 这可以通过选择宏包选项 \Option{cmyk} 来实现，使所有颜色都转换为此模型，然后后处理输出文件。
% 我们现在介绍另一种——更通用的——解决方案：\emph{颜色蒙版（color masking）}。
% 它如何工作？
% 颜色蒙版基于指定的颜色模型 \Meta{m-model} 和参数向量 \Meta{m-spec}。
% 每当文档中要显示某种颜色时，先将其转换为 \Meta{m-model}，然后将所得颜色向量的每个分量乘以 \Meta{m-spec} 的对应分量。
% 例如，假设 \Meta{m-model} 为 |cmyk|，\Meta{m-spec} 为 $(\mu_c,\mu_m,\mu_y,\mu_k)$。
% 那么任意颜色 \Color{foo} 将按以下方式变换：
% \begin{gather}
% \Color{foo} \mapsto (c,m,y,k) \mapsto (\mu_c\cdot c,\mu_m\cdot m,\mu_y\cdot y,\mu_k\cdot k)
% \end{gather}
% 显然，颜色分色是用向量 $(1,0,0,0)$、$(0,1,0,0)$ 等进行蒙版的特例。
% 一个有趣的应用是在 \Model{rgb} 或 \Model{cmy} 模型中用 $(x,x,x)$ 蒙版来加深或提亮所有颜色，见图 \vref{fig.mask} 的最后两行。
%
% \medskip
%
% \DescribeMacro\maskcolors
%   \oarg{num model}\marg{color}\\
% 初始化颜色蒙版所需的所有参数：
% 如果未指定 \Meta{num model}（或为空），则 \Meta{m-model} 设为 \Meta{color} 的自然模型，否则设为 \Meta{num model}；
% 提取 \Meta{color} 的颜色规格以定义 \Meta{m-spec}。
% 此外，会执行 |\maskcolorstrue|。
% \DescribeMacro\ifmaskcolors
% 颜色蒙版可通过 |\maskcolorsfalse| 临时关闭，或——更彻底地——通过 |\maskcolors{}| 关闭，后者还会清除初始化参数。
% \DescribeMacro\xglobal
% 一般来说，|\maskcolors| 的作用域是当前分组（除非前面加了 |\xglobal| 命令），但也可在文档导言区使用。
% 颜色混合一节的最后一条注意事项同样适用于此。
%
% 现在，无需修改源代码即可轻松分色整个文档：
% |latex| |\def\xcolorcmd{\maskcolors[cmyk]{cyan}}\input{a}| 会完成 |a.tex| 的 \Color{cyan} 分色部分。
%
% \DescribeMacro\colormask
% 注意：\XC{} 无法感知通过 |\includegraphics| 命令包含的文件中的颜色，例如 \File{.eps}、\File{.pdf}、\File{.jpg} 或 \File{.png} 类型的图像。
% 这些文件必须单独分色。
% 尽管如此，\XC{} 提供了一些基本支持：将蒙版颜色存储在 |\colormask| 中，可用于决定包含哪个文件：
% \begin{verbatim}
% \def\temp{cyan}\ifx\colormask\temp \includegraphics{foo_c}\else
% \def\temp{magenta}\ifx\colormask\temp \includegraphics{foo_m}\else
% ...
% \fi\fi
% \end{verbatim}
%
%
%
% \subsection{颜色系列}\label{sec.series}
%
% 在图形或图表应用中，自动着色可能很有用，因为这类应用需要——可能数量庞大且未指定的——颜色，而用户不想或无法逐一指定每种颜色。
% 因此，我们引入\emph{颜色系列（color series）}的概念，它由一个基色和一个方案组成，用于从当前颜色构造下一种颜色。
%
% 实际应用包括三部分：定义颜色系列（通常在文档中一次）、初始化系列（可能多次）、以及应用——带或不带步进——系列的当前颜色（可能很多次）。
%
%
% \subsubsection{颜色系列的定义}
%
% \DescribeMacro\definecolorseries
%   \marg{name}\marg{core model}\marg{method}\oarg{b-model}\marg{b-spec}\oarg{s-model}\marg{s-spec}\\
% 定义名为 \Meta{name} 的颜色系列，其计算在颜色模型 \Meta{core model} 内进行，其中 \Meta{method} 选择算法（|step|、|grad|、|last| 之一，见下文）。
% 方法细节由其余参数决定：
% \begin{itemize}
% \item \oarg{b-model}\marg{b-spec} 指定算法中的\emph{基色}（即第一个颜色），可直接指定，例如 |[rgb]{1,0.5,0.5}|；如果省略可选参数，也可作为 \Meta{color} 指定，例如 |{-yellow!50}|。
% \item \oarg{s-model}\marg{s-spec} 根据所选 \Meta{method} 指定算法中\emph{步进向量}的计算方式：
%   \begin{itemize}
%   \item |step|、|grad|：可选参数无意义，\Meta{s-spec} 是参数向量，其维数由 \Meta{core model} 决定，例如 |rgb|、|cmy| 或 |hsb| 时为 |{0.1,-0.2,0.3}|。
%   \item |last|：最后一个颜色可直接指定，例如 |[rgb]{1,0.5,0.5}|；如果省略可选参数，也可作为 \Meta{color} 指定，例如 |{-yellow!50}|。
%   \end{itemize}
% \end{itemize}
% 这是一般方案：
% \begin{gather}
% \emph{color}_1 := \emph{base},\qquad
% \emph{color}_{n+1} := U\bigl(\emph{color}_{n} + \emph{step}\bigr)
% \end{gather}
% 其中 $n=1,2,\dots$，$U$ 将任意实数 $m$ 维向量映射到单位 $m$ 维立方体：
% \begin{gather}
% U(x_1,\dots,x_m) = (u(x_1),\dots,u(x_m)),\qquad
% u(x) =
% \begin{cases}
%  1 & \text{if $x=1$}\\
%  x-[x]& \text{if $x\neq1$}\\
% \end{cases}\label{eq.U}
% \end{gather}
% 因此，算法每一步都产生一个参数在区间 $[0,1]$ 内的合法颜色。
%
% \medskip
% 不同方法使用不同方案计算\emph{步进}向量：
% \begin{itemize}
% \item |step|、|grad|：最后一个参数 \marg{s-spec} 定义方向向量 \emph{grad}。
% \item |last|：\marg{s-spec} 或 \oarg{s-model}\marg{s-spec} 定义颜色参数向量 \emph{last}。
% \end{itemize}
% 然后，在 |\resetcolorseries| 时，计算实际的\emph{步进}向量：
% \begin{gather}
% \emph{step} :=
% \begin{cases}
% \emph{grad} & \text{if $\Meta{method} = |step|$}\\
% \frac1{\Meta{div}}\cdot\emph{grad} & \text{if $\Meta{method} = |grad|$}\\
% \frac1{\Meta{div}}\cdot(\emph{last}-\emph{base}) & \text{if $\Meta{method} = |last|$}\\
% \end{cases}\label{eq.cs}
% \end{gather}
% Please note that it is also possible to use the current color placeholder `.' within the definition of color series.
% Thus, |\definecolorseries{foo}{rgb}{last}{.}{-.}| will set up a series that starts with the current color and ends with its complement.
% 当然，与 \TeX 的 |\let| 原语类似，使用的是执行时刻当前颜色的\emph{当前}定义，与文档后续阶段的当前颜色无关。
%
%
% \subsubsection{颜色系列的初始化}
%
% \DescribeMacro\resetcolorseries
%   \oarg{div}\marg{name}\\
% 此命令至少需要执行一次，才能使用颜色系列 \Meta{name}。
% 它将系列的当前颜色重置为基色，并根据所选 \Meta{div}（一个非零实数）为 |grad| 和 |last| 方法计算实际步进向量，见公式 (\ref{eq.cs})。
% \DescribeMacro\colorseriescycle
% 如果可选参数为空，则使用宏 |\colorseriescycle| 中存储的值。
% 其默认值为 \colorseriescycle，可通过 |\def\colorseriescycle|\marg{div} 修改，但必须在 \XCP{} 加载\emph{之前}应用（与 |\rangeRGB| 等类似）。
% 对于 |step| 方法，可选参数被忽略。
%
%
% \subsubsection{颜色系列的应用}
%
% 显示颜色系列当前颜色有两种方式：
% 在 |\color|、|\textcolor| 等命令中使用第 \vref{sec.term} 节中的任意\emph{颜色表达式}，将按此类表达式的通常语法显示该颜色。
% 不过，当 \Meta{postfix} 为 `|!!+|' 时，|\color{|\Meta{name}|!!+}| 等不仅会显示颜色，还会执行一次步进操作。
% 因此，这种情况下系列的当前颜色会被改变。
% 表达式 |\color{|\Meta{name}|!![|\Meta{num}|]}| 可直接访问系列中的某个元素，其中 \Meta{num} = $0,1,2,\dots$，基色从 0 开始。
% 不同方法的演示见图 \vref{fig.csx}。
%
%
% \subsubsection{颜色与颜色系列的区别}
%
% 虽然在颜色表达式中使用时行为相似，但 |\definecolor| 和 |\definecolorseries| 定义的对象在作用域/可用性上有根本区别：
% 与 \LC 原始 |\definecolor| 命令一样，|\definecolor| 生成\emph{局部}颜色，而 |\definecolorseries| 生成\emph{全局}对象（否则无法方便地在表格或图形中使用步进机制）。
% 例如，假设 |bar| 是未定义颜色，那么在执行
% \begin{verbatim}
% \begingroup
% \definecolorseries{foo}{rgb}{last}{red}{blue}
% \resetcolorseries[10]{foo}
% \definecolor{bar}{rgb}{.6,.5,.4}
% \endgroup
% \end{verbatim}
% 之后，|\color{foo}| 或 |\color{foo!!+}| 等命令可无限制使用，而 |\color{bar}| 会报错。
% 不过，可以使用 |\colorlet{bar}{foo}| 或 |\colorlet{bar}{foo!!+}| 来在本地保存系列的当前颜色——带或不带步进。
%
%
%
