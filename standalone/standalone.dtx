% 创建一个基本的 standalone 文件很直接：写一个使用 \cls{standalone} 作为文档类的普通 \LaTeX\ 文档。
% 导言区应载入内容所需的所有宏包与库。内容通常是一个图片环境，如 \env{tikzpicture}，
% 放在 \env{document} 主体中。应避免图片前后的空行。
% 同时 |\begin{document}| 与 |\end{document}| 应各自独占一行源代码。
%
% \par\noindent
% \begin{minipage}{\textwidth}
% \begin{lstlisting}[language={[latex]tex},gobble=4,frame=lines,caption={基本用法：\cls{standalone} 文档类。},numbers=none]
%   \documentclass{standalone}
%   \usepackage{somepackage}
%   \begin{document}
%   \begin{somepicture}
%       \somedrawingcommands
%   \end{somepicture}
%   \end{document}
% \end{lstlisting}
% \end{minipage}
%
% 这样的文件可以正常编译。\cls{standalone} 文档类会把得到的输出文件（PDF 或 DVI/PS）裁切到内容尺寸再加上一定的边界。
% 页码以及其他页眉页脚材料都会被抑制。
%
% 对于用 TikZ 绘制的图片，提供了一个专门的 \opt{tikz} 选项，它会载入 \pkg{tikz} 宏包，并把 \env{tikzpicture} 环境配置为生成单个裁切后的页面。
% 对于 PSTricks 图片，则有相应的 \opt{pstricks} 选项。
% \par\noindent
% \begin{minipage}{\textwidth}
% \begin{lstlisting}[language={[latex]tex},gobble=4,frame=lines,caption={基本用法：\cls{standalone} 文档类。},numbers=none]
%   \documentclass[tikz]{standalone}
%   %\usetikzlibrary{calc}
%   \begin{document}
%   \begin{tikzpicture}
%     \draw (0,0) rectangle (2,1) node [midway] {示例};
%   \end{tikzpicture}
%   % 还可以有更多 'tikzpicture' 环境，它们会再生成其他页面。
%   \end{document}
% \end{lstlisting}
% \end{minipage}
%
