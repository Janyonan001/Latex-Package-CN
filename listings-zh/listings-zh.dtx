% \begin{macro}{\lst@do@noligs}
% 为了阻止连字，这个宏把记号 |\lst@NoLig| 插到
% |\lst@Process|\meta{whatever}\meta{spec.~token} 前面。对某些字符，这由
% |\verbatim@nolig@list| 完成。注意该子宏是
% 一种特殊的局部 |\lst@AddToAtTop|。子宏定义
% 得感谢 \lsthelper{Peter~Bartke}{2002/04/10}{糟糕的`noligs'处理}得以修正。
%    \begin{macrocode}
\def\lst@do@noligs#1{%
    \begingroup \lccode`\~=`#1\lowercase{\endgroup
    \lst@do@noligs@~}}
\def\lst@do@noligs@#1{%
    \expandafter\expandafter\expandafter\def
    \expandafter\expandafter\expandafter#1%
    \expandafter\expandafter\expandafter{\expandafter\lst@NoLig#1}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@NoLig}
% 当这个额外的宏被处理时，它把 |\lst@nolig| 加入输出队列
% 而不增加其长度。对于关键词检测，如果 |\lst@UM| 为空，
% 它必须展开为无。
%    \begin{macrocode}
\def\lst@NoLig{\advance\lst@length\m@ne \lst@Append\lst@nolig}
\def\lst@nolig{\lst@UM\@empty}%
%    \end{macrocode}
% 但 |\lst@UM| 的通常含义会构造下面的控制序列，
% 它以 \LaTeX 的 |\do@noligs| 的方式阻止连字。
%    \begin{macrocode}
\@namedef{\@lst @um@}{\leavevmode\kern\z@}
%    \end{macrocode}
% \end{macro}
