% \subsection{catcode 的改动}\label{iCatcodeChanges}
%
% 字符在被读入之后立即得到 catcode，而 \TeX\ 没有
% 原语命令来改变已附着的 catcode。不过，我们可以用
% ASCII 码相同但 catcode 不同的字符替换这些字符。
% 这并不等同，但足够了，因为结果相同。
% 这里我们处理所有字符都变成活动的这个非常特殊的情况。
% 如果我们想让 \texverb|\lst@arg| 包含字符
% |#1| 的活动版本，一个原型宏可以是
% \begin{texcode}
%   \def\lst@MakeActive#1{\lccode`\~=`#1\lowercase{\def\lst@arg{~}}}
% \end{texcode}
% |\lowercase| 把 |~| 的 ASCII 码改为 |#1| 的 ASCII 码，因为
% 我们已说明 |#1| 是 |~| 的小写版本。
% 幸运的是 |\lowercase| 不改动 catcode，所以我们得到 |#1| 的一个活动
% 版本。注意 |~| 通常是活动的。
%
% \begin{macro}{\lst@MakeActive}
% 我们不会逐字符做这件事。
% 为了提高速度，我们同时改变九个字符（如果还剩九个
% 字符）。
% \begin{TODO}
% 这是在每次列表都转换定界符时引入的。现在
% 该转换只在每次选择语言时进行。所以我们也许想
% 再次实现逐字符转换以减少内存
% 占用。
% \end{TODO}
% 我们取得参数，把 |\lst@arg| 清空，然后开始一个循环。
%    \begin{macrocode}
\def\lst@MakeActive#1{%
    \let\lst@temp\@empty \lst@MakeActive@#1%
    \relax\relax\relax\relax\relax\relax\relax\relax\relax}
%    \end{macrocode}
% 有九个 |\relax|，因为 |\lst@MakeActive@| 有九个参数，而
% 我们不希望 |#1| 为空时出问题。
% 我们现在需要九个活动字符，而不是单个 |~|。
% 我们把这些 catcode 改动变成局部的，并把接下来的宏定义为 |\global|。
%    \begin{macrocode}
\begingroup
\catcode`\^^@=\active \catcode`\^^A=\active \catcode`\^^B=\active
\catcode`\^^C=\active \catcode`\^^D=\active \catcode`\^^E=\active
\catcode`\^^F=\active \catcode`\^^G=\active \catcode`\^^H=\active
%    \end{macrocode}
% 首先我们用 |\let| 让下一个操作成为 |\relax|。
% 这会中止我们处理所有字符（默认，之后可能被
% 改变）的循环。
% 然后我们检查是否至少还有一个字符。
% 如果不是，循环终止，一切完成。
%    \begin{macrocode}
\gdef\lst@MakeActive@#1#2#3#4#5#6#7#8#9{\let\lst@next\relax
    \ifx#1\relax
    \else \lccode`\^^@=`#1%
%    \end{macrocode}
% 否则我们说 |^^@|=|chr(0)| 是第一个字符的
% 小写版本。
% 然后我们测试第二个字符。
% 如果没有第二个字符，我们把小写的 |^^@| 追加到 |\lst@temp|。
% 否则我们说 |^^A|=|chr(1)| 是第二个
% 字符的小写版本，于是测试下一个参数，依此类推。
%    \begin{macrocode}
    \ifx#2\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@}}%
    \else \lccode`\^^A=`#2%
    \ifx#3\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A}}%
    \else \lccode`\^^B=`#3%
    \ifx#4\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A^^B}}%
    \else \lccode`\^^C=`#4%
    \ifx#5\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A^^B^^C}}%
    \else \lccode`\^^D=`#5%
    \ifx#6\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A^^B^^C^^D}}%
    \else \lccode`\^^E=`#6%
    \ifx#7\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A^^B^^C^^D^^E}}%
    \else \lccode`\^^F=`#7%
    \ifx#8\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A^^B^^C^^D^^E^^F}}%
    \else \lccode`\^^G=`#8%
    \ifx#9\relax
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A^^B^^C^^D^^E^^F^^G}}%
%    \end{macrocode}
% 如果存在九个字符，我们就追加九个
% 活动字符（的小写版本），并通过重新定义 |\lst@next| 再次调用这个宏。
%    \begin{macrocode}
    \else \lccode`\^^H=`#9%
        \lowercase{\lst@lAddTo\lst@temp{^^@^^A^^B^^C^^D^^E^^F^^G^^H}}%
        \let\lst@next\lst@MakeActive@
    \fi \fi \fi \fi \fi \fi \fi \fi \fi
    \lst@next}
\endgroup
%    \end{macrocode}
% 这个 |\endgroup| 恢复 |chr(0)|--|chr(8)| 的 catcode，但不恢复
% |\lst@MakeActive@| 内部字符的
% catcode，因为它们已经被读入了。
%
% 注意：从任意的`catcode--字符码'表转换回
% \TeX 的 catcode 是可能的，如果我们对字符码做测试（或者
% 通过 |\ifnum|，或者通过 |\ifcase|）。
% 但控制序列以及开始和结束分组字符肯定需要
% 一些特殊处理。
% 不过我还没有检查细节。
% 所以请忽略这一点，不要为这条注释来烦我。:\,--\,)
% \end{macro}
%
% \begin{macro}{\lst@DefActive}
% |\lst@MakeActive| 的一个简单应用。
%    \begin{macrocode}
\def\lst@DefActive#1#2{\lst@MakeActive{#2}\let#1\lst@temp}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@DefOther}
% 我们利用这一事实：|\meaning| 产生的字符 catcode 为 12，只有空格
% 仍是空格。|\escapechar| 被局部修改以抑制
% 转义字符的输出。最后我们用 \LaTeX 的 |\zap@space| 移除空格，这个
% 想法由 \lsthelper{Rolf~Niepraschk}{1997/04/24}{使用 \zap@space}提出——不是在
% 这一语境中，但那没关系。
%    \begin{macrocode}
\def\lst@DefOther#1#2{%
    \begingroup \def#1{#2}\escapechar\m@ne \expandafter\endgroup
    \expandafter\lst@DefOther@\meaning#1\relax#1}
\def\lst@DefOther@#1>#2\relax#3{\edef#3{\zap@space#2 \@empty}}
%    \end{macrocode}
% \end{macro}
