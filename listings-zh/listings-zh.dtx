%     \rkeyname{mathescape}|=|\meta{\alternative{true,false}}
%
%     激活或关闭美元符号的特殊行为。若
%     激活，美元符号充当 \TeX 的文本数学切换符。
%
%     如果你想在列表中排版公式，这个键很有用。
%
%   \item[0.19,{{}}]
%     \rkeyname{escapechar}|=|\meta{character}\syntaxor\rkeyname{escapechar}|={}|
%
%     若不为空，给定字符会把用户转义到 \LaTeX：两个这样的
%     字符之间的所有代码都被解释为 \LaTeX\ 代码。注意
%     \TeX 的特殊字符必须带前置反斜杠输入，
%     例如 |escapechar=\%|。
%
%   \item[0.20,{{}}]
%     \rkeyname{escapeinside}|=|\meta{character}\meta{character}^^A
%     \syntaxor\rkeyname{escapeinside}|={}|
%
%     是 \ikeyname{escapechar} 的一般化。若值
%     不为空，宏包会在第一个和第二个
%     字符之间转义到 \LaTeX。
%
%   \item[0.20,{{}}] \rkeyname{escapebegin}|=|\meta{tokens}
%   \item[0.20,{{}}] \rkeyname{escapeend}|=|\meta{tokens}
%
%     这些记号分别在每次转义的开头和结尾执行，
%     尤其是对 \ikeyname{texcl}。应用见第
%     \ref{uNationalCharacters} 节。
% \end{syntax}
%
% \begin{lstsample}{\lstset{morecomment=[l]//}}{}
%    \begin{lstlisting}[mathescape]
%    // calculate $a_{ij}$
%      $a_{ij} = a_{jj}/a_{ij}$;
%    \end{lstlisting}
% \end{lstsample}
%
% \begin{lstsample}{\lstset{morecomment=[l]//}}{}
%    \begin{lstlisting}[escapechar=\%]
%    // calc%ulate $a_{ij}$%
%      %$a_{ij} = a_{jj}/a_{ij}$%;
%    \end{lstlisting}
% \end{lstsample}
%
% \begin{lstsample}{\lstset{morecomment=[l]//}}{}
%    \lstset{escapeinside=`'}
%    \begin{lstlisting}
%    // calc`ulate $a_{ij}$'
%      `$a_{ij} = a_{jj}/a_{ij}$';
%    \end{lstlisting}
% \end{lstsample}
% 第一个例子中，直到 $a_{ij}$ 的注释行由
% \packagename{listings} 宏包以注释样式排版。$a_{ij}$ 本身
% 则以``\TeX\ 数学模式''排版，不带注释样式。第二个例子的
% 注释行约有一半由本宏包排版，
% 其余部分处于``\LaTeX\ 模式''。
%
% 为避免与本宏包当前和未来版本的问题：
% \begin{enumerate}
% \item 当你已转义到 \LaTeX 时，不要使用 \packagename{listings} 宏包的任何命令。
% \item 任何环境必须在同一个转义内开始和结束。
% \item 你可以使用 |\def|、|\edef| 等，但不要假定这些
%       定义稍后仍然存在，除非它们是 |\global| 的。
% \item |\if \else \fi|、分组、数学切换符 |$| 和 |$$| 等必须
%       在每个转义内保持平衡。
% \item \ldots
% \end{enumerate}
% 你可以自行扩充这个列表，并把新条目寄给我。
%
%
% \subsection{与 \packagename{fancyvrb} 的接口}
%
% \packagename{fancyvrb} 宏包——精美 verbatim——由 Timothy van Zandt 编写，
% 提供用于读取、写入和排版 verbatim 代码的宏。它有一些 \packagename{listings}
% 宏包没有的显著特性。（有些是可能的，但你必须找到愿意实现它们的人 |;-)|。）
% \begin{syntax}
%   \item[0.19] \rkeyname{fancyvrb}|=|\meta{\alternative{true,false}}
%
%     激活或关闭该接口。若激活，verbatim 代码由
%     \packagename{fancyvrb} 读取，但由 \packagename{listings} 排版，
%     即带高亮的关键词、字符串、注释等。
%     内部我们使用 |\FancyVerbFormatLine| 的一个非常特殊的
%     定义。
%
%     该接口适用于 |Verbatim|、|BVerbatim| 和 |LVerbatim|。
%     但你不应该使用 \packagename{fancyvrb} 的
%     \keyname{defineactive}。（据我所见这无关紧要，因为它
%     根本不起作用，但为了安全起见……）如果
%     \packagename{fancyvrb} 和 \packagename{listings} 提供类似
%     功能，应当使用 \packagename{fancyvrb} 的。
%
%   \item[1.1,{\overlay 1}]
%     \rkeyname{fvcmdparams}|=|\meta{command$_1$}\meta{number$_1$}^^A
%     \ldots\label{uoption:fvcmdparams}
%   \item[1.1]
%     \rkeyname{morefvcmdparams}|=|\meta{command$_1$}\meta{number$_1$}^^A
%     \ldots\label{uoption:morefvcmdparams}
%
%     如果使用 \packagename{fancyvrb} 的 \keyname{commandchars}，就必须
%     告诉 \packagename{listings} 宏包每个命令
%     接受几个参数。如果命令不接参数，则无需
%     处理。
%
%     键的第一个（第三、第五……）参数是命令，
%     第二个（第四、第六……）是该命令接受的参数个数。因此，
%     如果要在 \packagename{fancyvrb}-\packagename{listings} 接口中使用 |\textcolor{red}{keyword}|，
%     应写 |\lstset{morefvcmdparams=\textcolor 2}|。
% \end{syntax}
%
% \iffancyvrb
% \begin{lstsample}{}{}
%    \lstset{morecomment=[l]\ }% :-)
%    \fvset{commandchars=\\\{\}}
%
%    \begin{BVerbatim}
%    First verbatim line.
%    \fbox{Second} verbatim line.
%    \end{BVerbatim}
%
%    \par\vspace{72.27pt}
%
%    \lstset{fancyvrb}
%    \begin{BVerbatim}
%    First verbatim line.
%    \fbox{Second} verbatim line.
%    \end{BVerbatim}
%    \lstset{fancyvrb=false}
% \end{lstsample}
% 由 \packagename{listings} 宏包排版的行更宽，因为默认的 \ikeyname{basewidth}
% 不等于单个打字机字符的宽度。此外，注意第一个空格开始一个注释，
% 如例子开头所定义的。
% \else
% \begin{center}
%    你的平台上似乎没有 \packagename{fancyvrb}，因此该例子无法在此打印。
% \end{center}
% \fi
