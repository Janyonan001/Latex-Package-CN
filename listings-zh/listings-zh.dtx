% 也可以定义 |\lstinline| 的短等效形式，做法类似于
% \packagename{shortvrb} 提供的短 verbatim 宏。
%
% \begin{syntax}
% \item[1.4] \rcmdname\lstMakeShortInline[\oarg{options}]\meta{character}
%
%       把 \meta{character} 定义为
%       |\lstinline|[\oarg{options}]\meta{character} 的等效形式，
%       在大量使用行内列表时提供方便的语法。
%
% \item[1.4] \rcmdname\lstDeleteShortInline\meta{character}
%
%       删除由 |\lstMakeShortInline| 创建的 \meta{character} 定义，
%       使 \meta{character} 恢复其原有含义。
% \end{syntax}
