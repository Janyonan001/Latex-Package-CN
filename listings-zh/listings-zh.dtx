% \subsection{文学编程}
%
% 我们从一个例子开始，并隐藏关键的键值列表。
% \begin{lstsample}{%
%   \lstset{literate={:=}{{$\gets$}}1 {<=}{{$\leq$}}1 {>=}{{$\geq$}}1 ^^A
%     {<>}{{$\neq$}}1}}{}
%    \begin{lstlisting}
%    var i:integer;
%
%    if (i<=0) i := 1;
%    if (i>=0) i := 0;
%    if (i<>0) i := 0;
%    \end{lstlisting}
% \end{lstsample}
% 有趣，不是吗？我们可以在列表中保留 |i := 0| 而不是
% i| |$\gets$| |0，但那不够文学化！^^A :-)
% 现在你可能想知道这是怎么做到的。请\emph{仔细}看看下面的键。
% \begin{syntax}
%   \item[0.20,,\dag] \rkeyname{literate}|=|[|*|]\meta{replacement
%     item}\ldots\meta{replacement item}
%
%     首先注意各项之间没有逗号。每项由三个参数组成：\marg{replace}
%     \marg{replacement text}\marg{length}。\meta{replace} 是原始字符序列。
%     我们不打印这些字符，而是使用 \meta{replacement text}，
%     它在输出中占据 \meta{length} 个字符的宽度。
%
%     \meta{replacement text} 中的每个`打印单元'\emph{必须}用花括号括起来，
%     除非它是单个字符。例如，你必须用花括号括住 |$\leq$|。
%     如果你想用 |$\leftarrow1\rightarrow$| 替换 |<-1->|，
%     替换项应该是 |{<-1->}{{$\leftarrow$}1{$\rightarrow$}}3|。
%     注意箭头周围的花括号。
%
%     如果一个 \meta{replace} 是另一个 \meta{replace} 的子序列，
%     你必须先定义较短的序列。例如，必须在 |{--}| 之前定义 |{-}|，
%     在 |{-->}| 之前定义 |{--}|。
%
%     可选星号表示不在字符串、注释和其他分隔文本中进行文学替换。
% \end{syntax}
% 在上面的例子中，我使用了
% \begin{verbatim}
%  literate={:=}{{$\gets$}}1 {<=}{{$\leq$}}1 {>=}{{$\geq$}}1 {<>}{{$\neq$}}1\end{verbatim}
% \begin{TODO}
% 当然，有用于添加和删除单个 \meta{replacement item} 的键会很好。
% 也许键应该以与字符串和注释定义相同的方式工作，即每个键值对一项。
% 这样在子序列的情况下更容易提供更好的自动检测。
% \end{TODO}
%
