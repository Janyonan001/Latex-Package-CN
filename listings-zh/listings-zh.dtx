% \subsection{定界符}
%
% 我们分两个阶段描述：给现有定界符类添加新定界符类型，
% 以及编写新类。每个类都有自己的名字；目前有
% \texttt{Comment}、\texttt{String} 和 \texttt{Delim}。如你所知，
% 后者和前者都提供类型 \texttt l，但没有以给定定界符开始、到行尾
% 结束的字符串。所以我们现在就来添加它！
%
% 首先，我们用下列内容扩展字符串类型列表
% \begin{verbatim}
%    \lst@AddTo\lst@stringtypes{,l}\end{verbatim}
% 然后我们必须提供接受用户给定定界符并
% 做相应定义的宏。命令名由前缀
% |\lst@|、定界符名、用于动态模式的 |DM| 组成，后面再接
% |@| 和类型。
% \begin{verbatim}
%    \gdef\lst@StringDM@l#1#2\@empty#3#4#5{%
%        \lst@CArg #2\relax\lst@DefDelimB{}{}{}#3{#1}{#5\lst@Lmodetrue}}\end{verbatim}
% 你可以把这三行放进一个 \texttt{.sty} 文件中，或者在文档导言区用
% |\makeatletter| 和 |\makeatother| 包围它们。
% 就是这样！
%{\makeatletter
%\lst@AddTo\lst@stringtypes{,l}
%\gdef\lst@StringDM@l#1#2\@empty#3#4#5{^^A
%   \lst@CArg #2\relax\lst@DefDelimB{}{}{}#3{#1}{#5\lst@Lmodetrue}}
%}
% \begin{lstsample}{}{}
%    \lstset{string=[l]//}
%    \begin{lstlisting}
%    // This is a string.
%    This isn't a string.
%    \end{lstlisting}
% \end{lstsample}
% 当然，你想要更多细节。先从参数说起。
% \begin{itemize}
% \item 第一个参数（\emph{在} |\@empty| 之后）用于开始
%             定界符。它由定界符类提供。
% \item 第二个参数（\emph{在} |\@empty| 之后）用于结束
%             定界符。它同样由定界符类提供。例子中我们
%             不需要它，见下面的说明。
% \item 第三个参数（\emph{在} |\@empty| 之后）是
%       \marg{style}\meta{start tokens}.
%             它前面加上 |\def\lst@currstyle| 后作为参数传给
%             |\lst@EnterMode|。定界符类也会提供它。例子中我们
%             用 |\lst@Lmodetrue|（行模式为真）`扩展'了 |#5|。
%             该模式会在行尾自动结束，所以我们不需要
%             结束定界符参数。
% \end{itemize}
% 现在看其他参数。在动态模式的情况下，第一个参数
% 是模式号。然后是用户提供的定界符，其数量
% 必须与直到 |\@empty| 的其余参数匹配。对于非动态模式，
% 你必须自己分配一个静态模式，或者使用预定义的模式
% 号。此时定界符从第一个参数开始。
%
% 最后看看宏的替换文本。序列
% |\lst@CArg #2\relax| 在 |\lst@DefDelimB| 之后放两个必需参数。
% 后一个宏的语法是
% \begin{syntax}
% \item[1.0] \cs{lst@DefDelimB}
%
%   |{|\meta{1st}\meta{2nd}\marg{rest}|}|\syntaxfill |{//{}}|\\
%   \meta{save 1st}\syntaxfill |\lst@c/0|\\
%   \marg{execute}\syntaxfill|{}|\\
%   \marg{delim~exe~modetrue}\syntaxfill|{}|\\
%   \marg{delim~exe~modefalse}\syntaxfill|{}|\\
%   \meta{start-delimiter macro}\syntaxfill|#3|\\
%   \meta{mode number}\syntaxfill |{#1}|\\
%   |{|\marg{style}\meta{start tokens}|}|\syntaxfill |{#5\lst@Lmodetrue}|
%
%             把 \meta{1st}\meta{2nd}\meta{rest} 定义为起始定界符。
%             当宏包遇到 \meta{1st} 时执行 \meta{execute}。
%             只有当整个定界符 \meta{1st}\meta{2nd}\meta{rest}
%             被找到时才执行 \meta{delim~exe~modetrue} 和 \meta{delim~exe~modefalse}。
%             依据 |\lst@ifmode| 恰好调用其中一个。
%
%             默认情况下，如果找到定界符\emph{并且} |\lst@ifmode| 为假，
%             宏包就进入该模式。内部我们对 |\lst@bnext|
%             做相应的定义，可以通过把
%             |\@gobblethree| 放在 \meta{delim exe modefalse} 的最末尾来吃掉它。
%             也可以提供自己的定义（并吃掉默认的）。
%
%             \meta{save 1st} 必须是一个未定义的宏，内部用于
%             保存 \meta{1st} 先前的含义。如果定界符严格少于
%             三个字符，参数 \meta{2nd} 和/或 \meta{rest} 为空。
%             \meta{1st}\meta{2nd}\meta{rest} 的所有字符
%             必须已经是活动的（若非空）。这不成问题，
%             因为宏 |\lst@CArgX| 负责这件事。
%
% \item[1.0] \cs{lst@DefDelimE}
%
%   |{|\meta{1st}\meta{2nd}\marg{rest}|}|\\
%   \meta{save 1st}\\
%   \marg{execute}\\
%   \marg{delim~exe~modetrue}\\
%   \marg{delim~exe~modefalse}\\
%   \meta{end-delimiter macro}\\
%   \meta{mode number}
%
%             结束定界符同理，但有细微差别：
%             \meta{delim~exe~modetrue} 和 \meta{delim~exe~modefalse} 的执行
%             取决于 |\lst@mode| 是否等于 \meta{mode}。
%
%             宏包在找到定界符且 |\lst@mode|
%             等于 \meta{mode} 时结束该模式。内部我们对
%             |\lst@enext|（不是 |\lst@bnext|）做相应的定义，可以通过把
%             |\@gobblethree| 放在 \meta{delim exe modetrue} 的最末尾来吃掉它。
%
% \item[1.0] \cs{lst@DefDelimBE}
%
%     后面跟与 |\lst@DefDelimB| 相同的八个参数，以及\ldots\\
%   \meta{end-delimiter macro}
%
%             这是 |\lst@DefDelimB| 与 |\lst@DefDelimE| 的组合，用于
%             起始和结束定界符相同的情况。
% \end{syntax}
% 我们通过两个简单例子结束第一阶段。
% \texttt d 类型字符串由下列方式定义
% \begin{verbatim}
%    \gdef\lst@StringDM@d#1#2\@empty#3#4#5{%
%        \lst@CArg #2\relax\lst@DefDelimBE{}{}{}#3{#1}{#5}#4}\end{verbatim}
% （以及字符串类型列表中的一个条目）。
% 没什么难的。\texttt d 类型注释同理：
% \begin{verbatim}
%    \gdef\lst@CommentDM@s#1#2#3\@empty#4#5#6{%
%        \lst@CArg #2\relax\lst@DefDelimB{}{}{}#4{#1}{#6}%
%        \lst@CArg #3\relax\lst@DefDelimE{}{}{}#5{#1}}\end{verbatim}
% 这里我们只需同时使用 |\lst@DefDelimB| 和 |\lst@DefDelimE|。
% \goodbreak
%
% 现在进入第二阶段。为说明起见，下面是
% \texttt{Delim} 类的定义。传给服务宏的第一个参数
% 分别使它删除该类的所有定界符、添加该定界符，或只删除
% 该特定定界符。
% \begin{verbatim}
%    \lst@Key{delim}\relax{\lst@DelimKey\@empty{#1}}
%    \lst@Key{moredelim}\relax{\lst@DelimKey\relax{#1}}
%    \lst@Key{deletedelim}\relax{\lst@DelimKey\@nil{#1}}\end{verbatim}
% 服务宏本身会用相应参数调用另一个宏。
% \begin{verbatim}
%    \gdef\lst@DelimKey#1#2{%
%        \lst@Delim{}#2\relax{Delim}\lst@delimtypes #1%
%                    {\lst@BeginDelim\lst@EndDelim}
%            i\@empty{\lst@BeginIDelim\lst@EndIDelim}}\end{verbatim}
% 我们必须看看这些参数。上面是 \texttt{Delim} 类的实际参数，
% 下面是 \texttt{Comment} 类的参数。
% 注意用户提供的值占了参数的第二行和第三
% 行。
% \begin{syntax}
%     \item[0.21,,changed] \cs{lst@Delim}
%
%     \meta{default style macro}\syntaxfill \cs{lst@commentstyle}\\ \relax
%     [\texttt*[\texttt*]]\texttt[\meta{type}\texttt][\texttt[\meta{style}^^A
%     \texttt][\texttt[\meta{type option}\texttt]]]\\
%     \meta{delimiter\textup(s\textup)}\cs{relax}\syntaxfill|#2|\cs{relax}\\
%     \marg{delimiter name}\syntaxfill|{Comment}|\\
%     \meta{delimiter types macro}\syntaxfill\texttt{\cs{lst@commenttypes}}\\
%     \alternative{\cs{@empty},\cs{@nil},\cs{relax}}\syntaxfill|#1|\\
%     \marg{begin- and end-delim macro}\syntaxfill|{|\cs{lst@BeginComment}^^A
%     \cs{lst@EndComment}|}|\\
%     \meta{extra prefix}\syntaxfill |i|\\
%     \meta{extra conversion}\syntaxfill |\@empty|\\
%     \marg{begin- and end-delim macro}\syntaxfill|{|\cs{lst@BeginIComment}^^A
%     \cs{lst@EndIComment}|}|
%
%         大多数参数应该很清楚。我们讨论后四个。两个
%         \marg{begin- and end-delim macro} 必须恰好包含两个控制
%         序列，它们被传给 |\lst@|\meta{name}[|DM|]|@|\meta{type}
%         以开始和结束一个定界符。它们就是 |\lst@StringDM@l| 第一个例子中的
%         参数 |#3| 和 |#4|。取决于用户选择的类型是否以
%         \meta{extra prefix} 开头，会使用前两个
%         或后两个控制序列。
%
%         默认情况下，宏包取定界符、把字符
%         变成活动字符，并把它们放在
%         |\lst@|\meta{name}[|DM|]|@|\meta{type} 之后。如果用户类型以
%         \meta{extra prefix} 开头，\meta{extra conversion} 可能会改变
%         |\lst@next| 的定义，以选择另一种转换。
%         默认等价于带 |\lst@false| 的 |\lst@XConvert|。
%
%         注意 \meta{type} 从不会以 \meta{extra prefix} 开头，因为它
%         会被丢弃。该功能必须通过选择一对不同的
%         \marg{begin- and end-delim macro} 来完整实现。
% \end{syntax}
% 你可能需要了解 \meta{begin- and end-delim macro} 的语法。
% 它们的调用方式如下。
% \begin{syntax}
% \item[0.21] |\lst@Begin|\meta{whatever}
%
%   \marg{mode}
%   |{|\marg{style}\meta{start tokens}|}|
%   \meta{delimiter}|\@empty|
%
% \item[0.21] |\lst@End|\meta{whatever}
%
%   \marg{mode}
%   \meta{delimiter}|\@empty|
% \end{syntax}
% 现有的宏在内部是由 |\lst@DelimOpen| 和
% |\lst@DelimClose| 定义的，见实现部分。
