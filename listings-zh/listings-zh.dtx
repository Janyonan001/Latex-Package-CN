% \begin{lstkey}{boxpos}
% \begin{macro}{\lst@boxtrue}
% 设置（可能使用的）盒子的垂直对齐，或者指示
% 使用了盒子。
%    \begin{macrocode}
\lst@Key{boxpos}{c}{\def\lst@boxpos{#1}}
%    \end{macrocode}
%    \begin{macrocode}
\def\lst@boxtrue{\let\lst@ifbox\iftrue}
\let\lst@ifbox\iffalse
%    \end{macrocode}
% \end{macro}\end{lstkey}
