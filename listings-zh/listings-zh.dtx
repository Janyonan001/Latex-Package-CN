% \paragraph{换页符}
% 是在与以下各方交流之后引入的
% \lsthelper{Jan~Braun}{1998/04/27}{formfeed}.
%
% \begin{lstkey}{formfeed}
% 让用户做调整。
%    \begin{macrocode}
\lst@Key{formfeed}{\bigbreak}{\def\lst@formfeed{#1}}
%    \end{macrocode}
% \end{lstkey}
%
% \begin{macro}{\lst@ProcessFormFeed}
% 这里我们根据是否已经开始新行来执行一些宏。
% else 分支中不再使用 |\lst@EOLUpdate|
% ——\lsthelper{Kalle~Tuulos}{2001/01/14}{换页符吃掉后续
% 输出单元}发来了缺陷报告。
%    \begin{macrocode}
\def\lst@ProcessFormFeed{%
    \lst@XPrintToken
    \ifnum\lst@newlines=\z@
        \lst@EOLUpdate \lsthk@InitVarsBOL
    \fi
    \lst@formfeed
    \lst@whitespacetrue}
%    \end{macrocode}
% \end{macro}
