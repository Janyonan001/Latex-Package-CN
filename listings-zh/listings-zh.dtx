%
% \begin{macro}{\lst@BeginString}
% 注意 |\lst@DelimOpen| 之后的记号是参数！这里唯一特别的
% 是，如有必要，我们在开始字符串之后切换到`保留空格'。
% \lsthelper{Vespe~Savikko}{2000/09/27}{stringstyle 也被用于
% 前面的其他字符}报告的缺陷由于使用 |\lst@DelimOpen| 而消失。
%    \begin{macrocode}
\gdef\lst@BeginString{%
    \lst@DelimOpen
        \lst@ifexstrings\else
        {\lst@ifshowstringspaces
             \lst@keepspacestrue
             \let\lst@outputspace\lst@visiblespace
         \fi}}
%    \end{macrocode}
%    \begin{macrocode}
\lst@AddToHookExe{ExcludeDelims}{\let\lst@ifexstrings\iffalse}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@EndString}
% 同样，|\lst@DelimClose| 之后的两个记号是参数。
%    \begin{macrocode}
\gdef\lst@EndString{\lst@DelimClose\lst@ifexstrings\else}
%    \end{macrocode}
% \end{macro}
%
% 现在是所有 |\lst@StringDM@|\meta{type} 定义。
%
% \begin{macro}{\lst@StringDM@d}
% `d' 表示没有额外工作；|\lst@DefDelimBE| 之后的头三个参数
% 留空。其余用于开始和结束字符串。
%    \begin{macrocode}
\gdef\lst@StringDM@d#1#2\@empty#3#4#5{%
    \lst@CArg #2\relax\lst@DefDelimBE{}{}{}#3{#1}{#5}#4}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@StringDM@b}
% |\lst@ifletter|\ldots|\fi| 是在以下缺陷报告之后插入的：
% \lsthelper{Daniel~Gerigk}{2001/10/25}{C++ 中不正确的字符串}和
% \lsthelper{Peter~Bartke}{2001/11/01}{C++ 中不正确的字符串}。如果最后
% 一个其他字符是反斜杠（第 4 行），我们就吃掉`结束字符串'记号
% 序列。
%    \begin{macrocode}
\gdef\lst@StringDM@b#1#2\@empty#3#4#5{%
    \let\lst@ifbstring\iftrue
    \lst@CArg #2\relax\lst@DefDelimBE
       {\lst@ifletter \lst@Output \lst@letterfalse \fi}%
       {\ifx\lst@lastother\lstum@backslash
            \expandafter\@gobblethree
        \fi}{}#3{#1}{#5}#4}
