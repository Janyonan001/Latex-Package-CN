%
% 如果用户选择了 |podcomment=true|，我们就调整某些字符。
%    \begin{macrocode}
\lst@AddToHook{SelectCharTable}
    {\lst@ifpodcomment
         \lst@CArgX =\relax\lst@DefDelimB{}{}%
%    \end{macrocode}
% 如果找到等号并且尚未进入模式（事实上是允许模式改动时），
% 就执行下面的代码：我们`开始丢弃输出'，并
% 在 POD 不打印时吃掉通常的注释开始序列（通过 |\@gobblethree|）。
% 此外，如果当前列号不是零，我们也吃掉它
% ——|\@tempcnta| 在下面被赋值。
%    \begin{macrocode}
           {\ifnum\@tempcnta=\z@
                \lst@ifprintpod\else
                    \def\lst@bnext{\lst@BeginDropOutput\lst@PODmode}%
                    \expandafter\expandafter\expandafter\@gobblethree
                \fi
            \else
               \expandafter\@gobblethree
            \fi}%
           \lst@BeginComment\lst@PODmode{{\lst@commentstyle}}%
%    \end{macrocode}
% 如果遇到 |=|，我们就计算当前列号（从零起算）。
%    \begin{macrocode}
         \lst@CArgX =cut\^^M\relax\lst@DefDelimE
           {\lst@CalcColumn}%
%    \end{macrocode}
% 如果另外还有 |cut|+EOL，并且我们处在 |\lst@PODmode| 但不在
% 第一列，我们就必须吃掉`结束注释序列'。
%    \begin{macrocode}
           {\ifnum\@tempcnta=\z@\else
                \expandafter\@gobblethree
            \fi}%
           {}%
           \lst@EndComment\lst@PODmode
     \fi}
%    \end{macrocode}
