% 好，现在来看真正的挑战。更通用的定界符可以用
% 键 {\rstyle\ikeyname{moredelim}} 来定义。合法类型是 {\rstyle\texttt{l}}
% 和 {\rstyle\texttt{s}}。这些类型前面可以加一个 \texttt{i}，但
% 此时\emph{只有定界符}会从输出中删除。这样
% 你就可以通过标记来选择样式。
% \begin{lstxsample}
%    \lstset{moredelim=[is][\ttfamily]{|}{|}}
% \end{lstxsample}
% \begin{lstsample}{}{}
%    \begin{lstlisting}
%    roman |typewriter|
%    \end{lstlisting}
% \end{lstsample}
% 你甚至可以让宏包在内容内部检测关键词、注释、字符串和其他分隔符。
% \begin{lstxsample}
%    \lstset{moredelim=*[s][\itshape]{/*}{*/}}
% \end{lstxsample}
% \begin{lstsample}{}{}
%    \begin{lstlisting}
%    /* begin
%      (* comment *)
%       ' string ' */
%    \end{lstlisting}
% \end{lstsample}
% 此外，你可以强制样式累积应用。
% \begin{lstxsample}
%    \lstset{moredelim=**[is][\ttfamily]{|}{|}, % cumulative
%            moredelim=*[s][\itshape]{/*}{*/}}  % not so
% \end{lstxsample}
% \begin{lstsample}{}{}
%    \begin{lstlisting}
%    /* begin
%       ' string '
%       |typewriter| */
%
%    | begin
%     ' string '
%     /*typewriter*/ |
%    \end{lstlisting}
% \end{lstsample}
% 仔细看输出并注意区别。第二个 \texttt{begin} 没有用粗体打字机字体
% 打印，因为标准 \LaTeX 没有这样的字体。
%
% 介绍就到这里。现在去寻找更多应用吧。
