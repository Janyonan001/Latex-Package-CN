% \begin{macro}{\lst@CCECUse}
% 到达列表末尾（|^^00|）时我们终止循环。
% 否则，如果字符不是活动的，我们就做与 |\lst@CCPut| 相同的事。
% 但如果字符是活动的，我们在重新定义之前保存其含义。
%    \begin{macrocode}
\def\lst@CCECUse#1#2{%
    \ifnum`#2=\z@
        \expandafter\@gobbletwo
    \else
        \ifnum\catcode`#2=\active
            \lccode`\~=`#2\lccode`\/=`#2\lowercase{\lst@CCECUse@#1~/}%
        \else
            \lst@ifactivechars \catcode`#2=\active \fi
            \lccode`\~=`#2\lccode`\/=`#2\lowercase{\def~{#1/}}%
        \fi
    \fi
    \lst@CCECUse#1}
%    \end{macrocode}
% 我们如前所述保存含义。这里我们还必须使用`|\lst@UM|
% 构造'，因为扩展字符经常出现在单词中 =
% 标识符中。缺陷由 \lsthelper{Denis~Girou}{1999/07/26}{与 inputenc 不兼容}报告。
%    \begin{macrocode}
\def\lst@CCECUse@#1#2#3{%
    \expandafter\def\csname\@lst @EC#3\endcsname{\lst@UM#3}%
    \expandafter\let\csname\@lst @um#3@\endcsname #2%
    \edef#2{\noexpand#1%
            \expandafter\noexpand\csname\@lst @EC#3\endcsname}}
%    \end{macrocode}
% \lsthelper{Daniel~Gerigk}{2001/10/25}{extendedchars 不起作用}和
% \lsthelper{Heiko~Oberdiek}{2001/10/26}{extendedchars 不起作用：um@\#3@
% 应为 @um\#3@}分别报告了一个错误和一个解决方案。
% \end{macro}
