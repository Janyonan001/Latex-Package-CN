% \begin{macro}{\lst@HRefStepCounter}
% 这个宏把列表编号设为负值，因为用户
% 不应引用这样的列表。如果存在 \packagename{hyperref} 宏包，
% 我们就用`lstlisting.'（上面的参数）与
% 当前（负）编号拼接后交给 hyperref。
% 加入这些分组是为了防止其他宏包（即
% \packagename{tabularx}）读取局部改动的计数器
% 并把它全局写回。感谢 \lsthelper{Michael~Niedermair}
% {2001/09/18}{列表编号异常}的报告。不幸的是
% 这种局部化又导致了另一个缺陷，见 |\theHlstnumber|。
%    \begin{macrocode}
\def\lst@HRefStepCounter#1{%
  \begingroup
  \c@lstlisting\lst@neglisting
  \advance\c@lstlisting\m@ne \xdef\lst@neglisting{\the\c@lstlisting}%
  \ifx\hyper@refstepcounter\@undefined\else
      \hyper@refstepcounter{#1}%
  \fi
  \endgroup
}
\gdef\lst@neglisting{\z@}% init, \z@ can be used both for 0pt and 0,
                         % remember: _neg_ative number, but no
                         % counter!
%    \end{macrocode}
% \end{macro}
