% \begin{macro}{\lst@DefRange}
%        |\lst@DefRange| 不再通过钩子插入。现在它由
%        |\lst@SelectCharTable| 直接调用。为了摆脱与
%        转义到 LaTeX 特性的干扰，这是必要的。该缺陷由
%        \lsthelper{Michael~Bachmann}{2004/07/21}{无法进行 label 引用
%        \ldots}报告。另一处改动也源于同一缺陷：当找到代码开头时，
%        |\lst@DefRange| 被全局重新定义，见下。该缺陷
%        由 \lsthelper{Tobias~Rapp}{2004/04/06}{列表跨分页时
%        未检测到范围末尾}和 \lsthelper{Markus~Luisser}{2004/08/13}{折行列表中的
%        `linerangemarker'缺陷}报告。
%    \begin{macrocode}
\lst@AddToHookExe{DeInit}{\global\let\lst@DefRange\@empty}
