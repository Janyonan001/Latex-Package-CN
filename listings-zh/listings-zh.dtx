% \section{基本概念}\label{dBasicConcepts}
%
% \packagename{listings} 宏包的功能似乎
% 分为两部分：一部分是实际排版
% 列表的命令，另一部分是通过 |\lstset| 可调的参数。二者都可以
% 用 \lst-方面（aspect）来实现，而这些方面不过是
% 公共键与命令以及内部钩子与定义的集合。宏包
% 定义了几个方面，尤其是内核，即主引擎。
% 其他方面驱动这个引擎，而语言和样式定义告诉
% 各方面如何驱动。车、司机和副
% 司机之间的关系被精确复现——而我将做你的驾驶教练。
%
%
% \subsection{加载宏包}\label{dPackageLoading}
%
% |\usepackage[|\meta{options}|]{listings}| 中的每个选项都会加载一个方面，或者
% 当方面名\emph{前面加感叹号}时\emph{阻止}宏包加载它。这一机制的设计目的
% 是理清不同宏包部件之间的依赖关系并便于
% 调试宏包。出于这个原因，还有一个选项：
% \begin{syntax}
% \item[0.21,,option] \texttt{noaspects}\leavevmode
%
%             清空要加载的方面列表。注意，例如选项
%             列表 |0.21,!labels,noaspects| 和 |noaspects| 实质上
%             是相同的：只加载内核，不加载其他方面。
% \end{syntax}
% 这对方面测试特别有用，因为我们可以只加载
% 所需的部分。但要注意，如果某个预定义
% 编程语言请求某个方面，该方面会在稍后被加载。也可以手动加载方面：
% \begin{syntax}
% \item[0.20] |\lstloadaspects|\marg{comma separated list of aspect names}
%
%             加载指定的方面（如果尚未加载）。
% \end{syntax}
% 下面是所有方面及相关键和命令的列表——希望这个
% 列表是完整的。
% \begin{description}
% \hyphenpenalty=10000\relax \rightskip=0pt plus \linewidth\relax
% \item[\aspectname{strings}]\leavevmode
%
%       \lstprintaspectkeysandcmds{strings}
%
% \item[\aspectname{comments}]\leavevmode
%
%       \lstprintaspectkeysandcmds{comments}
%
% \item[\aspectname{pod}]\leavevmode
%
%       \lstprintaspectkeysandcmds{pod}
%
% \item[\aspectname{escape}]\leavevmode
%
%       \lstprintaspectkeysandcmds{escape}
%
% \item[\aspectname{writefile}] 需要 1 个 |\toks|、1 个 |\write|
%
%       |\lst@BeginWriteFile|, |\lst@BeginAlsoWriteFile|, |\lst@EndWriteFile|
%
% \item[\aspectname{style}]\leavevmode
%
%             空样式，\lstprintaspectkeysandcmds{style}
%
% \item[\aspectname{language}]\leavevmode
%
%             空语言，\lstprintaspectkeysandcmds{language}
%
% \item[\aspectname{keywords}]\leavevmode
%
%       \lstprintaspectkeysandcmds{keywords}
%
% \item[\aspectname{emph}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{emph}
%
% \item[\aspectname{html}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{html}
%
% \item[\aspectname{tex}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{tex}
%
% \item[\aspectname{directives}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{directives}
%
% \item[\aspectname{index}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{index}
%
% \item[\aspectname{procnames}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{procnames}
%
% \item[\aspectname{keywordcomments}]
%             需要 \aspectname{keywords}、\aspectname{comments}
%
%       \lstprintaspectkeysandcmds{keywordcomments}
%
% \item[\aspectname{labels}] 需要 2 个 |\count|
%
%       \lstprintaspectkeysandcmds{labels}
%
% \item[\aspectname{lineshape}] 需要 2 个 |\dimen|
%
%       \lstprintaspectkeysandcmds{lineshape}
%
% \item[\aspectname{frames}] 需要 \aspectname{lineshape}
%
%       \lstprintaspectkeysandcmds{frames}
%
% \item[\aspectname{make}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{make}
%
% \item[\aspectname{doc}] 需要 \aspectname{writefile} 和 1 个 |\box|
%
%       \lstprintaspectkeysandcmds{doc}
%
% \item[\aspectname{0.21}] 用新键定义旧键。
% \item[\aspectname{fancyvrb}] 需要 1 个 |\box|
%
%       \lstprintaspectkeysandcmds{fancyvrb}
%
% \item[\aspectname{lgrind}]\leavevmode
%
%       \lstprintaspectkeysandcmds{lgrind}
%
% \item[\aspectname{hyper}] 需要 \aspectname{keywords}
%
%       \lstprintaspectkeysandcmds{hyper}
% \end{description}
% 内核分配 6 个 |\count|、4 个 |\dimen| 和 1 个 |\toks|。
% 此外它还定义下列键、命令和环境：
% \begin{itemize}\item[]
% \hyphenpenalty=10000\relax \rightskip=0pt plus \linewidth\relax
%       \lstprintaspectkeysandcmds{kernel}, \keyname{fancyvrb}
% \end{itemize}
%
%
% \subsection{如何定义 \lst-aspect}\label{dHowToDefineLstAspects}
%
% 至少有三种方式可以添加新功能：(a) 你编写一个普遍
% 感兴趣的方面，寄给我，我直接把它粘贴进
% 实现；(b) 你编写一个不普遍感兴趣的`局部'方面；或
% (c) 你有一个方面的想法，让我来写。(a) 和 (b) 是
% 好选择。^^A :-)
%
% 方面定义以 |\lst@BeginAspect| 加参数开始，以下一个 |\lst@EndAspect|
% 结束。特别地，方面定义不能
% 嵌套。
% \begin{syntax}
% \item[0.20] |\lst@BeginAspect|[\oarg{list of required aspects}]\marg{aspect name}
% \item[0.20] |\lst@EndAspect|
% \end{syntax}
% 可选列表是所需方面名的逗号分隔列表。
% 在下列每种情况下，完整方面不会被定义：
% \begin{enumerate}
% \item \meta{aspect name} 为空。
% \item 该方面已经定义。
% \item 某个所需方面既未定义，也无法通过
%       |\lstloadaspects|.
% \end{enumerate}
% 因此你不能先定义方面的一部分，之后再定义另一部分。
% 但可以先定义方面 $A_1$，之后再定义需要 $A_1$ 的
% 方面 $A_2$。
% \begin{advise}
% \item 把本地附加件放入 `\texttt{lstmisc0.sty}'——默认会先搜索
%             这个文件。如果只想为一个特定文档做附加件，
%             就把外层的 `|\lst@BeginAspect|' 和
%             `|\lst@EndAspect|' 换成 `|\makeatletter|' 和 `|\makeatother|'，并在
%             文档导言区使用这些定义。不过，所需方面必须由你自己
%             加载。
% \end{advise}
% 你可以在两条命令之间放任何 \TeX\ 材料，但注意
% 如果稍后还需要这些定义，它们必须是 |\global| 的——\LaTeX 的 |\newcommand|
% 产生局部定义，且前面不能加 |\global|。所以请使用下面
% 列出的命令、|\gdef| 以及后续各节描述的命令。
% \begin{syntax}
% \item[0.20] |\lst@UserCommand|\meta{macro}\meta{parameter text}\marg{replacement text}
%
%             该宏（主要）等价于 |\gdef|。目的是
%             区分用户命令和内部全局定义。
%
% \item[0.19] |\lst@Key|\marg{key name}\marg{init value}[\oarg{default value}]\marg{definition}
% \item[0.19] |\lst@Key|\marg{key name}|\relax|[\oarg{default value}]\marg{definition}
%
%             使用 David Carlisle 的 \packagename{keyval} 宏包定义一个键。
%             \meta{definition} 是一个带一个参数的宏的替换文本。
%             参数要么是 `key=value' 中的值，要么在未给出 `=value' 时
%             是 \meta{default value}。下面的辅助宏
%             |\lstKV@...| 或许能简化 \meta{definition}。
%
%             如果第二个参数是 |\relax|，该键不会被初始化。
%             否则 \meta{init value} 是赋给该键的初始值。
%             注意我们在局部切换到 |\globalsdefs=1|，以确保
%             初始化不受分组影响。
%
% \item[0.19] |\lst@AddToHook|\marg{name of hook}\marg{\TeX\ material}
%
%             在预定义点添加 \TeX\ 材料。第~\ref{dHooks} 节列出
%             所有钩子及其定义与执行的位置。
%             |\lst@AddToHook{A}{\csa}| 在 |\lst@AddToHook{A}{\csb}| 之前
%             \emph{不}保证 |\csa| 在 |\csb| 之前执行。
%
% \item[0.20] |\lst@AddToHookExe|\marg{name of hook}\marg{\TeX\ material}
%
%             还会为初始化执行 \meta{\TeX\ material}。你可以使用
%             局部变量——\TeX\ 意义上的局部和/或通常编程
%             语言意义上的局部——但当代码为初始化执行时，所有
%             赋值都是全局的：我们把 |\globaldefs| 局部设为一。
%
% \item[0.20] |\lst@UseHook|\marg{name of hook}
%
%             执行该钩子。
% \end{syntax}
% \begin{advise}
% \item 我们来看两个例子。第一个通过添加一些钩子材料来
%             扩展宏包。如果你想要状态消息，可以写
% \begin{verbatim}
%    \lst@AddToHook{Init}{\message{\MessageBreak Processing listing ...}}
%    \lst@AddToHook{DeInit}{\message{complete.\MessageBreak}}\end{verbatim}
%             第二个例子引入两个键，让用户控制这些
%             消息。宏 |\lst@AddTo| 在第
%       \ref{dGeneralPurposeMacros}.
% \begin{verbatim}
%   \lst@BeginAspect{message}
%   \lst@Key{message}{Annoying message.}{\gdef\lst@message{#1}}
%   \lst@Key{moremessage}\relax{\lst@AddTo\lst@message{\MessageBreak#1}}
%   \lst@AddToHook{Init}{\typeout{\MessageBreak\lst@message}}
%   \lst@EndAspect\end{verbatim}
%       不过，当然还有更有用的 aspect。
% \end{advise}
% 以下宏可用于 |\lst@Key| 命令的 \meta{definition} 参数中来求值参数。
% 额外的前缀 |KV|
% 指 \packagename{keyval} 宏包。
% \begin{syntax}
% \item[0.19] |\lstKV@SetIf|\marg{value}\meta{if macro}
%
%             \meta{if macro} 在 \meta{value} 的第一个字符等于
%             |t| 或 |T| 时变成 |\iftrue|。否则它变成 |\iffalse|。
%             通常你会用 |#1| 作为 \meta{value}。
%
% \item[1.0] \cs{lstKV@SwitchCases}\marg{value}\\
%   |{|\meta{string 1}|:|\meta{execute 1}|\\|\\
%   | |\meta{string 2}|:|\meta{execute 2}|\\|\\
%   \hbox to 3em{\hfill\vdots}\\
%   | |\meta{string $n$}|;|\meta{execute $n$}|}|\marg{else}
%
%             要么执行 \meta{else}，要么执行与 \meta{value} 匹配的部分。
%
%             本实现基于 \lsthelper{David~Carlisle}{2016/05/25}{%
%             http://tex.stackexchange.com/questions/311383/^^A
%                 adding-frame-none-to-lstlisting-options-in-lstdefinestyle^^A
%                 -gives-error-with-tabu} 的一个提示，以避免 C. Heinz
%             原始实现的问题\label{gAmpersand}:
%       \begin{quote}
%           \cs{lstKV@SwitchCases}\marg{value}\\
%           |{|\meta{string 1}|&|\meta{execute 1}|\\|\\
%           | |\meta{string 2}|&|\meta{execute 2}|\\|\\
%           \hbox to 3em{\hfill\vdots}\\
%           | |\meta{string $n$}|&|\meta{execute $n$}|}|\marg{else}
%       \end{quote}
%             当列表是 tabular 环境的一部分时就会出现这个问题，
%             这是由
%             \lsthelper{Nasser~M.~Abbasi}{2016/05/25}{listings 宏包中
%             可能的缺陷}发现的。
%
% \item[0.20] |\lstKV@TwoArg|\marg{value}\marg{subdefinition}
% \item[0.20] |\lstKV@ThreeArg|\marg{value}\marg{subdefinition}
% \item[0.20] |\lstKV@FourArg|\marg{value}\marg{subdefinition}
%
%             \meta{subdefinition} 是带两个、三个和四个参数的宏的
%             替换文本。我们用 \meta{value} 给出的参数
%             调用这个宏。如有必要会补上空参数。
%
% \item[0.19] |\lstKV@OptArg|\oarg{default arg.}\marg{value}\marg{subdefinition}
%
%             |[|\meta{default arg.}|]| \emph{不是}可选的。\meta{subdefinition}
%             是参数文本为 |[##1]##2| 的宏的替换文本。
%             注意宏参数字符 |#| 需要双写，因为它用在
%             另一个宏内部。\meta{subdefinition} 通过 |##1| 和 |##2| 访问
%             这些参数。
%
%             \meta{value} 通常是 \packagename{keyval} 宏包传入的
%             参数 |#1|。如果 \meta{value} 没有可选参数，
%             \meta{default arg.} 会被插入，以便向
%       \meta{subdefinition}.
%
% \item[0.21] |\lstKV@XOptArg|\oarg{default arg.}\marg{value}\meta{submacro}
%
%             与 |\lstKV@OptArg| 相同，但第三个参数 \meta{submacro}
%             已经是一个定义，而不是替换文本。
%
% \item[0.20] |\lstKV@CSTwoArg|\marg{value}\marg{subdefinition}
%
%                         \meta{value} 是一个由一个或两个参数组成的逗号分隔列表。
%             它们被传给子定义，该子定义是
%             带两个参数的宏的替换文本。如有必要会补上空的第二个
%             参数。
% \end{syntax}
% \begin{advise}
% \item 再看一个例子。键 `\keyname{sensitive}' 属于方面
%             \aspectname{keywords}。因此它定义在
%             `|\lst@BeginAspect{keywords}|' 和 `|\lst@EndAspect|' 之间，这里没有
%             展示出来。
% \begin{verbatim}
%   \lst@Key{sensitive}\relax[t]{\lstKV@SetIf{#1}\lst@ifsensitive}
%   \lst@AddToHookExe{SetLanguage}{\let\lst@ifsensitive\iftrue}\end{verbatim}
%             最后一行等价于
% \begin{verbatim}
%   \lst@AddToHook{SetLanguage}{\let\lst@ifsensitive\iftrue}
%   \global\let\lst@ifsensitive\iftrue\end{verbatim}
%             我们全局初始化这个变量，因为用户可能在分组内
%             请求某个方面。此后该变量局部使用——\meta{\TeX\ material} 中
%             没有 |\global|。注意我们可以如下定义并
%             初始化该键：
% \begin{verbatim}
%   \lst@Key{sensitive}t[t]{\lstKV@SetIf{#1}\lst@ifsensitive}
%   \lst@AddToHook{SetLanguage}{\let\lst@ifsensitive\iftrue}\end{verbatim}
%\end{advise}
