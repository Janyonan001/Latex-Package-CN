% \begin{lstkey}{useoutput}
% \begin{macro}{\output}
% 另一个问题最初由 \lsthelper{Marcin~Kasperski}
% {1999/04/28}{listings 破坏目录}报告。它也与 catcode 有关，
% \lsthelper{Donald~Arseneau}{1999/05/13}{comp.text.tex 回复：延迟写与
% catcode 改动}让我理解了它。要点是：当 \TeX\ 把非 |\immediate| 的
% |\write| 写入文件时，它似乎使用\emph{当前}活动的 catcode 表，
% 而不是\emph{读入}字符时所涉及的 catcode。
% 因此，如果一个列表跨两页，节标题 |\L a| 会被写成 |\La|：
% 因为在把 |\La| 写入文件时使用了非标准的 catcode 表，
% 先前附着的 catcode 不起作用。还有一个缺陷是，当列表跨
% 两页时，页眉或页脚中的重音符号会丢失。
% \lsthelper{Denis~Girou}{1999/08/03}{列表跨两页时
% 页眉中的重音丢失}发现了后一个缺陷。与
% 波浪号类似的另一个问题由 \lsthelper{Thorsten~Vitt}{2001/06/25}{fancyhdr +
% listings 跨页 ==> 页眉中 ~ 而非空格}报告。
%
% 我们可以在三种可能性之间选择。
% \lsthelper{Donald~Arseneau}{2006/09/14}{cannot select output routine 1}
% 在这里的 |\ifcase| 参数中发现了一个缺陷。
%    \begin{macrocode}
\lst@Key{useoutput}{2}{\edef\lst@useoutput{\ifcase0#1 0\or 1\else 2\fi}}
%    \end{macrocode}
% 第一种不改动已有的输出例程。
%    \begin{macrocode}
\lst@AddToHook{Init}
{\edef\lst@OrgOutput{\the\output}%
\ifcase\lst@useoutput\relax
\or
%    \end{macrocode}
% 第二种可能性如下：我们中断当前模式——
% 特别是带修改过的 catcode 表的 |\lst@Pmode|——调用原始输出
% 例程，然后重新进入该模式。这必须小心处理。
% 首先我们必须关闭 \TeX\ 在输出例程开头
% 打开的分组。单个 |\egroup| 会给出`输出例程不平衡'
% 错误。但 |\expandafter\egroup| 有效。又是
% \lsthelper{Donald~Arseneau}{2001/01/10}{comp.text.tex Re: \output puzzle}
% 给出了解释：|\expandafter| 把 |\bgroup| 的记号类型设为
% |backed_up|，这阻止 \TeX 从输出例程不平衡的状态恢复。
% \lsthelper{Heiko~Oberdiek}{2001/01/05}{comp.text.tex 回复：
% \output 之谜}报告说 |\csname| |egroup||\endcsname| 也能
% 达到目的。
%
% 不过，由于我们关闭分组时 \TeX\ 会检查 |\box| 255 的内容
% （`output routine didn't use all of |\box| 255'），我们
% 必须临时保存它。
%    \begin{macrocode}
 \output{\global\setbox\lst@gtempboxa\box\@cclv
         \expandafter\egroup
%    \end{macrocode}
% 现在我们可以中断模式了，但我们必须保存当前字符串
% 和当前样式。
%    \begin{macrocode}
         \lst@SaveToken
     \lst@InterruptModes
%    \end{macrocode}
% 我们恢复内容，使用原始输出例程，然后\ldots
%    \begin{macrocode}
     \setbox\@cclv\box\lst@gtempboxa
     \bgroup\lst@OrgOutput\egroup
%    \end{macrocode}
% \ldots\ 打开一个与 \TeX\ 在输出例程末尾插入的 |}| 相匹配的分组。
% 我们重新进入模式，并用 |\aftergroup| 恢复字符串和
% 样式。此外我们需要重置 |\pagegoal|——这是在
% \lsthelper{Jochen~Schneider}{2002/03/09}{de.comp.text.tex：
% Listings 宏包 1.0-Beta 的问题；前面有浮动体时
% 无故分页}报告缺陷之后添加的。
%    \begin{macrocode}
     \bgroup
     \aftergroup\pagegoal\aftergroup\vsize
     \aftergroup\lst@ReenterModes\aftergroup\lst@RestoreToken}%
\else
%    \end{macrocode}
% 第三种选择是在修改过的输出例程内恢复所有 catcode 和含义，
% 然后再调用原始例程。
%    \begin{macrocode}
 \output{\lst@RestoreOrigCatcodes
         \lst@ifec \lst@RestoreOrigExtendedCatcodes \fi
         \lst@OrgOutput}%
\fi}
%    \end{macrocode}
% 注意这个输出例程不会经常被使用。只有在列表
% 可能跨两页时才执行它：列表在页面底部结束或
% 从页面顶部开始，或者列表确实被分割。
% \end{macro}
% \end{lstkey}
%
% \begin{macro}{\lst@GetChars}
% \begin{macro}{\lst@ScanChars}
% \begin{lstkey}{rescanchars}
% 为了让第三种 |\output| 选择工作，我们必须扫描 catcode
% 以及活动字符的含义：
%    \begin{macrocode}
\def\lst@GetChars#1#2#3{%
    \let#1\@empty
    \@tempcnta#2\relax \@tempcntb#3\relax
    \loop \ifnum\@tempcnta<\@tempcntb\relax
        \lst@lExtend#1{\expandafter\catcode\the\@tempcnta=}%
        \lst@lExtend#1{\the\catcode\@tempcnta\relax}%
        \ifnum\the\catcode\@tempcnta=\active
            \begingroup\lccode`\~=\@tempcnta
            \lowercase{\endgroup
            \lst@lExtend#1{\expandafter\let\expandafter~\csname
                                    lstecs@\the\@tempcnta\endcsname}%
            \expandafter\let\csname lstecs@\the\@tempcnta\endcsname~}%
        \fi
        \advance\@tempcnta\@ne
    \repeat}
%    \end{macrocode}
% \label{catcode12}根据 \lsthelper{Benjamin~Lings}{2004/10/15}%
% {\usepackage{xy,listings} 产生："Forbidden control sequence...."}的缺陷报告，我们
% 临时停用 |^^L| 的 |\outer| 定义（在 |\lst@ScanChars| 内部和外部）
% 并在宏包末尾通过 |\lst@RestoreCatcodes| 命令恢复
% catcode。
%    \begin{macrocode}
\begingroup \catcode12=\active\let^^L\@empty
\gdef\lst@ScanChars{%
  \let\lsts@ssL^^L%
  \def^^L{\par}%
    \lst@GetChars\lst@RestoreOrigCatcodes\@ne {128}%
  \let^^L\lsts@ssL
    \lst@GetChars\lst@RestoreOrigExtendedCatcodes{128}{256}}
\endgroup
%    \end{macrocode}
% 该扫描可以手工触发，也可以在文档开头触发。
%    \begin{macrocode}
\lst@Key{rescanchars}\relax{\lst@ScanChars}
\AtBeginDocument{\lst@ScanChars}
%    \end{macrocode}
% \end{lstkey}
% \end{macro}
% \end{macro}
