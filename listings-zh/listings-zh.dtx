% \begin{macro}{\lstFV@FancyVerbFormatLine}
% `@'终止 |\lst@FVConvert| 的参数。
% 此外 |\lst@ReenterModes| 和 |\lst@InterruptModes| 包围一些代码。
% 这确保我们在宏的开头和结尾处于相同的分组层级
% ——即使用户开始了但没有结束注释，也就是
% 有一个未关闭的分组。
% 此外我们使用 |\vtop| 并重置 |\lst@newlines| 以允许断行。
%    \begin{macrocode}
\gdef\lstFV@FancyVerbFormatLine#1{%
    \let\lst@arg\@empty \lst@FVConvert#1\@nil
    \global\lst@newlines\z@
    \vtop{\noindent\lst@parshape
          \lst@ReenterModes
          \lst@arg \lst@PrintToken\lst@EOLUpdate\lsthk@InitVarsBOL
          \lst@InterruptModes}}
%    \end{macrocode}
% |\vtop| 内的 |\lst@parshape| 源于 \lsthelper{Peter~Bartke}{1999/11/18}{fancyvrb 中的段首缩进错误}
% 的缺陷报告。
% |\leavevmode| 变成了 |\noindent|。
% \end{macro}
%
% \begin{lstkey}{fvcmdparams}
% \begin{lstkey}{morefvcmdparams}
% 这些键调整 |\lst@FVcmdparams|，后面的转换宏将用到它。
% 命令及其参数数目的基础集合
% 由 \lsthelper{Denis~Girou}{2002/05/31}{fvcmdparams 的初始化}提供。
%    \begin{macrocode}
\lst@Key{fvcmdparams}%
    {\overlay\@ne}%
    {\def\lst@FVcmdparams{,#1}}
\lst@Key{morefvcmdparams}\relax{\lst@lAddTo\lst@FVcmdparams{,#1}}
%    \end{macrocode}
% \end{lstkey}
% \end{lstkey}
%
% \begin{macro}{\lst@FVConvert}
% 我们进行转换或者\ldots
%    \begin{macrocode}
\gdef\lst@FVConvert{\@tempcnta\z@ \lst@FVConvertO@}%
\gdef\lst@FVConvertO@{%
    \ifcase\@tempcnta
        \expandafter\futurelet\expandafter\@let@token
        \expandafter\lst@FVConvert@@
    \else
%    \end{macrocode}
% \ldots\ 我们不经转换地追加参数，逐个参数地，
% 共 |\@tempcnta| 次。
%    \begin{macrocode}
        \expandafter\lst@FVConvertO@a
    \fi}
\gdef\lst@FVConvertO@a#1{%
    \lst@lAddTo\lst@arg{{#1}}\advance\@tempcnta\m@ne
    \lst@FVConvertO@}%
%    \end{macrocode}
% 由于 |\@ifnextchar\bgroup| 可能失败，我们这里必须使用 |\ifcat|。
% 缺陷由 \lsthelper{Denis~Girou}{1999/07/26}{fancyvrb=true 且`第二个
% 命令字符'不是 \{ 时无法工作}报告。
% 不过我们不像 |\@ifnextchar| 那样吞掉空格记号。
%    \begin{macrocode}
\gdef\lst@FVConvert@@{%
    \ifcat\noexpand\@let@token\bgroup \expandafter\lst@FVConvertArg
                                \else \expandafter\lst@FVConvert@ \fi}
%    \end{macrocode}
% 遇到这样的 catcode${}={}$1 字符时，我们转换该参数，并
% 连同分组定界符一起加到 |\lst@arg|。
% 我们还加入 |\lst@PrintToken|，它会在我们
% 忘记之前打印所有收集到的字符。
% 最后我们继续转换。
%    \begin{macrocode}
\gdef\lst@FVConvertArg#1{%
    {\let\lst@arg\@empty
     \lst@FVConvert#1\@nil
     \global\let\@gtempa\lst@arg}%
     \lst@lExtend\lst@arg{\expandafter{\@gtempa\lst@PrintToken}}%
     \lst@FVConvert}
%    \end{macrocode}
%    \begin{macrocode}
\gdef\lst@FVConvert@#1{%
    \ifx \@nil#1\else
       \if\relax\noexpand#1%
          \lst@lAddTo\lst@arg{\lst@OutputLostSpace\lst@PrintToken#1}%
       \else
          \lccode`\~=`#1\lowercase{\lst@lAddTo\lst@arg~}%
       \fi
       \expandafter\lst@FVConvert
    \fi}
%    \end{macrocode}
% 没有 |\bgroup| 时，我们查看是否已找到输入末尾，并
% 转换一个记号（（非）活动字符或控制序列）。
%    \begin{macrocode}
\gdef\lst@FVConvert@#1{%
    \ifx \@nil#1\else
       \if\relax\noexpand#1%
          \lst@lAddTo\lst@arg{\lst@OutputLostSpace\lst@PrintToken#1}%
%    \end{macrocode}
% 这里我们检查已注册的带参数命令，并按需
% 设置 |\@tempcnta| 的值。
%    \begin{macrocode}
          \def\lst@temp##1,#1##2,##3##4\relax{%
              \ifx##3\@empty \else \@tempcnta##2\relax \fi}%
          \expandafter\lst@temp\lst@FVcmdparams,#1\z@,\@empty\relax
       \else
          \lccode`\~=`#1\lowercase{\lst@lAddTo\lst@arg~}%
       \fi
       \expandafter\lst@FVConvertO@
    \fi}
%    \end{macrocode}
% \end{macro}
%
%    \begin{macrocode}
\lst@EndAspect
%</misc>
%    \end{macrocode}
% \end{aspect}
