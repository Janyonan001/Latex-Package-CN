% \begin{macro}{\lst@SaveDef}
% \begin{macro}{\lst@DefSaveDef}
% \begin{macro}{\lst@LetSaveDef}
% 这些宏可用于语言定义中做特殊改动。
% 它们保存定义，并定义或赋予新的定义。
%    \begin{macrocode}
\def\lst@SaveDef#1#2{%
    \begingroup \lccode`\~=#1\relax \lowercase{\endgroup\let#2~}}
\def\lst@DefSaveDef#1#2{%
    \begingroup \lccode`\~=#1\relax \lowercase{\endgroup\let#2~\def~}}
\def\lst@LetSaveDef#1#2{%
    \begingroup \lccode`\~=#1\relax \lowercase{\endgroup\let#2~\let~}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \end{macro}
%
% 现在来看更强大的定义。
%
% \begin{macro}{\lst@CDef}
% 这里我们展开第一个参数 \meta{1st}\marg{2nd}\marg{rest}，并说
% 这个输入字符串被`替换'为 \meta{save 1st}\marg{2nd}^^A
% \marg{rest}——外加 \meta{execute}、\meta{pre} 和 \meta{post}。这项主要
% 工作由 |\lst@CDefIt| 完成。
%    \begin{macrocode}
\def\lst@CDef#1{\lst@CDef@#1}
\def\lst@CDef@#1#2#3#4{\lst@CDefIt#1{#2}{#3}{#4#2#3}#4}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@CDefX}
% 丢弃输入字符串。
%    \begin{macrocode}
\def\lst@CDefX#1{\lst@CDefX@#1}
\def\lst@CDefX@#1#2#3{\lst@CDefIt#1{#2}{#3}{}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@CDefIt}
% 是前面几个宏的主工作过程。它重新定义字符
% 序列 |#1#2#3|。至少 |#1| 必须是活动的；另外两个
% 参数可能为空，但不是等价于空！
%    \begin{macrocode}
\def\lst@CDefIt#1#2#3#4#5#6#7#8{%
    \ifx\@empty#2\@empty
%    \end{macrocode}
% 对于单个字符，我们只按正确顺序执行这些参数。
% 你可能想回到第~\ref{dCharacterTablesManipulated} 节去
% 查阅它们。
%    \begin{macrocode}
        \def#1{#6\def\lst@next{#7#4#8}\lst@next}%
    \else \ifx\@empty#3\@empty
%    \end{macrocode}
% 对于两个字符的序列，我们测试是否必须执行 \meta{pre} 和 \meta{post}。
%    \begin{macrocode}
        \def#1##1{%
            #6%
            \ifx##1#2\def\lst@next{#7#4#8}\else
                     \def\lst@next{#5##1}\fi
            \lst@next}%
    \else
%    \end{macrocode}
% 对任意字符序列我们做同样的事——只是我们必须
% 使用 |\lst@IfNextCharsArg| 而不是 |\ifx|\ldots|\fi|。
%    \begin{macrocode}
        \def#1{%
            #6%
            \lst@IfNextCharsArg{#2#3}{#7#4#8}%
                                     {\expandafter#5\lst@eaten}}%
    \fi \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@CArgX}
% 我们把 |#1#2| 变成活动的，并调用 |\lst@CArg|。
%    \begin{macrocode}
\def\lst@CArgX#1#2\relax{%
    \lst@DefActive\lst@arg{#1#2}%
    \expandafter\lst@CArg\lst@arg\relax}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@CArg}
% 为 |\lst@CDef|[|X|] 安排前两个参数。我们得到一个未定义的
% 宏，并使用 |\@empty\@empty\relax| 作为子宏的定界符。
%    \begin{macrocode}
\def\lst@CArg#1#2\relax{%
    \lccode`\/=`#1\lowercase{\def\lst@temp{/}}%
    \lst@GetFreeMacro{lst@c\lst@temp}%
    \expandafter\lst@CArg@\lst@freemacro#1#2\@empty\@empty\relax}
%    \end{macrocode}
% 把 \meta{1st}=|#2| 的含义保存在 \meta{save 1st}=|#1| 中，并用正确的
% 参数调用宏 |#6|。从 1.0 版起，|#2|、|#3| 和 |#4|
% （或空参数）用分组花括号绑定在一起。
% 这允许我们在其他定义中保存两个参数，例如在
% |\lst@DefDelimB|.
%    \begin{macrocode}
\def\lst@CArg@#1#2#3#4\@empty#5\relax#6{%
    \let#1#2%
    \ifx\@empty#3\@empty
        \def\lst@next{#6{#2{}{}}}%
    \else
        \def\lst@next{#6{#2#3{#4}}}%
    \fi
    \lst@next #1}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@CArgEmpty}
% `执行'一个 |\@empty| 定界的参数。我们将把它用于定界符。
%    \begin{macrocode}
\def\lst@CArgEmpty#1\@empty{#1}
%    \end{macrocode}
% \end{macro}
%
%
% \subsection{定界符}
%
% 这里我们从所有定界符共有的通用定义开始。
%
% \begin{lstkey}{excludedelims}
% 控制哪些定界符不按 \meta{whatever}样式打印。我们只需
% 把 |\lst@ifex|\meta{whatever} 定义为真。这样的开关在
% \hookname{ExcludeDelims} 钩子中被置为假，并由各个
% 定界符处理。
%    \begin{macrocode}
\lst@Key{excludedelims}\relax
    {\lsthk@ExcludeDelims \lst@NormedDef\lst@temp{#1}%
     \expandafter\lst@for\lst@temp\do
     {\expandafter\let\csname\@lst @ifex##1\endcsname\iftrue}}
%    \end{macrocode}
% \end{lstkey}
%
% \begin{macro}{\lst@DelimPrint}
% 而这个宏可能有助于做到这一点。|#1| 是 |\lst@ifex|\meta{whatever}
% （外加 |\else|）或只是 |\iffalse|，而 |#2| 将是该定界符。
% 临时模式改动确保这些字符既不能结束当前
% 定界符，也不能开始新的定界符。
%    \begin{macrocode}
\def\lst@DelimPrint#1#2{%
    #1%
      \begingroup
        \lst@mode\lst@nomode \lst@modetrue
        #2\lst@XPrintToken
      \endgroup
      \lst@ResetToken
    \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@DelimOpen}
% 我们打印前面的字符和该定界符，进入合适的模式，
% 再次打印该定界符，并执行 |#3|。事实上，参数 |#1| 和
% |#2| 确保定界符只被打印一次。
%    \begin{macrocode}
\def\lst@DelimOpen#1#2#3#4#5#6\@empty{%
    \lst@TrackNewLines \lst@XPrintToken
    \lst@DelimPrint#1{#6}%
    \lst@EnterMode{#4}{\def\lst@currstyle#5}%
    \lst@DelimPrint{#1#2}{#6}%
    #3}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@DelimClose}
% 是顺序相反的同一件事。
%    \begin{macrocode}
\def\lst@DelimClose#1#2#3\@empty{%
    \lst@TrackNewLines \lst@XPrintToken
    \lst@DelimPrint{#1#2}{#3}%
    \lst@LeaveMode
    \lst@DelimPrint{#1}{#3}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@BeginDelim}
% \begin{macro}{\lst@EndDelim}
% 这些定义是 |\lst@DelimOpen| 和 |\lst@DelimClose| 的应用：
% 定界符与被定界的文本样式相同。
%    \begin{macrocode}
\def\lst@BeginDelim{\lst@DelimOpen\iffalse\else{}}
\def\lst@EndDelim{\lst@DelimClose\iffalse\else}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\lst@BeginIDelim}
% \begin{macro}{\lst@EndIDelim}
% 另一个应用：不打印定界符。
%    \begin{macrocode}
\def\lst@BeginIDelim{\lst@DelimOpen\iffalse{}{}}
\def\lst@EndIDelim{\lst@DelimClose\iffalse{}}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\lst@DefDelims}
% 这个宏定义所有定界符，因此每次选择语言时
% 都被重置。
%    \begin{macrocode}
\lst@AddToHook{SelectCharTable}{\lst@DefDelims}
\lst@AddToHookExe{SetLanguage}{\let\lst@DefDelims\@empty}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@Delim}
% 我们先设默认值：无 |\lst@modetrue|、累积样式，且
% |\lst@Delim|[|DM|]|@|\meta{type} 不带参数。
%    \begin{macrocode}
\def\lst@Delim#1{%
    \lst@false \let\lst@cumulative\@empty \let\lst@arg\@empty
%    \end{macrocode}
% 这些是双星形式（double-star-form）的正确设置，所以这种情况下我们
% 立即调用子宏。否则我们或者只是抑制累积
% 样式，或者甚至用 |\lst@true| 表明使用了 |\lst@modetrue|。
%    \begin{macrocode}
    \@ifstar{\@ifstar{\lst@Delim@{#1}}%
                     {\let\lst@cumulative\relax
                      \lst@Delim@{#1}}}%
            {\lst@true\lst@Delim@{#1}}}
%    \end{macrocode}
% 类型参数被保存以备后用。我们以 |#1| 为默认值
% 与可选的 \meta{style} 参数比较，定义 |\lst@delimstyle|，
% 并查找可选的 \meta{type option}，它只是被保存在 |\lst@arg| 中。
%    \begin{macrocode}
\def\lst@Delim@#1[#2]{%
    \gdef\lst@delimtype{#2}%
    \@ifnextchar[\lst@Delim@sty
                 {\lst@Delim@sty[#1]}}
\def\lst@Delim@sty[#1]{%
    \def\lst@delimstyle{#1}%
    \ifx\@empty#1\@empty\else
        \lst@Delim@sty@ #1\@nil
    \fi
    \@ifnextchar[\lst@Delim@option
                 \lst@Delim@delim}
\def\lst@Delim@option[#1]{\def\lst@arg{[#1]}\lst@Delim@delim}
%    \end{macrocode}
% 上面替换文本中的 |[| 和 |]| 是在
% \lsthelper{Stephen~Reindl}{2002/05/28}{使用 Cobol 时无法使用}报告缺陷之后添加的。
%
% |\lst@delimstyle| 的定义取决于第一个记号是否为
% 控制序列。这里我们可能构造 |\lst@|\meta{style}。
%    \begin{macrocode}
\def\lst@Delim@sty@#1#2\@nil{%
    \if\relax\noexpand#1\else
        \edef\lst@delimstyle{\expandafter\noexpand
                             \csname\@lst @\lst@delimstyle\endcsname}%
    \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@Delim@delim}
% 最终调用这个宏。首先我们可能需要删除一批
% 定界符。如果没有定界符，我们可能删除一个子类。
%    \begin{macrocode}
\def\lst@Delim@delim#1\relax#2#3#4#5#6#7#8{%
    \ifx #4\@empty \lst@Delim@delall{#2}\fi
    \ifx\@empty#1\@empty
        \ifx #4\@nil
            \@ifundefined{\@lst @#2DM@\lst@delimtype}%
                {\lst@Delim@delall{#2@\lst@delimtype}}%
                {\lst@Delim@delall{#2DM@\lst@delimtype}}%
        \fi
    \else
%    \end{macrocode}
% 如果定界符不为空，我们就转换它并追加到
% |\lst@arg|。|\lst@Begin|\ldots、|\lst@End|\ldots，以及样式和
% 模式选择同理。
%    \begin{macrocode}
        \expandafter\lst@Delim@args\expandafter
            {\lst@delimtype}{#1}{#5}#6{#7}{#8}#4%
%    \end{macrocode}
% 如果类型已知，我们或者选择动态模式或者选择静态模式，并把
% |\lst@arg| 的内容用作参数。所有这些都被放入 |\lst@delim|。
%    \begin{macrocode}
        \let\lst@delim\@empty
        \expandafter\lst@IfOneOf\lst@delimtype\relax#3%
        {\@ifundefined{\@lst @#2DM@\lst@delimtype}%
             {\lst@lExtend\lst@delim{\csname\@lst @#2@\lst@delimtype
                                     \expandafter\endcsname\lst@arg}}%
             {\lst@lExtend\lst@delim{\expandafter\lst@UseDynamicMode
                                     \csname\@lst @#2DM@\lst@delimtype
                                     \expandafter\endcsname\lst@arg}}%
%    \end{macrocode}
% 现在，根据模式 |#4|，我们或者删除这个特定定界符，
% 或者把它追加到当前所有定界符。
%    \begin{macrocode}
         \ifx #4\@nil
             \let\lst@temp\lst@DefDelims \let\lst@DefDelims\@empty
             \expandafter\lst@Delim@del\lst@temp\@empty\@nil\@nil\@nil
         \else
             \lst@lExtend\lst@DefDelims\lst@delim
         \fi}%
%    \end{macrocode}
% 未知类型会引发错误。
%    \begin{macrocode}
        {\PackageError{Listings}{Illegal type `\lst@delimtype'}%
                                {#2 types are #3.}}%
     \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@Delim@args}
% 现在我们看看如何把参数加入 |\lst@arg|。首先我们初始化
% 转换，只为让所有字符变活动。但如果类型的第一个字符
% 等于 |#4|，\ldots
%    \begin{macrocode}
\def\lst@Delim@args#1#2#3#4#5#6#7{%
    \begingroup
    \lst@false \let\lst@next\lst@XConvert
%    \end{macrocode}
% \ldots\ 我们从 |\lst@delimtype| 中删除该字符，而 |#5| 可能选择
% 不同的转换设置或宏。
%    \begin{macrocode}
    \@ifnextchar #4{\xdef\lst@delimtype{\expandafter\@gobble
                                        \lst@delimtype}%
                    #5\lst@next#2\@nil
                    \lst@lAddTo\lst@arg{\@empty#6}%
                    \lst@GobbleNil}%
%    \end{macrocode}
% 由于我们处在上面`特殊'的情况，我们还把特殊的
% |\lst@Begin|\ldots\ 和 |\lst@End|\ldots\ 宏加入了 |\lst@arg|
% （以及作为定界符刹车的 |\@empty|）。如果字符不相等，
% 就不需要做任何特殊处理。
%    \begin{macrocode}
                   {\lst@next#2\@nil
                    \lst@lAddTo\lst@arg{\@empty#3}%
                    \lst@GobbleNil}%
                 #1\@nil
%    \end{macrocode}
% 我们总是把参数转移到分组之外，并当且仅当我们不是在删除
% 定界符时追加样式和模式选择。
% 为此我们展开定界符样式。
%    \begin{macrocode}
    \global\let\@gtempa\lst@arg
    \endgroup
    \let\lst@arg\@gtempa
    \ifx #7\@nil\else
        \expandafter\lst@Delim@args@\expandafter{\lst@delimstyle}%
    \fi}
%    \end{macrocode}
% 回想样式是由 |\def\lst@currstyle#5| `选定'的，而这个
% `参数' |#5| 现在要被加入。根据开头的
% 设置，我们或者使用 |{\meta{style}}\lst@modetrue|——它选定
% 样式并停用关键词检测——，或者使用 |{}\meta{style}|——它
% 定义一个空样式宏并执行累积样式的样式——，
% 或者使用 |{\meta{style}|——它只定义样式宏。注意我们必须
% 在下面额外使用两个分组层级：一个由 |\lst@lAddTo| 直接丢弃，
% 另一个由 |\lst@Delim|[|DM|]|@|\meta{type} 丢弃。
%    \begin{macrocode}
\def\lst@Delim@args@#1{%
    \lst@if
        \lst@lAddTo\lst@arg{{{#1}\lst@modetrue}}%
    \else
        \ifx\lst@cumulative\@empty
            \lst@lAddTo\lst@arg{{{}#1}}%
        \else
            \lst@lAddTo\lst@arg{{{#1}}}%
        \fi
    \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@Delim@del}
% 为了删除某个特定定界符，我们沿定界符列表向下迭代，
% 把当前项与用户提供的那一个比较。
%    \begin{macrocode}
\def\lst@Delim@del#1\@empty#2#3#4{%
    \ifx #2\@nil\else
        \def\lst@temp{#1\@empty#2#3}%
        \ifx\lst@temp\lst@delim\else
            \lst@lAddTo\lst@DefDelims{#1\@empty#2#3{#4}}%
        \fi
        \expandafter\lst@Delim@del
    \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@Delim@delall}
% 为了删除整类定界符，我们首先展开控制序列
% 名，初始化其他数据，并调用一个子宏来做这项工作。
%    \begin{macrocode}
\def\lst@Delim@delall#1{%
    \begingroup
    \edef\lst@delim{\expandafter\string\csname\@lst @#1\endcsname}%
    \lst@false \global\let\@gtempa\@empty
    \expandafter\lst@Delim@delall@\lst@DefDelims\@empty
    \endgroup
    \let\lst@DefDelims\@gtempa}
%    \end{macrocode}
% 我们首先丢弃前面的 |\lst@UseDynamicMode|。
%    \begin{macrocode}
\def\lst@Delim@delall@#1{%
    \ifx #1\@empty\else
        \ifx #1\lst@UseDynamicMode
            \lst@true
            \let\lst@next\lst@Delim@delall@do
        \else
            \def\lst@next{\lst@Delim@delall@do#1}%
        \fi
        \expandafter\lst@next
    \fi}
%    \end{macrocode}
% 然后我们就可以检查（后面的）|\lst@|\meta{delimiter name}\ldots\
% 是否与 |\lst@delim| 给出的定界符类匹配。
%    \begin{macrocode}
\def\lst@Delim@delall@do#1#2\@empty#3#4#5{%
    \expandafter\lst@IfSubstring\expandafter{\lst@delim}{\string#1}%
      {}%
      {\lst@if \lst@AddTo\@gtempa\lst@UseDynamicMode \fi
       \lst@AddTo\@gtempa{#1#2\@empty#3#4{#5}}}%
    \lst@false \lst@Delim@delall@}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@DefDelimB}
% 这里我们把参数拼在一起，以适应 |\lst@CDef|。注意传给
% |\lst@CDef| 的最后一个参数 |\@empty| 是 |\lst@CArgEmpty|
% 和 |\lst@DelimOpen| 的刹车。
%    \begin{macrocode}
\gdef\lst@DefDelimB#1#2#3#4#5#6#7#8{%
    \lst@CDef{#1}#2%
        {#3}%
        {\let\lst@bnext\lst@CArgEmpty
         \lst@ifmode #4\else
             #5%
             \def\lst@bnext{#6{#7}{#8}}%
         \fi
         \lst@bnext}%
        \@empty}
%    \end{macrocode}
% 在 \lsthelper{Vespe~Savikko}{2000/11/06}{同时加载 HTML 和 Python 时
% doc-string 输出异常}报告缺陷之后，我在 |#7| 周围加了花括号。
% \end{macro}
%
% \begin{macro}{\lst@DefDelimE}
% 第 5 行的 |\ifnum #7=\lst@mode| 确保各定界符
% 彼此匹配。
%    \begin{macrocode}
\gdef\lst@DefDelimE#1#2#3#4#5#6#7{%
    \lst@CDef{#1}#2%
        {#3}%
        {\let\lst@enext\lst@CArgEmpty
         \ifnum #7=\lst@mode%
             #4%
             \let\lst@enext#6%
         \else
             #5%
         \fi
         \lst@enext}%
        \@empty}
%    \end{macrocode}
%    \begin{macrocode}
\lst@AddToHook{Init}{\let\lst@bnext\relax \let\lst@enext\relax}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@DefDelimBE}
% 这个服务宏将实际定义所有字符串定界符。
%    \begin{macrocode}
\gdef\lst@DefDelimBE#1#2#3#4#5#6#7#8#9{%
    \lst@CDef{#1}#2%
        {#3}%
        {\let\lst@bnext\lst@CArgEmpty
         \ifnum #7=\lst@mode
             #4%
             \let\lst@bnext#9%
         \else
             \lst@ifmode\else
                 #5%
                 \def\lst@bnext{#6{#7}{#8}}%
             \fi
         \fi
         \lst@bnext}%
        \@empty}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@delimtypes}
% 是通用定界符类型的列表。
%    \begin{macrocode}
\gdef\lst@delimtypes{s,l}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@DelimKey}
% 我们只是把用于 |\lst@Delim| 的参数拼起来。
%    \begin{macrocode}
\gdef\lst@DelimKey#1#2{%
    \lst@Delim{}#2\relax
        {Delim}\lst@delimtypes #1%
                {\lst@BeginDelim\lst@EndDelim}
        i\@empty{\lst@BeginIDelim\lst@EndIDelim}}
%    \end{macrocode}
% \end{macro}
%
% \begin{lstkey}{delim}
% \begin{lstkey}{moredelim}
% \begin{lstkey}{deletedelim}
% 都使用 |\lst@DelimKey|。
%    \begin{macrocode}
\lst@Key{delim}\relax{\lst@DelimKey\@empty{#1}}
\lst@Key{moredelim}\relax{\lst@DelimKey\relax{#1}}
\lst@Key{deletedelim}\relax{\lst@DelimKey\@nil{#1}}
%    \end{macrocode}
% \end{lstkey}
% \end{lstkey}
% \end{lstkey}
%
% \begin{macro}{\lst@DelimDM@l}
% \begin{macro}{\lst@DelimDM@s}
% 这里没什么特别的。
%    \begin{macrocode}
\gdef\lst@DelimDM@l#1#2\@empty#3#4#5{%
    \lst@CArg #2\relax\lst@DefDelimB{}{}{}#3{#1}{#5\lst@Lmodetrue}}
%    \end{macrocode}
%    \begin{macrocode}
\gdef\lst@DelimDM@s#1#2#3\@empty#4#5#6{%
    \lst@CArg #2\relax\lst@DefDelimB{}{}{}#4{#1}{#6}%
    \lst@CArg #3\relax\lst@DefDelimE{}{}{}#5{#1}}
%    \end{macrocode}
%    \begin{macrocode}
%</kernel>
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
%
% \subsubsection{字符串}
%
% \begin{aspect}{strings}
% 只是开始一个新的方面。
%    \begin{macrocode}
%<*misc>
\lst@BeginAspect{strings}
