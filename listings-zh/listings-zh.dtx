% \subsection{内部模式}\label{dInternalModes}
%
% 你大概知道 \TeX 的条件命令 |\ifhmode|、|\ifvmode|、
% |\ifmmode| 和 |\ifinner|。它们告诉你 \TeX\ 处于（受限）
% 水平或（内部）垂直或（非显示）数学模式。例如，
% |\ifhmode| 为真且 |\ifinner| 为真表示受限水平
% 模式，也就是说你在一个 |\hbox| 里。典型用户不关心
% 这些模式；\TeX/\LaTeX\ 会管理这一切。但既然你在读
% 开发者指南，我们现在就来讨论 \packagename{listings}
% 宏包的类似机制。它用模式来区分注释与字符串、`注释
% 行'与`单行注释'，等等。
%
% 宏包在读入源代码之前处于`无模式'。在
% 初始化阶段它进入`处理模式'。此后模式取决于
% 实际的源代码。例如，考虑下面的行
% \begin{verbatim}
%    "string" // comment\end{verbatim}
% 并假定 \texttt{language=C++}。读到字符串定界符时，宏包
% 进入`字符串模式'并处理该字符串。匹配的结束定界符
% 离开该模式，即切回通用的`处理模式'。遇到
% 这两个斜杠时，宏包检测到注释行；因此它进入
% `注释行模式'并输出这些斜杠。通常这个模式持续到
% 行尾。
%
% 但在 \texttt{textcl=true} 时，\aspectname{escape} 方面会立即
% 离开`注释行模式'，中断当前模式序列，并进入
% `\TeX\ 注释行模式'。在行尾我们重新进入先前的模式
% 序列`无模式' $\to$ `处理模式'。这个到 \LaTeX 的转义可以
% 工作，因为`无模式'意味着 \TeX 的字符和 catcode 在场，
% 而`处理模式'意味着 \packagename{listings} 的字符和
% catcode 处于活动状态。
%
% \begin{table}[htbp]
% \caption{内部模式}\label{dDefinedInternalModes}
% \def\lsttabspace{\hspace*{1em}\hfill}
% \begin{tabular}{@{}lp{0.56\linewidth}@{}}
% 方面\lsttabspace\meta{模式名} & 用途/我们正在处理……\\
% \noalign{\smallskip}
% 内核\lsttabspace |\lst@nomode| &
%             若该模式处于活动状态，\TeX 的`字符表'在场；反向
%             蕴含不成立。任何其他模式\emph{可能}意味着 catcode
%             和/或字符定义被改变。
% \\
%       \lsttabspace |\lst@Pmode| &
%             是一个通用处理模式。若处于活动状态，我们正在处理列表，
%             但尚未进入更特殊的模式。
% \\
%       \lsttabspace |\lst@GPmode| &
%             语言定义的通用模式。
% \\
% \aspectname{pod}\lsttabspace |\lst@PODmode| &
%             ……一个 POD——Perl 专用。
% \\
% \aspectname{escape}\lsttabspace |\lst@TeXLmode| &
%             ……一个注释行，但 \TeX 的字符表在场——除了
%             行尾字符，它用于终止该模式。
% \\
%       \lsttabspace |\lst@TeXmode| &
%             表示 \TeX 的字符表在场（除了一个用户
%             指定的字符，它用于终止该模式）。
% \\
% \aspectname{directives}\lsttabspace |\lst@CDmode| &
%             表示当前行以编译器指令开始。
% \\
% \aspectname{keywordcomments}\lsttabspace |\lst@KCmode| &
%             ……一个关键词注释。
% \\
%       \lsttabspace |\lst@KCSmode| &
%             ……一个只能由分号终止的关键词注释。
% \\
%   \aspectname{html}\lsttabspace |\lst@htmlmode| &
%             若我们处于 \texttt{<} 和 \texttt{>} 之间则为活动。
%
%             以前的文档在此处使用了模式名 |\lst@insidemode|，
%             但该名称没有被任何文档引用，因此从 v1.10c 起
%             被视为一处文档疏漏。
% \\
% \aspectname{make}\lsttabspace |\lst@makemode| &
%             用于表示一个关键词。
% \end{tabular}
% \end{table}
% 表~\ref{dDefinedInternalModes} 列出了所有静态模式及其
% 所属方面。大多数功能使用动态创建的模式号，
% 例如所有字符串和注释。每个方面只需在方面定义内
% 分配，即可定义自己的模式。
% \begin{syntax}
% \item[0.19] |\lst@NewMode|\meta{mode \textup(control sequence\textup)}
%
%             定义一个新的静态模式，即赋给
%             \meta{mode} 的一个非负整数。\meta{mode} 应有前缀 \texttt{lst@} 和
%             后缀 \texttt{mode}。
%
% \item[0.21] |\lst@UseDynamicMode|\marg{token\textup(s\textup)}
%
%             把一个动态模式号作为参数插入记号。
%
%             当方面被加载或定义时，不能用该宏取得模式号。
%             它只能在每个列表的初始化过程中使用，
%             例如在选出字符表时定义注释。
%
% \item[0.19,,changed] |\lst@EnterMode|\meta{mode}\marg{start tokens}
%
%             打开一个分组层次，进入该模式，并执行 \meta{start tokens}。
%
%             在 \meta{start tokens} 中使用 |\lst@modetrue| 可以禁止后续模式
%             改变——当然，离开模式除外。你必须自己测试
%             是否允许进入，见下文。
%
% \item[0.19] |\lst@LeaveMode|
%
%             当且仅当当前模式不是 |\lst@nomode| 时，通过关闭一个分组层次
%             返回先前的模式。你必须自己测试
%             是否允许离开某个模式，见下文。
%
%\iffalse
% \item[0.19] |\lst@LeaveAllModes|
%
%             返回到 |\lst@nomode|。
%             这算是一种应急宏，所以不要使用它！
%\fi
%
% \item[0.19] |\lst@InterruptModes|
% \item[0.19] |\lst@ReenterModes|
%
%             第一条命令返回到 |\lst@nomode|，但把当前模式
%             序列保存在一个特殊的栈上。之后第二个宏返回到
%             先前的模式。在这些命令之间，你可以进入任何想要的
%             模式。特别地，你可以中断模式、进入一些模式，再
%             说一次`中断模式'。那么两次重新进入会把你带回
%             第一次`中断模式'之前的位置。
%
%             记住 |\lst@nomode| 意味着 \TeX 的字符表
%             处于活动状态。
% \end{syntax}
% 有些变量显示处理的内部状态。你可以读取
% 它们，但\emph{禁止直接写入}。注意：|\lst@ifmode|
% 并\emph{没有}过时，因为该布尔值与当前模式之间没有关系。
% 会出现我们进入某个模式却没有把 |\lst@ifmode| 设为 true 的情况，
% 也会出现我们没有分配任何模式却把它设为 true 的情况！
% \begin{syntax}
% \item[0.18,,counter] |\lst@mode|
%
%             保存当前模式号。用 |\ifnum\lst@mode=|\meta{mode name}
%             来测试某个模式。不要直接修改这个计数器！
%
% \item[0.18,,boolean] |\lst@ifmode|
%
%             若该布尔值为 true，则不允许模式改变——离开当前模式
%             除外。用 |\lst@modetrue| 修改这个变量，但只在
%             \meta{start tokens} 中这样做。
%
% \item[1.0,,boolean] |\lst@ifLmode|
%
%             表示当前模式是否在行尾结束。
% \end{syntax}
%
