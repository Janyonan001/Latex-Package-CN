%         {\lstset{columns=flexible}
%         \sample}
%     \end{minipage}
%     \quad
%     \begin{minipage}[t]{\lstdocwidth}
%         \centering%
%         \texttt{fullflexible}\\
%         (at {\makeatletter\lst@widthflexible})\\
%         {\lstset{columns=fullflexible}
%         \sample}
%     \end{minipage}}
% \end{center}
% \begin{advise}
% \item 为什么女人比男人强？
%       \advisespace
%       你想进行哲学思考吗？好吧，我什么时候说过 女人比男人强' 这句话是真的？
%       我甚至不记得说过 女人是男人' \ldots . ^^A ;-)
%       关于“女人是男人”…… ^^A ;-)
% \end{advise}
% 概括来说：固定列格式破坏了字体设计师设计的间距，而灵活格式破坏了
% 程序员（可能）设计的列对齐。它们的共同点是输入字符被转换为一系列
% 基本输出单元，如
% \begingroup \lstset{gobble=6,xleftmargin=\leftmargini}
% \makeatletter
%^^A  Make \fbox around each output unit.
% \fboxsep=0pt
% \def\lst@alloverstyle#1{\fbox{\kern-\fboxrule\strut#1}\kern-\fboxrule}
% \begin{lstlisting}[basewidth=1em]
%     if x=y then write('align')
%            else print('align');
% \end{lstlisting}
% 现在，固定格式把 $n$ 个字符放进宽度为 $n\times{}$
% 的“基本宽度”盒子中，本例中的基本宽度为 {\makeatletter\lst@widthfixed}。
% 该格式会压缩或拉伸字符之间的空隙，
% 使其适应盒子。如例所示，某些字符串看起来像
%    \hbox to 2em{b\hss a\hss d}
% or
%    \hbox to 2em{w\hss o\hss r\hss s\hss e},
% 但输出是垂直对齐的。
% \endgroup
%
% 如果你不需要或不喜欢这种效果，就应当使用灵活格式。所有
% 字符都按其自然宽度排版。特别是它们绝不会
% 重叠。如果一个词需要的空间超过预留值，该行其余部分
% 就直接向右移动。三种格式的区别在于：
% 完全灵活格式不再关心其他任何因素，而普通灵活格式
% 和空格灵活格式则会设法在字符
% 串占用的空间少于“预留”空间时修正列对齐。普通灵活格式会在空格处、
% 标识符前后，以及其他字符序列前后插入补偿空隙
% 以修正对齐；
% 空格灵活格式则只通过拉伸
% 已有的空格来插入补偿空隙。在上面的灵活列示例中，两个 MEN 是垂直
% 对齐的，因为第四行中插入了空格以修正
% 对齐。而在完全灵活格式中，两个 MEN 并不对齐。
%
% 注意两种灵活模式都将第一行中的两个空格打印为单个空格，但原因不同：
% 普通灵活格式修正列对齐（空格灵活格式也是如此），而完全灵活格式
% 不关心第二个空格。
