% \subsection{行内列表}\label{iInlineListings}
%
% \subsubsection{处理行内列表}\label{uProcessingInline}
%
% \begin{macro}{\lstinline}
%         除 |\lsthk@PreSet| 之外，我们使用 |boxpos=b| 和
%         flexiblecolumns。我在 \lsthelper{Michael~Weber}
%         {1999/12/16}{列表环境中间距错误}的缺陷报告之后插入了 |\leavevmode|。
%         \lsthelper{Olivier~Lecarme}{2001/07/30}{在题注内使用 \lstinline 时
%         `break'行为不一致}报告了一个问题，
%         它在移除 |\let| |\lst@newlines| |\@empty| 之后消失（现在
%         |\lst@newlines| 是一个计数器！）。不幸的是我不知道
%         早些时候插入这段代码的原因！在宏末尾我们
%         检查定界符。\footnote{这是原作者
%         Carsten Heinz 的文字。}
%
%         然后是一个允许花括号的实验版本，但
%         \lsthelper{Luc~Van~Eycken}{2014/01/22}{\rcmdname\lstinline{} 在
%         对齐环境中}报告说，用花括号代替字符围绕源代码
%         的 |\lstinline| 实验性实现，在 tabular 环境中使用时
%         会导致错误。
%
%         他发现该错误来自 master counter（参见 TeXbook 附录
%         D（Dirty Tricks）第 5 项（Brace hacks）
%         （第 385-386 页））。在测试下一个字符之后（下面被注释掉的
%         片段中的第 7 行）加入下面这一行
%\begin{verbatim}
%\ifnum`{=0}\fi%
%\end{verbatim}
%         可修正错误行为。但 \lsthelper{Qing~Lee}{2014/06/28}{-}
%         指出这会破坏第~\ref{uListingsArguments} 节第~\pageref{uListingsArguments} 页
%         所示的那类代码，并
%         提出了另一种解决方案，而这又破坏了 Luc 提供的代码：
%\begin{verbatim}
% \renewcommand\lstinline[1][]{%
%   \leavevmode\bgroup % \hbox\bgroup --> \bgroup
%   \def\lst@boxpos{b}%
%   \lsthk@PreSet\lstset{flexiblecolumns,#1}%
%   \lsthk@TextStyle
%   \ifnum\iffalse{\fi`}=\z@\fi
%   \@ifnextchar\bgroup{%
%     \ifnum`{=\z@}\fi%
%     \afterassignment\lst@InlineG \let\@let@token}{%
%     \ifnum`{=\z@}\fi\lstinline@}%
%}
%\end{verbatim}
%         所以最后又回到了旧代码，那些需要带花括号的
%         |\lstinline| 的人应当使用第~\ref{uListingsArguments} 节
%         第~\pageref{uListingsArguments} 页的变通办法。
%
%         这个长期存在的缺陷现在由
%     \lsthelper{user5028841}{2024/05/05}{关于 listings 宏包}
%         修复，他提供了一个解决方案：用特殊字符作为分组的
%         开始和结束：
%    \begin{macrocode}
\edef\lst@temp{\the\catcode`\^^@}
\catcode`\^^@=1
\newcommand\lstinline[1][]{%
  \leavevmode\bgroup % \hbox\bgroup --> \bgroup
  \def\lst@boxpos{b}%
  \lsthk@PreSet\lstset{flexiblecolumns,#1}%
  \lsthk@TextStyle
  \@ifnextchar\bgroup{%
    \afterassignment\lst@InlineG \romannumeral`^^@\iffalse}\fi
  \let\@let@token}%
  \lstinline@}
%    \end{macrocode}
% 这里我们恢复 |\^^@| 先前的 catcode：
%    \begin{macrocode}
\catcode`\^^@=\lst@temp
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\lst@inline@}
%         这是处理 |\lstinline| 可选参数之后的
%         标准方法。
%    \begin{macrocode}
\def\lstinline@#1{%
  \lst@Init\relax
  \lst@IfNextCharActive{\lst@InlineM#1}{\lst@InlineJ#1}}
%    \end{macrocode}
%    \begin{macrocode}
\lst@AddToHook{TextStyle}{}% init
\lst@AddToHook{SelectCharTable}{\lst@inlinechars}
\global\let\lst@inlinechars\@empty
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@InlineM}
% \begin{macro}{\lst@InlineJ}
%         处理`普通'行内与参数内行内列表这两种
%         情况。第一种情况下给定字符结束行内
%         列表，这样的列表内的 EOL 立即结束它，并
%         产生错误消息。
%    \begin{macrocode}
\def\lst@InlineM#1{%
  \gdef\lst@inlinechars{%
    \lst@Def{`#1}{\lst@DeInit\egroup\global\let\lst@inlinechars\@empty}%
    \lst@Def{13}{\lst@DeInit\egroup \global\let\lst@inlinechars\@empty
      \PackageError{Listings}{lstinline ended by EOL}\@ehc}}%
  \lst@inlinechars}
%    \end{macrocode}
% 另一种情况下我们取得直到 |#1| 的所有字符，把这些字符
% 变成活动的，执行（排印）它们并结束列表（全部通过临时宏）。
% 这就是全部内容。
%    \begin{macrocode}
\def\lst@InlineJ#1{%
  \def\lst@temp##1#1{%
    \let\lst@arg\@empty \lst@InsideConvert{##1}\lst@arg
    \lst@DeInit\egroup}%
  \lst@temp}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{macro}{\lst@InlineG}
%     是实验性的。
%    \begin{macrocode}
\def\lst@InlineG{%
  \lst@Init\relax
  \lst@IfNextCharActive{\lst@InlineM\}}{%
    \let\lst@arg\@empty \lst@InlineGJ}}
%    \end{macrocode}
%     这是关闭分组的时点：
%    \begin{macrocode}
\edef\lst@temp{\the\catcode`\^^@}
\catcode`\^^@=2
\def\lst@InlineGJ{\futurelet\@let@token\lst@InlineGJTest}
\def\lst@InlineGJTest{%
  \ifx\@let@token\egroup
    \iffalse{\fi\romannumeral`^^@
      \afterassignment\lst@InlineGJEnd
      \expandafter\let\expandafter\@let@token
  \else
    \ifx\@let@token\@sptoken
      \let\lst@next\lst@InlineGJReadSp
    \else
      \let\lst@next\lst@InlineGJRead
    \fi
    \expandafter\lst@next
    \fi}
%    \end{macrocode}
%     同前：恢复 |\^^@| 先前的 catcode：
%    \begin{macrocode}
\catcode`\^^@=\lst@temp
\def\lst@InlineGJEnd{\lst@arg\lst@DeInit\egroup}
\def\lst@InlineGJRead#1{%
  \lccode`\~=`#1\lowercase{\lst@lAddTo\lst@arg~}%
  \lst@InlineGJ}
\def\lst@InlineGJReadSp#1{%
  \lccode`\~=`\ \lowercase{\lst@lAddTo\lst@arg~}%
  \lst@InlineGJ#1}
%    \end{macrocode}
% \end{macro}
%
%
% \subsubsection{短行内列表环境}
%
% 本节实现基于 \packagename{shortvrb} 宏包，它属于标准 \LaTeX\ 文档
% 宏包中 |doc.dtx| 的 2006/02/02 v2.1d 版。其中部分内容
% 的版权因此属于 The \LaTeX3 Project 1993--2006 以及 Frank
% Mittelbach 1989--1999。\lsthelper{Denis~Bitouz\'e}{2020/03/21}
% {错误消息中的错字}利用疫情危机查看了
% 错误消息，并发现了一些错字。
%
% \begin{macro}{\lstMakeShortInline}
% \begin{macro}{\lstMakeShortInline@}
% 首先，如果省略了可选参数，我们就提供一个。
%    \begin{macrocode}
\newcommand\lstMakeShortInline[1][]{%
  \def\lst@shortinlinedef{\lstinline[#1]}%
  \lstMakeShortInline@}%
\def\lstMakeShortInline@#1{%
  \expandafter\ifx\csname lst@ShortInlineOldCatcode\string#1\endcsname\relax
    \lst@shortlstinlineinfo{Made }{#1}%
    \lst@add@special{#1}%
%    \end{macrocode}
% 该字符的当前 catcode 被存到
% |\lst@ShortInlineOldCatcode\|\meta{c}.
%    \begin{macrocode}
    \expandafter
    \xdef\csname lst@ShortInlineOldCatcode\string#1\endcsname{%
      \the\catcode`#1}%
%    \end{macrocode}
% 该字符用与 |\verb|（例如）中相同的技巧拼进定义，
% 做法是在一个分组内激活 |~|。
%    \begin{macrocode}
    \begingroup
      \catcode`\~\active  \lccode`\~`#1%
      \lowercase{%
%    \end{macrocode}
% 该字符的旧含义被记录在
% |\lst@ShortInlineOldMeaning\|\meta{c} 中，然后才赋予新含义。
%    \begin{macrocode}
        \global\expandafter\let
          \csname lst@ShortInlineOldMeaning\string#1\endcsname~%
          \expandafter\gdef\expandafter~\expandafter{%
            \lst@shortinlinedef#1}}%
    \endgroup
%    \end{macrocode}
% 最后该字符被变成活动的。
%    \begin{macrocode}
    \global\catcode`#1\active
%    \end{macrocode}
% 如果我们怀疑 \meta{c} 已经是一个短引用，我们就提醒
% 用户。现在如果出了什么问题，他/她要自己负责\ldots
% （\packagename{listings} 中的改动：我们在此处给出恰当的错误。）
%    \begin{macrocode}
  \else
    \PackageError{Listings}%
    {\string\lstMakeShorterInline\ definitions cannot be nested}%
    {Use \string\lstDeleteShortInline first.}%
    {}%
  \fi}
%    \end{macrocode}
% \end{macro}
% \end{macro}
% \begin{macro}{\lstDeleteShortInline}
%    \begin{macrocode}
\def\lstDeleteShortInline#1{%
  \expandafter\ifx%
      \csname lst@ShortInlineOldCatcode\string#1\endcsname\relax%
    \PackageError{Listings}%
    {#1 is not a short reference for \string\lstinline}%
    {Use \string\lstMakeShortInline first.}%
    {}%
  \else
    \lst@shortlstinlineinfo{Deleted }{#1 as}%
    \lst@rem@special{#1}%
    \global\catcode`#1\csname lst@ShortInlineOldCatcode\string#1\endcsname
    \global \expandafter\let%
      \csname lst@ShortInlineOldCatcode\string#1\endcsname \relax
    \ifnum\catcode`#1=\active
      \begingroup
        \catcode`\~\active  \lccode`\~`#1%
        \lowercase{%
          \global\expandafter\let\expandafter~%
          \csname lst@ShortInlineOldMeaning\string#1\endcsname}%
      \endgroup
    \fi
  \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@shortlstinlineinfo}
%    \begin{macrocode}
\def\lst@shortlstinlineinfo#1#2{%
     \PackageInfo{Listings}{%
       #1\string#2 a short reference for \string\lstinline}}
%    \end{macrocode}
%  \end{macro}
%
% \begin{macro}{\lst@add@special}
% 这个辅助宏把它的参数加到 |\dospecials| 宏中，
% 后者按惯例被 verbatim 宏用来
% 改变当前活动字符的 catcode。我们需要
% 在 |\dospecials| 的展开中加入 |\do\|\meta{c}，且要先
% 把可能已存在的该字符移除，以避免在 |\lstMakeShortInline| 未被
% |\lstDeleteShortInline| 平衡时堆积多份副本
% （以防任何使用 |\dospecials| 的东西在意重复）。
%    \begin{macrocode}
\def\lst@add@special#1{%
  \lst@rem@special{#1}%
  \expandafter\gdef\expandafter\dospecials\expandafter
    {\dospecials \do #1}%
%    \end{macrocode}
% 同样我们必须把 |\@makeother\|\meta{c} 加到 |\@sanitize|
% （后者用于像"\index"这样的地方，对所有特殊
% 字符（花括号除外）重新设置 catcode）。
%    \begin{macrocode}
  \expandafter\gdef\expandafter\@sanitize\expandafter
    {\@sanitize \@makeother #1}}
%    \end{macrocode}
% \end{macro}
% \begin{macro}{\lst@rem@special}
% |\lst@add@special| 的反操作稍微更棘手。|\do| 被
% 重新定义为：如果其参数是所关心的字符则展开为空，
% 否则只展开为该参数。然后我们
% 重新定义 |\dospecials| 为其自身的展开。|=`##1| 之后的空格
% 可防止展开成 |\relax|！
%    \begin{macrocode}
\def\lst@rem@special#1{%
  \def\do##1{%
    \ifnum`#1=`##1 \else \noexpand\do\noexpand##1\fi}%
  \xdef\dospecials{\dospecials}%
%    \end{macrocode}
% 修正 |\@sanitize| 相同，只是我们需要重新定义
% |\@makeother|，这显然必须在分组内完成。
%    \begin{macrocode}
  \begingroup
    \def\@makeother##1{%
      \ifnum`#1=`##1 \else \noexpand\@makeother\noexpand##1\fi}%
    \xdef\@sanitize{\@sanitize}%
  \endgroup}
%    \end{macrocode}
% \end{macro}
%
%
% \subsection{input 命令}\label{iTheInputCommand}
%
% \begin{macro}{\lst@MakePath}
% \begin{lstkey}{inputpath}
% 如有必要，该宏在路径末尾追加一个斜杠。
%    \begin{macrocode}
\def\lst@MakePath#1{\ifx\@empty#1\@empty\else\lst@MakePath@#1/\@nil/\fi}
\def\lst@MakePath@#1/{#1/\lst@MakePath@@}
\def\lst@MakePath@@#1/{%
    \ifx\@nil#1\expandafter\@gobble
         \else \ifx\@empty#1\else #1/\fi \fi
    \lst@MakePath@@}
%    \end{macrocode}
% 现在我们可以清空路径，或使用 |\lst@MakePath|。
%    \begin{macrocode}
\lst@Key{inputpath}{}{\edef\lst@inputpath{\lst@MakePath{#1}}}
%    \end{macrocode}
% \end{lstkey}
% \end{macro}
%
% \begin{macro}{\lstinputlisting}
% 输入该列表，或向用户询问新的文件名。
%    \begin{macrocode}
\def\lstinputlisting{%
    \begingroup \lst@setcatcodes \lst@inputlisting}
\newcommand\lst@inputlisting[2][]{%
  \endgroup
%    \end{macrocode}
% |\lst@set| 取局部选项，特别是用于格式化输入文件的
% |inputpath=<path>|。所以必须更新 |\lstset| 以得到
% 正确的 |\lst@inputpath| 值。整个流程必须置于分组内以
% 使改动成为局部的。
%    \begin{macrocode}
  \bgroup\def\lst@set{#1}%
  \expandafter\lstset\expandafter{\lst@set}%
  \IfFileExists{\lst@inputpath#2}%
    {\lst@InputListing{\lst@inputpath#2}}%
    {\filename@parse{\lst@inputpath#2}%
      \edef\reserved@a{\noexpand\lst@MissingFileError
        {\filename@area\filename@base}%
        {\ifx\filename@ext\relax tex\else\filename@ext\fi}}%
      \reserved@a
%    \end{macrocode}
% 在不存在文件的（错误）情况下，我们必须为 |\lst@doendpe| 提供
% 有效值。
%    \begin{macrocode}
  \let\lst@doendpe\@empty}%
  \egroup
  \lst@doendpe \@newlistfalse \ignorespaces%
}
%    \end{macrocode}
% 我们使用 |\lst@doendpe| 去掉下一行开头的缩进
% ——除非 |\lstinputlisting| 之后有空行。缺陷
% 由 \lsthelper{David~John~Evans}{1999/06/08}{列表之后的
% 缩进}报告，\lsthelper{David~Carlisle}{1999/06/08}{LaTeX`显示
% 环境'代码}为我指出了解决方案。
% \end{macro}
%
% \begin{macro}{\lst@MissingFileError}
% 是 \LaTeX 的 |\@missingfileerror| 的派生版本。括号是
% 在 \lsthelper{Heiko~Oberdiek}{2003/01/14}{文件 `Makefile.tex' 未
% 找到}报告 TEX-D-L 上讨论的一个问题之后加入的。
%    \begin{macrocode}
\def\lst@MissingFileError#1#2{%
    \typeout{^^J! Package Listings Error: File `#1(.#2)' not found.^^J%
        ^^JType X to quit or <RETURN> to proceed,^^J%
        or enter new name. (Default extension: #2)^^J}%
    \message{Enter file name: }%
    {\endlinechar\m@ne \global\read\m@ne to\@gtempa}%
%    \end{macrocode}
% 输入 |x| 或 |X| 即退出。
%    \begin{macrocode}
    \ifx\@gtempa\@empty \else
        \def\reserved@a{x}\ifx\reserved@a\@gtempa\batchmode\@@end\fi
        \def\reserved@a{X}\ifx\reserved@a\@gtempa\batchmode\@@end\fi
%    \end{macrocode}
% 在其他所有情况下我们尝试新的文件名。
%    \begin{macrocode}
        \filename@parse\@gtempa
        \edef\filename@ext{%
            \ifx\filename@ext\relax#2\else\filename@ext\fi}%
        \edef\reserved@a{\noexpand\IfFileExists %
                {\filename@area\filename@base.\filename@ext}%
            {\noexpand\lst@InputListing %
                {\filename@area\filename@base.\filename@ext}}%
            {\noexpand\lst@MissingFileError
                {\filename@area\filename@base}{\filename@ext}}}%
        \expandafter\reserved@a %
    \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@ifdraft}
% 利用 |\lst@ifprint|。\lsthelper{Enrico~Straube}{2002/02/12}
% {de.comp.text.tex：listings 与 draft 模式}请求了最后一个选项。
%    \begin{macrocode}
\let\lst@ifdraft\iffalse
\DeclareOption{draft}{\let\lst@ifdraft\iftrue}
\DeclareOption{final}{\let\lst@ifdraft\iffalse}
\lst@AddToHook{PreSet}
    {\lst@ifdraft
         \let\lst@ifprint\iffalse
         \@gobbletwo\fi\fi
     \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@InputListing}
% 唯一的参数是文件名，但我们还有`隐式'
% 参数 |\lst@set|。注意 |\lst@Init| 以 |\relax| 为参数。
%    \begin{macrocode}
\def\lst@InputListing#1{%
    \begingroup
      \lsthk@PreSet \gdef\lst@intname{#1}%
      \expandafter\lstset\expandafter{\lst@set}%
      \lsthk@DisplayStyle
      \catcode\active=\active
      \lst@Init\relax \let\lst@gobble\z@
      \lst@SkipToFirst
      \lst@ifprint \def\lst@next{\input{#1}}%
             \else \let\lst@next\@empty \fi
      \lst@next
      \lst@DeInit
    \endgroup}
%    \end{macrocode}
% 行 |\catcode\active=\active| 把 CR 字符变成活动的，
% 这是在 \lsthelper{Rene~H.~Larsen}{2002/04/15}{lstinputlisting 与 texcl 冲突}
% 的缺陷报告之后添加的。
% \end{macro}
%
% \begin{macro}{\lst@SkipToFirst}
% 行尾字符或者处理列表，或者负责
% 丢弃直到第一个打印行的各行。
%    \begin{macrocode}
\def\lst@SkipToFirst{%
    \ifnum \lst@lineno<\lst@firstline
%    \end{macrocode}
% 我们丢弃输入并重新定义行尾字符。
%    \begin{macrocode}
        \lst@BeginDropInput\lst@Pmode
        \lst@Let{13}\lst@MSkipToFirst
        \lst@Let{10}\lst@MSkipToFirst
    \else
        \expandafter\lst@BOLGobble
    \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@MSkipToFirst}
% 我们只查看是要丢弃更多行，还是要离开该模式（该模式恢复
% |chr(13)| 和 |chr(10)| 的定义）。
%    \begin{macrocode}
\def\lst@MSkipToFirst{%
    \global\advance\lst@lineno\@ne
    \ifnum \lst@lineno=\lst@firstline
        \lst@LeaveMode \global\lst@newlines\z@
        \lsthk@InitVarsBOL
        \lst@DisplayConsecutiveNumbersOrNot
        \expandafter\lst@BOLGobble
    \fi}
%    \end{macrocode}
% \end{macro}
%
%
% \subsection{环境}
%
%
% \subsubsection{底层处理}
%
% \begin{macro}{\lstenv@DroppedWarning}
% 如果有字符被丢弃就发出警告。
%    \begin{macrocode}
\def\lstenv@DroppedWarning{%
    \ifx\lst@dropped\@undefined\else
        \PackageWarning{Listings}{Text dropped after begin of listing}%
    \fi}
\let\lst@dropped\@undefined % init
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@Process}
% 我们根据找到的是活动 EOL 还是非活动的 |^^J|，
% 执行`|\lstenv@ProcessM|'或 |\lstenv@ProcessJ|。
%    \begin{macrocode}
\begingroup \lccode`\~=`\^^M\lowercase{%
\gdef\lstenv@Process#1{%
    \ifx~#1%
%    \end{macrocode}
% 我们不额外定义 |\lstenv@ProcessM|，因为如果找到活动的 EOL，
% 就根本无事可做。
%    \begin{macrocode}
        \lstenv@DroppedWarning \let\lst@next\lst@SkipToFirst
    \else\ifx^^J#1%
        \lstenv@DroppedWarning \let\lst@next\lstenv@ProcessJ
    \else
        \let\lst@dropped#1\let\lst@next\lstenv@Process
    \fi \fi
    \lst@next}
}\endgroup
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@ProcessJ}
% 现在来了糟糕的情形：参数内的列表。我们在第~\ref{iApplicationsTo} 节
% 已为此做了工作。这里我们必须取得
% 直到`结束环境'的所有字符。我们区分`命令
% 形式'和`真正的环境'两种情况。
%    \begin{macrocode}
\def\lstenv@ProcessJ{%
    \let\lst@arg\@empty
    \ifx\@currenvir\lstenv@name
        \expandafter\lstenv@ProcessJEnv
    \else
%    \end{macrocode}
% 第一种情况很简单：代码由
% |\end|\meta{name of environment} 终止。于是我们展开该控制序列，
% 然后定义一个临时宏，由它取得列表并完成
% 其余工作。回到 |\lstenv@ProcessJ| 的定义，我们在展开 |\fi| 之后
% 调用该临时宏。
%    \begin{macrocode}
        \expandafter\def\expandafter\lst@temp\expandafter##1%
            \csname end\lstenv@name\endcsname
                {\lst@InsideConvert{##1}\lstenv@ProcessJ@}%
        \expandafter\lst@temp
    \fi}
%    \end{macrocode}
% 我们必须把一个活动的反斜杠和`结束字符串'追加到 |\lst@arg|。这样所有
% （事实上是大多数）其他处理都不会注意到代码曾经在
% 参数内。但现在 EOL 字符是 |chr(10)|=|^^J|，而不是 |chr(13)|。
%    \begin{macrocode}
\begingroup \lccode`\~=`\\\lowercase{%
\gdef\lstenv@ProcessJ@{%
    \lst@lExtend\lst@arg
        {\expandafter\ \expandafter~\lstenv@endstring}%
    \catcode10=\active \lst@Let{10}\lst@MProcessListing
%    \end{macrocode}
% 我们执行 |\lst@arg| 以排印该列表。
%    \begin{macrocode}
    \lst@SkipToFirst \lst@arg}
}\endgroup
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@ProcessJEnv}
% `真正的环境'情况更复杂。我们取得直到
% 一个 |\end| 及其后参数的所有字符。如果它等于 |\lstenv@name|，我们就
% 找到了环境末尾并开始排印。
%    \begin{macrocode}
\def\lstenv@ProcessJEnv#1\end#2{\def\lst@temp{#2}%
    \ifx\lstenv@name\lst@temp
        \lst@InsideConvert{#1}%
        \expandafter\lstenv@ProcessJ@
    \else
%    \end{macrocode}
% 否则我们把这些字符（包括被吞掉的 |\end| 和被吞掉的
% 参数）追加到当前 |\lst@arg|。然后我们再次查找环境末尾。
%    \begin{macrocode}
        \lst@InsideConvert{#1\\end\{#2\}}%
        \expandafter\lstenv@ProcessJEnv
    \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@backslash}
% 遇到反斜杠时，我们或者结束列表，或者处理一个反斜杠
% 并重新插入被吞掉的字符。
%    \begin{macrocode}
\def\lstenv@backslash{%
    \lst@IfNextChars\lstenv@endstring
        {\lstenv@End}%
        {\expandafter\lsts@backslash \lst@eaten}}%
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@End}
% 这个宏刚被使用过，并终止一个列表环境：
% 我们用 |\end| 或作为命令调用`结束环境'宏。
%    \begin{macrocode}
\def\lstenv@End{%
    \ifx\@currenvir\lstenv@name
        \edef\lst@next{\noexpand\end{\lstenv@name}}%
    \else
        \def\lst@next{\csname end\lstenv@name\endcsname}%
    \fi
    \lst@next}
%    \end{macrocode}
% \end{macro}
%
%
% \subsubsection{定义新环境}
%
% \begin{macro}{\lstnewenvironment}
% 现在来了主命令。我们只定义未定义的环境。关于
% 参数文本 |#1#2#|（特别是最后一个井号），见`The \TeX book'
% 第 204 页例 20.5 之后的段落。
%    \begin{macrocode}
\lst@UserCommand\lstnewenvironment#1#2#{%
    \@ifundefined{#1}%
        {\let\lst@arg\@empty
         \lst@XConvert{#1}\@nil
         \expandafter\lstnewenvironment@\lst@arg{#1}{#2}}%
        {\PackageError{Listings}{Environment `#1' already defined}\@eha
         \@gobbletwo}}
\def\@tempa#1#2#3{%
  \gdef\lstnewenvironment@##1##2##3##4##5{%
    \begingroup
%    \end{macrocode}
% 孤立的`结束环境'会产生错误。
%    \begin{macrocode}
    \global\@namedef{end##2}{\lstenv@Error{##2}}%
%    \end{macrocode}
% `主'环境宏为后续使用定义环境名，并
% 调用一个子宏来取得所有参数。我们打开一个分组并把 EOL 变成活动的。
% 这确保 |\@ifnextchar[| 不会读到列表的字符——它读到的是
% 活动的 EOL。
%    \begin{macrocode}
    \global\@namedef{##2}{\def\lstenv@name{##2}%
        \begingroup \lst@setcatcodes \catcode\active=\active
        \csname##2@\endcsname}%
%    \end{macrocode}
% 该子宏通过 |\new@command| 定义。我们误用 |\l@ngrel@x| 使
% 该定义成为 |\global|，并改进 \LaTeX 的 |\@xargdef|。
%    \begin{macrocode}
    \let\l@ngrel@x\global
%    \end{macrocode}
% 在 2025 年 11 月的 \LaTeX{} 内核中，上述技巧——做一个本应
% 是 |\long| 或 |\relax| 的命令却突然应用 |\global|——不再
% 有效，\url{https://tex.stackexchange.com/a/754359} 说明了原因。
% 下面这一行通过换成一个同样可疑的技巧来补救这个缺陷 :-)
%    \begin{macrocode}
    \let\pr@tectedrel@x\global
    \let\@xargdef\lstenv@xargdef
    \expandafter\new@command\csname##2@\endcsname##3%
%    \end{macrocode}
% 首先我们执行 |##4|=\meta{begin code}。然后定义
% 终止字符串（例如 |end{lstlisting}| 或 |endlstlisting|）：
%    \begin{macrocode}
        {\lsthk@PreSet ##4%
         \ifx\@currenvir\lstenv@name
             \def\lstenv@endstring{#1#2##1#3}%
         \else
             \def\lstenv@endstring{#1##1}%
         \fi
%    \end{macrocode}
% 我们（局部）重新定义`结束环境'，因为现在结束是合法的。
% 注意该重新定义在 \TeX\ 注释行内也有效。
%    \begin{macrocode}
         \@namedef{end##2}{\lst@DeInit ##5\endgroup
                          \lst@doendpe \@ignoretrue}%
%    \end{macrocode}
% |\lst@doendpe| 再次消除缩进问题。
%
% 最后我们开始处理。|\lst@EndProcessListing| 的赋值
% 被移到 |\lst@Init| 之前，这是在
% \lsthelper{Andreas~Deininger}{2002/11/11}{Compiling just stops}.
%    \begin{macrocode}
         \lsthk@DisplayStyle
         \let\lst@EndProcessListing\lstenv@SkipToEnd
         \lst@Init\lstenv@backslash
         \lst@ifprint
             \expandafter\expandafter\expandafter\lstenv@Process
         \else
             \expandafter\lstenv@SkipToEnd
         \fi
         \lst@insertargs}%
    \endgroup}%
}
\let\lst@arg\@empty \lst@XConvert{end}\{\}\@nil
\expandafter\@tempa\lst@arg
\let\lst@insertargs\@empty
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@xargdef}
% 这是 \LaTeX 的 |\@xargdef| 的派生版本。我们展开子宏的名字，
% 使用 |\gdef| 而不是 |\def|，并硬编码一种 |\@protected@testopt|。
%    \begin{macrocode}
\def\lstenv@xargdef#1{%
  \expandafter\lstenv@xargdef@\csname\string#1\endcsname#1}
\def\lstenv@xargdef@#1#2[#3][#4]#5{%
  \@ifdefinable#2{%
    \gdef#2{%
      \ifx\protect\@typeset@protect
          \expandafter\lstenv@testopt
      \else
          \@x@protect#2%
      \fi
      #1%
      {#4}}%
    \@yargdef%
    #1%
    \tw@%
    {#3}%
    {#5}}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@testopt}
% 这个宏与 |\@testopt| 的区别在于我们临时
% 重置 EOL 字符 |^^M| 的 catcode 以读取可选参数。
%    \begin{macrocode}
\long\def\lstenv@testopt#1#2{%
  \@ifnextchar[{\catcode\active5\relax \lstenv@testopt@#1}%
               {#1[{#2}]}}
\def\lstenv@testopt@#1[#2]{%
    \catcode\active\active
    #1[#2]}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@SkipToEnd}
% 我们使用临时定义
% \begin{itemize}\item[]
%    |\long\def\lst@temp##1\|\meta{content of \textup{\cs{lstenv@endstring}}}|{\lstenv@End}|
% \end{itemize}
% 它会吞掉直到环境末尾的所有字符并结束它。
%    \begin{macrocode}
\begingroup \lccode`\~=`\\\lowercase{%
\gdef\lstenv@SkipToEnd{%
    \long\expandafter\def\expandafter\lst@temp\expandafter##\expandafter
        1\expandafter~\lstenv@endstring{\lstenv@End}%
    \lst@temp}
}\endgroup
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstenv@Error}
% 由一个孤立的`结束环境'调用。
%    \begin{macrocode}
\def\lstenv@Error#1{\PackageError{Listings}{Extra \string\end#1}%
    {I'm ignoring this, since I wasn't doing a \csname#1\endcsname.}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@TestEOLChar}
% 这里我们测试两种可能的 EOL 字符。
%    \begin{macrocode}
\begingroup \lccode`\~=`\^^M\lowercase{%
\gdef\lst@TestEOLChar#1{%
    \def\lst@insertargs{#1}%
    \ifx ~#1\@empty \else
    \ifx^^J#1\@empty \else
        \global\let\lst@intname\lst@insertargs
        \let\lst@insertargs\@empty
    \fi \fi}
}\endgroup
%    \end{macrocode}
% \end{macro}
%
% \begin{environment}{lstlisting}
% 棘手的工作已完成，现在定义很容易。我们测试
% 用户是否给出了名字参数、设置各键，并处理
% 续接的行号。
%    \begin{macrocode}
\lstnewenvironment{lstlisting}[2][]{%
     \lst@TestEOLChar{#2}%
     \lstset{#1}%
     \csname\@lst @SetFirstNumber\endcsname%
   }{%
%    \end{macrocode}
% 正如 \lsthelper{Jean-Yves~Baudais}{2016/03/11}{一些
% 垂直间距问题}指出的，列表下方的垂直间距有问题。
% 当列表从 |\paragraph| 顶部或某个 |example| 环境
% 开头开始时，也会出现类似问题。Jean-Yves 提供了一个
% 解决方案——|\let\if@nobreak\iffalse|——如
% |fr.comp.text.tex| 上所讨论。原先的假设——如果列表开头
% 有上框线，或者由 |\leavevmode| 引入列表，问题就会消失——
% 是错误的，正如
% \lsthelper{Karl~Berry}{2018/10/26}{listings 1.7 \rcmdname\leavevmode -> 空行}和
% \lsthelper{Sven~Schreiber}{2018/10/23}{新版 listings 中行为改变}各自
% 独立报告的那样，所以提出的代码进入环境定义的
% 第二部分。\lsthelper{Enrico Gregorio}{2019/05/04}{这是
% listings 宏包的缺陷吗？}在
% \url{https://tex.stackexchange.com/questions/489121/is-it-a-listings-package-bug}
% 回答：先前的解决方案 |\let\if@nobreak\iffalse| 是错误的，因为它是
% 局部赋值，而需要的是全局设置。
%    \begin{macrocode}
     \@nobreakfalse
     \csname\@lst @SaveFirstNumber\endcsname%
   }
%    \end{macrocode}
%    \begin{macrocode}
%</kernel>
%    \end{macrocode}
% \end{environment}
