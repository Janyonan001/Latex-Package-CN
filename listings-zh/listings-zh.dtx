%
% 如果在参数内使用环境，列表已经被读入，
% 我们就无法保留 catcode。
% 不过，在某些情况下环境可以在参数
% 内使用——至少我在用户指南中是这样说的。
% 现在我得为让它成真而努力。
% 此外，我们为 \packagename{fancyvrb} 模式定义一个类似的转换宏。
% \begin{syntax}
% \item[0.19] |\lst@InsideConvert{|\meta{\TeX\ material \textup(already read\textup)}|}|
%
%             把参数的逐字版本\emph{追加}到 |\lst@arg|，但所有
%             追加的字符都是活动的。由于这不是字符到字符的
%             转换，`逐字'需要解释。所有字符都可以
%             原样输入，只有 |\|、|{|、|}| 和 |%| 例外。如果你想要其中
%             某一个，必须改写成 |\\|、|\{|、|\}| 和 |\%|。
%             如果两个空格要相邻，第二个（第三、第四、
%             \ldots）空格必须以带前置反斜杠的方式输入。
%
% \item[0.19] |\lst@XConvert{|\meta{\TeX\ material \textup(already read\textup)}|}|
%
%             把参数的`逐字'版本\emph{追加}到 |\lst@arg|。
%             这里允许把 \TeX\ 材料放进参数花括号中，例如
%       |{(*}{*)}|。这些参数的内容会被转换，花括号
%             保持为花括号。
%
%             如果 |\lst@if| 为真，每个第二参数会被区别对待。
%             只有（定界符的）第一个字符变成活动的。
% \end{syntax}
%
% \begin{macro}{\lst@InsideConvert}
% 如果 \texttt{mathescape} 未开启，我们就（在该定义接近末尾处）调用
% 一个类似 |\zap@space| 的子宏，把单个空格换成活动空格。
% 否则我们检查代码中是否含有一对 |$...$|，并调用
% 相应的宏。
%    \begin{macrocode}
\def\lst@InsideConvert#1{%
   \lst@ifmathescape
      \lst@InsideConvert@e#1$\@nil
      \lst@if
         \lst@InsideConvert@ey#1\@nil
      \else
         \lst@InsideConvert@#1 \@empty
         \expandafter\@gobbletwo
      \fi
      \expandafter\lst@next
   \else
      \lst@InsideConvert@#1 \@empty
   \fi}
\begingroup \lccode`\~=`\ \relax \lowercase{%
%    \end{macrocode}
% 我们把 |#1| 变成活动的，并把这些字符（外加一个活动空格）追加到
% |\lst@arg|.
% 如果没有找到输入的结束 |\@empty|，我们就继续处理。
%    \begin{macrocode}
\gdef\lst@InsideConvert@#1 #2{%
    \lst@MakeActive{#1}%
    \ifx\@empty#2%
        \lst@lExtend\lst@arg{\lst@temp}%
    \else
        \lst@lExtend\lst@arg{\lst@temp~}%
        \expandafter\lst@InsideConvert@
    \fi #2}
%    \end{macrocode}
% 最后我们结束 |\lowercase| 并关闭分组。
%    \begin{macrocode}
}\endgroup
%    \end{macrocode}
% 上面的下一个定义用于检查 |$...$|，再下一个
% 则阻止数学内容被转换。该功能由
% \lsthelper{Dr.~Jobst~Hoffmann}{}{}.
%    \begin{macrocode}
\def\lst@InsideConvert@e#1$#2\@nil{%
   \ifx\@empty#2\@empty \lst@false \else \lst@true \fi}
\def\lst@InsideConvert@ey#1$#2$#3\@nil{%
   \lst@InsideConvert@#1 \@empty
   \lst@lAddTo\lst@arg{%
      \lst@ifdropinput\else
         \lst@TrackNewLines\lst@OutputLostSpace \lst@XPrintToken
         \setbox\@tempboxa=\hbox\bgroup$\lst@escapebegin
         #2%
         \lst@escapeend$\egroup \lst@CalcLostSpaceAndOutput
         \lst@whitespacefalse
      \fi}%
   \def\lst@next{\lst@InsideConvert{#3}}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@XConvert}
% 检查参数\ldots
%    \begin{macrocode}
\def\lst@XConvert{\@ifnextchar\bgroup \lst@XConvertArg\lst@XConvert@}
%    \end{macrocode}
% \ldots，转换该参数，把它连同一对分组定界符加入
% |\lst@arg|，然后我们继续转换。
%    \begin{macrocode}
\def\lst@XConvertArg#1{%
    {\lst@false \let\lst@arg\@empty
     \lst@XConvert#1\@nil
     \global\let\@gtempa\lst@arg}%
    \lst@lExtend\lst@arg{\expandafter{\@gtempa}}%
    \lst@XConvertNext}
%    \end{macrocode}
% 若没有 |\bgroup|，我们就检查是否已找到输入的末尾，并
% 转换一个记号（（非）活动字符或控制序列），然后继续。
%    \begin{macrocode}
\def\lst@XConvert@#1{%
    \ifx\@nil#1\else
        \begingroup\lccode`\~=`#1\lowercase{\endgroup
        \lst@lAddTo\lst@arg~}%
        \expandafter\lst@XConvertNext
    \fi}
\def\lst@XConvertNext{%
    \lst@if \expandafter\lst@XConvertX
      \else \expandafter\lst@XConvert \fi}
%    \end{macrocode}
% 现在我们只让第一个字符变成活动的。
%    \begin{macrocode}
\def\lst@XConvertX#1{%
    \ifx\@nil#1\else
        \lst@XConvertX@#1\relax
        \expandafter\lst@XConvert
    \fi}
\def\lst@XConvertX@#1#2\relax{%
    \begingroup\lccode`\~=`#1\lowercase{\endgroup
    \lst@XCConvertX@@~}{#2}}
\def\lst@XCConvertX@@#1#2{\lst@lAddTo\lst@arg{{#1#2}}}
%    \end{macrocode}
% \end{macro}
