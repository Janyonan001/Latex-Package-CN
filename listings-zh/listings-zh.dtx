%
% \subsection{初始化与行尾}
%
% \begin{lstkey}{aboveskip}
% \begin{lstkey}{belowskip}
% 我们定义并初始化这些键，并为`行内'
% 列表防止多余间距（特别是当 \packagename{fancyvrb} 接口活动时，
% 问题由 \lsthelper{Denis~Girou}{1999/08/03}{间距错误}报告）。
%    \begin{macrocode}
\lst@Key{aboveskip}\medskipamount{\def\lst@aboveskip{#1}}
\lst@Key{belowskip}\medskipamount{\def\lst@belowskip{#1}}
\lst@AddToHook{TextStyle}
    {\let\lst@aboveskip\z@ \let\lst@belowskip\z@}
%    \end{macrocode}
% \end{lstkey}\end{lstkey}
%
% \begin{lstkey}{everydisplay}
% \begin{macro}{\lst@ifdisplaystyle}
% 有些东西取决于显示样式列表。
%    \begin{macrocode}
\lst@Key{everydisplay}{}{\def\lst@EveryDisplay{#1}}
\lst@AddToHook{TextStyle}{\let\lst@ifdisplaystyle\iffalse}
\lst@AddToHook{DisplayStyle}{\let\lst@ifdisplaystyle\iftrue}
\let\lst@ifdisplaystyle\iffalse
%    \end{macrocode}
% \end{macro}
% \end{lstkey}
%
% \begin{macro}{\lst@Init}
% 如有要求，开始浮动体或多栏环境。
%    \begin{macrocode}
\def\lst@Init#1{%
    \begingroup
    \ifx\lst@float\relax\else
        \edef\@tempa{\noexpand\lst@beginfloat{lstlisting}[\lst@float]}%
        \expandafter\@tempa
    \fi
    \ifx\lst@multicols\@empty\else
        \edef\lst@next{\noexpand\multicols{\lst@multicols}}
        \expandafter\lst@next
    \fi
%    \end{macrocode}
% 在受限的水平 \TeX\ 模式下我们切换到 |\lst@boxtrue|。
% 这种情况下我们在列表周围制作合适的盒子。
%    \begin{macrocode}
    \ifhmode\ifinner \lst@boxtrue \fi\fi
    \lst@ifbox
        \lsthk@BoxUnsafe
        \hbox to\z@\bgroup
             $\if t\lst@boxpos \vtop
        \else \if b\lst@boxpos \vbox
        \else \vcenter \fi\fi
        \bgroup \par\noindent
    \else
        \lst@ifdisplaystyle
            \lst@EveryDisplay
            \par\penalty-50\relax
            \vspace\lst@aboveskip
        \fi
    \fi
%    \end{macrocode} ^^A$ to make emacs font locking happy
% 把 |\vspace| 移到 |\par| 之后——否则列表顶部会出现空行。
% 缺陷由 \lsthelper{Jim~Hefferon}{1999/08/27}{使用
% |\lstinputlisting| 的列表前有空行}报告。
%
% 现在制作上题注。
%    \begin{macrocode}
    \normalbaselines
    \abovecaptionskip\lst@abovecaption\relax
    \belowcaptionskip\lst@belowcaption\relax
    \lst@MakeCaption t%
%    \end{macrocode}
% 一些初始化。
% 我在 \lsthelper{Jim~Hefferon}{1999/08/23}{lstlisting 之后的垂直间距错误}
% 的缺陷报告之后移除了 |\par\nointerlineskip| |\normalbaselines|。
% 他报告了与 Aidan Philip Heerdegen 相同的问题（见下），但我
%    \begin{macrocode}
    \lsthk@PreInit \lsthk@Init
    \lst@ifdisplaystyle
        \global\let\lst@ltxlabel\@empty
        \if@inlabel
            \lst@ifresetmargins
                \leavevmode
            \else
                \xdef\lst@ltxlabel{\the\everypar}%
                \lst@AddTo\lst@ltxlabel{%
                    \global\let\lst@ltxlabel\@empty
                    \everypar{\lsthk@EveryLine\lsthk@EveryPar}}%
            \fi
        \fi
        \everypar\expandafter{\lst@ltxlabel
                              \lsthk@EveryLine\lsthk@EveryPar}%
    \else
        \everypar{}\let\lst@NewLine\@empty
    \fi
    \lsthk@InitVars \lsthk@InitVarsBOL
%    \end{macrocode}
% 行尾字符 |chr(13)|=|^^M| 控制处理过程，见下面
% |\lst@MProcessListing| 的定义。
% 参数 |#1| 是 |\relax| 或 |\lstenv@backslash|。
%    \begin{macrocode}
    \lst@Let{13}\lst@MProcessListing
    \let\lst@Backslash#1%
    \lst@EnterMode{\lst@Pmode}{\lst@SelectCharTable}%
    \lst@InitFinalize}
%    \end{macrocode}
% 注意：从 0.19 版起，`列表处理'被实现为一个内部
% 模式，即具有特殊字符表的模式。因为有个缺陷报告
% \lsthelper{Fermin~Reig}{2002/09/04}{bad top frame inside figure+centering}
% |\rightskip| 及其他通过 \hookname{PreInit} 而不是通过
% \hookname{InitVars}.
%    \begin{macrocode}
\let\lst@InitFinalize\@empty % init
\lst@AddToHook{PreInit}
    {\rightskip\z@ \leftskip\z@ \parfillskip=\z@ plus 1fil
     \let\par\@@par}
\lst@AddToHook{EveryLine}{}% init
\lst@AddToHook{EveryPar}{}% init
%    \end{macrocode}
% \end{macro}
%
% \begin{lstkey}{showlines}
% 让用户控制列表末尾的空行是否
% 被打印。但如果你读过用户指南，这你是知道的。
%    \begin{macrocode}
\lst@Key{showlines}f[t]{\lstKV@SetIf{#1}\lst@ifshowlines}
%    \end{macrocode}
% \end{lstkey}
%
% \begin{macro}{\lst@DeInit}
% 输出剩余的字符并更新所有东西。起初我漏掉了
% 在这里使用 |\lst@ifdisplaystyle|，但后来 \lsthelper{KP~Gores}{2001/07/11}
% {每个 \lstinline 之后的 \csname{par}}报告了问题。
% |\everypar| 在 \lsthelper{Michael~Niedermair}{2002/05/14}{listings.sty 与 caption}
% 的缺陷报告之后被放到 |\lsthk@ExitVars| 后面，而
% 我在 \lsthelper{Georg~Rehm}
% {2002/05/14}{listings.sty 与长题注}的缺陷报告之后加入了 |\normalbaselines|，
% 并在 \lsthelper{Walter~E.~Brown}{2004/03/01}{列表底部的题注
% 继承了 basicstyle 的颜色}的报告之后加入了 |\normalcolor|。
%    \begin{macrocode}
\def\lst@DeInit{%
    \lst@XPrintToken \lst@EOLUpdate
    \global\advance\lst@newlines\m@ne
    \lst@ifshowlines
        \lst@DoNewLines
    \else
        \setbox\@tempboxa\vbox{\lst@DoNewLines}%
    \fi
    \lst@ifdisplaystyle \par\removelastskip \fi
    \lsthk@ExitVars\everypar{}\lsthk@DeInit\normalbaselines\normalcolor
%    \end{macrocode}
% 放置下题注。
%    \begin{macrocode}
    \lst@MakeCaption b%
%    \end{macrocode}
% 必要时关闭盒子，并绘制一条线以取得正确的宽度。
% 我在收到 \lsthelper{Aidan~Philip~Heerdegen}
% {1999/07/23}{垂直间距错误}的缺陷报告之后加入了 |\par\nointerlineskip|（后来又
% 移除了 |\nointerlineskip|）。|\everypar{}| 则源于
% \lsthelper{Sonja~Weidmann}{2000/02/01}{listings 与 caption 宏包
% 不兼容}的缺陷报告。
%    \begin{macrocode}
    \lst@ifbox
        \egroup $\hss \egroup
        \vrule\@width\lst@maxwidth\@height\z@\@depth\z@
    \else
        \lst@ifdisplaystyle
            \par\penalty-50\vspace\lst@belowskip
        \fi
    \fi
%    \end{macrocode}
% 必要时结束多栏环境和/或浮动体。
%    \begin{macrocode}
    \ifx\lst@multicols\@empty\else
        \def\lst@next{\global\let\@checkend\@gobble
                      \endmulticols
                      \global\let\@checkend\lst@@checkend}
        \expandafter\lst@next
    \fi
    \ifx\lst@float\relax\else
        \expandafter\lst@endfloat
    \fi
    \endgroup}
\let\lst@@checkend\@checkend
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@maxwidth}
% 将被分配、初始化并更新。
%    \begin{macrocode}
\newdimen\lst@maxwidth % \global
\lst@AddToHook{InitVars}{\global\lst@maxwidth\z@}
\lst@AddToHook{InitVarsEOL}
    {\ifdim\lst@currlwidth>\lst@maxwidth
         \global\lst@maxwidth\lst@currlwidth
     \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@EOLUpdate}
% 你觉得这个宏做什么？
%    \begin{macrocode}
\def\lst@EOLUpdate{\lsthk@EOL \lsthk@InitVarsEOL}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@MProcessListing}
% 这是我们在处理列表时行尾必须做的事。
% 我们输出所有剩余字符并更新变量。
% 如果已到达最后一行，我们就检查是否还有下一个行
% 区间要输入。
%    \begin{macrocode}
\def\lst@MProcessListing{%
  \lst@XPrintToken \lst@EOLUpdate \lsthk@InitVarsBOL
  \global\advance\lst@lineno\@ne
  \ifnum \lst@lineno>\lst@lastline
      \lst@ifdropinput \lst@LeaveMode \fi
      \ifx\lst@linerange\@empty
          \expandafter\expandafter\expandafter\lst@EndProcessListing
      \else
          \lst@interrange
          \lst@GetLineInterval
          \expandafter\expandafter\expandafter\lst@SkipToFirst
      \fi
  \else
      \expandafter\lst@BOLGobble
  \fi}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lst@EndProcessListing}
% 默认定义是 |\endinput|。
% 这适用于 |\lstinputlisting|。
%    \begin{macrocode}
\let\lst@EndProcessListing\endinput
%    \end{macrocode}
% \end{macro}
%
% \begin{lstkey}{gobble}
% 该键设置每行要吞掉的字符数。
%    \begin{macrocode}
\lst@Key{gobble}{0}{\def\lst@gobble{#1}}
%    \end{macrocode}
% \end{lstkey}
%
% \begin{macro}{\lst@BOLGobble}
% 如果数目为正，我们就设置一个临时计数器并开始循环。
%    \begin{macrocode}
\def\lst@BOLGobble{%
    \ifnum\lst@gobble>\z@
        \@tempcnta\lst@gobble\relax
        \expandafter\lst@BOLGobble@
	\fi}
%    \end{macrocode}
% 非正数终止循环（通过不继续）。
% 注意：这不是 |\lst@BOLGobble| 中刚用到的那个宏。
%    \begin{macrocode}
\def\lst@BOLGobble@@{%
    \ifnum\@tempcnta>\z@
        \expandafter\lst@BOLGobble@
    \fi}
%    \end{macrocode}
% 如果我们吞掉一个反斜杠，就必须查看这个反斜杠是否结束
% 一个环境。至于随后的字符是否等于例如~|end{lstlisting}|，
% 我们或者结束环境，或者把刚吞掉的所有字符插到
% `继续循环'宏之后。
%    \begin{macrocode}
\def\lstenv@BOLGobble@@{%
    \lst@IfNextChars\lstenv@endstring{\lstenv@End}%
    {\advance\@tempcnta\m@ne \expandafter\lst@BOLGobble@@\lst@eaten}}
%    \end{macrocode}
% 现在来了循环：如果读到 |\relax|、EOL 或 FF，下一个操作
% 就是完全相同的记号。注意对 FF（以及下面的制表符）我们测试
% 一个含 |\lst@ProcessFormFeed| 的宏。这是一个缺陷，由
% \lsthelper{Heiko~Oberdiek}{2002/04/16}{Re: first experience ...}.
%    \begin{macrocode}
\def\lst@BOLGobble@#1{%
    \let\lst@next#1%
    \ifx \lst@next\relax\else
    \ifx \lst@next\lst@MProcessListing\else
    \ifx \lst@next\lst@processformfeed\else
%    \end{macrocode}
% 否则我们使用两个子宏之一。
%    \begin{macrocode}
    \ifx \lst@next\lstenv@backslash
        \let\lst@next\lstenv@BOLGobble@@
    \else
        \let\lst@next\lst@BOLGobble@@
%    \end{macrocode}
% 现在我们真正吞掉字符。制表符把临时计数器
% 减去 |\lst@tabsize|（并在必要时处理剩余量），\ldots
%    \begin{macrocode}
        \ifx #1\lst@processtabulator
            \advance\@tempcnta-\lst@tabsize\relax
            \ifnum\@tempcnta<\z@
                \lst@length-\@tempcnta \lst@PreGotoTabStop
            \fi
%    \end{macrocode}
% \ldots\ 而任何其他字符把计数器减一。
%    \begin{macrocode}
        \else
            \advance\@tempcnta\m@ne
        \fi
    \fi \fi \fi \fi
    \lst@next}
%    \end{macrocode}
%    \begin{macrocode}
\def\lst@processformfeed{\lst@ProcessFormFeed}
\def\lst@processtabulator{\lst@ProcessTabulator}
%    \end{macrocode}
% \end{macro}
%
%
% \subsection{列表清单}%
% \label{sec:list-listings}
%
% \begin{lstkey}{name}
% \begin{macro}{\lstname}
% \begin{macro}{\lst@name}
% \begin{macro}{\lst@intname}
% 每个美化排版命令在设置任何键之前都给 |\lst@intname| 赋值。
%    \begin{macrocode}
\lst@Key{name}\relax{\def\lst@intname{#1}}
\lst@AddToHookExe{PreSet}{\global\let\lst@intname\@empty}
\lst@AddToHook{PreInit}{%
    \let\lst@arg\lst@intname \lst@ReplaceIn\lst@arg\lst@filenamerpl
    \global\let\lst@name\lst@arg \global\let\lstname\lst@name}
%    \end{macrocode}
% 使用 |\lst@ReplaceIn| 消除了一个缺陷，它最初由
% \lsthelper{Magne~Rudshaug}{1998/01/09}{下划线与列表清单}。
% 这里是替换列表。
%    \begin{macrocode}
\def\lst@filenamerpl{_\textunderscore $\textdollar -\textendash}
%    \end{macrocode} ^^A $
% \end{macro}
% \end{macro}
% \end{macro}
% \end{lstkey}
%
% \begin{macro}{\l@lstlisting}
% 打印一行`lol'。
%    \begin{macrocode}
\def\l@lstlisting#1#2{\@dottedtocline{1}{1.5em}{2.3em}{#1}{#2}}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstlistlistingname}
% 只包含标题名。
%    \begin{macrocode}
\lst@UserCommand\lstlistlistingname{Listings}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\lstlistoflistings}
% 我们做局部调整并调用 |\tableofcontents|。这样，
% 对该宏的重新定义（例如内部不带任何 |\MakeUppercase|）
% 也会对列表清单生效。
%    \begin{macrocode}
\lst@UserCommand\lstlistoflistings{\bgroup
    \let\contentsname\lstlistlistingname
    \let\lst@temp\@starttoc
    \def\@starttoc##1{\lst@temp{\ext@lstlisting}}%
    \tableofcontents \egroup}
%    \end{macrocode}
% 对于 \packagename{KOMA}-script 类，我们按 \packagename{KOMA} 的方式定义它，
% 这要感谢
% \lsthelper{Tino~Langer}{2003/11/01}{koma-script 的 listsleft 选项不影响
% lol}的缺陷报告。\lsthelper{Markus~Kohm}{2006/08/12}{koma-script 支持
% 已损坏}提出了一个大大改进的版本，它也能与
% \packagename{float} 宏包一起工作。下面几行注释来自 Markus。
%
% 如果定义了 |\float@listhead|（例如使用 float），就利用它
%    \begin{macrocode}
\@ifundefined{float@listhead}{}{%
  \renewcommand*{\lstlistoflistings}{%
    \begingroup
%    \end{macrocode}
% 如果存在用于切换的开关，就切换到单栏模式。
%    \begin{macrocode}
      \@ifundefined{@restonecoltrue}{}{%
        \if@twocolumn
          \@restonecoltrue\onecolumn
        \else
          \@restonecolfalse
        \fi
      }%
      \float@listhead{\lstlistlistingname}%
%    \end{macrocode}
% 把 |\parskip| 设为 0pt（应当如此！）、|\parindent| 设为 0pt（更好但不总是
% 需要）、|\parfillskip| 设为 0pt plus 1fil（应当如此！）。
%    \begin{macrocode}
      \parskip\z@\parindent\z@\parfillskip \z@ \@plus 1fil%
      \@starttoc{\ext@lstlisting}%
%    \end{macrocode}
% 切回双栏（见上）。
%    \begin{macrocode}
      \@ifundefined{@restonecoltrue}{}{%
        \if@restonecol\twocolumn\fi
      }%
    \endgroup
  }%
}
%    \end{macrocode}
% 如果加载了 tocbasic 宏包就利用它：
%    \begin{macrocode}
\AtBeginDocument{%
  \@ifpackageloaded{tocbasic}{%
    \addtotoclist[float]{\ext@lstlisting}%
    \renewcommand*{\lstlistoflistings}{\listoftoc[{\lstlistlistingname}]{lol}}%
    \DeclareTOCStyleEntry[level=1,numwidth=2.3em,indent=1.5em]{default}{lstlisting}%
  }{}%
}
