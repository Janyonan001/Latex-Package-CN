% \paragraph{空格}
% 按本小节开头所述实现。但首先
% 我们定义一些用户键。
%
% \begin{macro}{\lst@outputspace}
% \begin{macro}{\lst@visiblespace}
%         \lsthelper{Denis Bitouz\'e}{2020/09/12}{`lst@visiblespace：
%         `verbvisiblespace 而非 `textvisiblespace}指出：
%         在 Lua\LaTeX{} 和某些在 32 号槽位没有合适字形的等宽字体
%         下，使用 |\textvisiblespace| 时 `showspaces' 完全没有效果。
%         所以现在我们使用 |\verbvisiblespace| 作为第一个宏的默认
%         定义，针对字体族的测试
%         |\lst@ttfamily| 被删除，因为在大多数情况下它导致
%         |\char32| 的错误输出。latex.ltx 中 |\verbvisible| 的定义
%         考虑了现代 \TeX{} 引擎的不同行为，并定义了有效的 |\verbvisiblespace|
%    \begin{macrocode}
\def\lst@outputspace{\ }
\def\lst@visiblespace{\verbvisiblespace}
%    \end{macrocode}
% \end{macro}
% \end{macro}
%
% \begin{lstkey}{showspaces}
% \begin{lstkey}{keepspaces}
% \ldots\ 它会按用户要求被修改。
%    \begin{macrocode}
\lst@Key{showspaces}{false}[t]{\lstKV@SetIf{#1}\lst@ifshowspaces}
\lst@Key{keepspaces}{false}[t]{\lstKV@SetIf{#1}\lst@ifkeepspaces}
\lst@AddToHook{Init}
    {\lst@ifshowspaces
         \let\lst@outputspace\lst@visiblespace
         \lst@keepspacestrue
     \fi}
\def\lst@keepspacestrue{\let\lst@ifkeepspaces\iftrue}
%    \end{macrocode}
% \end{lstkey}
% \end{lstkey}
%
% \begin{macro}{\lst@ProcessSpace}
% 我们检查空格是否修正列对齐。在后一种情况下
% 我们追加一个空格；否则\ldots
% \lsthelper{Andrei~Alexandrescu}{2007/02/27}{-}测试了 |spaceflexible|
% 列设置，并发现了一个缺陷，它源于 |\lst@PrintToken| 与
% |\lst@whitespacetrue| 在这里的执行顺序颠倒。
%    \begin{macrocode}
\def\lst@ProcessSpace{%
    \lst@ifkeepspaces
        \lst@PrintToken
        \lst@whitespacetrue
        \lst@AppendOther\lst@outputspace
        \lst@PrintToken
    \else \ifnum\lst@newlines=\z@
%    \end{macrocode}
% \ldots\ 如果该行非空，我们就追加一个`特殊空格'。
%    \begin{macrocode}
        \lst@AppendSpecialSpace
    \else \ifnum\lst@length=\z@
%    \end{macrocode}
% 如果该行是空的，我们就检查输出队列中
% 是否有字符。如果没有字符，我们只推进 |\lst@lostspace|。
% 否则我们追加该空格。
%    \begin{macrocode}
            \global\advance\lst@lostspace\lst@width
            \global\advance\lst@pos\m@ne
            \lst@whitespacetrue
        \else
            \lst@AppendSpecialSpace
        \fi
    \fi \fi}
%    \end{macrocode}
% 注意这一版本对固定和灵活列输出都能工作。
% \end{macro}
%
% \begin{macro}{\lst@AppendSpecialSpace}
% 如果至少有两个空白，我们就输出前面的字符并
% 推进 |\lst@lostspace| 以避免对齐问题。否则我们
% 把空格追加到当前字符串。另外，|\lst@whitespacetrue| 已
% 被移到 |\lst@PrintToken| 之后，以便记号打印器能正确
% 检查它打印的是否是空白；这一点以前妨碍了
% |spaceflexible| 列设置正确工作。
%    \begin{macrocode}
\def\lst@AppendSpecialSpace{%
    \lst@ifwhitespace
        \lst@PrintToken
        \global\advance\lst@lostspace\lst@width
        \global\advance\lst@pos\m@ne
        \lst@gobbledwhitespacetrue
    \else
        \lst@PrintToken
        \lst@whitespacetrue
        \lst@AppendOther\lst@outputspace
        \lst@PrintToken
    \fi}
%    \end{macrocode}
% \end{macro}
