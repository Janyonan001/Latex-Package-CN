% \begin{macro}{\lst@setcatcodes}
% 包含 |\lstset| 的所有 catcode 改动。等号是在
% \lsthelper{Bekir~Karaoglu}{2003/09/16}{带 [turkish] 的
% {babel} 时的 keyval 问题}报告缺陷之后添加的——babel 的活动等号与 keyval 的
% 用法冲突。|\catcode`\"=12\relax| 是在
% \lsthelper{Heiko~Bauke}{2004/06/27}{listings 与 ngerman}报告缺陷之后移除的
% ——但愿这不会引入其他缺陷。
%    \begin{macrocode}
\def\lst@setcatcodes{\makeatletter \catcode`\==12\relax}
%    \end{macrocode}
