%
% \subsection{通用宏}\label{dGeneralPurposeMacros}
%
% \begin{syntax}
%   \item[0.19] |\lst@AddTo|\meta{macro}\marg{\TeX~material}
%
%         全局地把 \meta{\TeX~material} 加到 \meta{macro} 的内容中。
%
%   \item[0.20] |\lst@Extend|\meta{macro}\marg{\TeX~material}
%
%         在 \meta{\TeX~material} 的第一个记号被
%         |\expand| 之|后|调用 |\lst@AddTo|。例如，|\lst@Extend \a \b| 合并
%         两个宏的内容，并把它全局存到 |\a| 中。
%
%   \item[0.19] |\lst@lAddTo|\meta{macro}\marg{\TeX~material}
%   \item[0.20] |\lst@lExtend|\meta{macro}\marg{\TeX~material}
%
%         是 |\lst@AddTo| 和 |\lst@Extend| 的局部版本。
%
%     \item[0.18] |\lst@DeleteKeysIn|\meta{macro}\meta{macro \textup(要删除的键
%         \textup)}
%
%         两个宏都包含逗号分隔的键（或关键词）列表。第二个宏中
%         出现的所有键都会（局部地）从
%         第一个宏中删除。
%
%     \item[0.19] |\lst@ReplaceIn|\meta{macro}\meta{macro \textup(含
%     replacement list\textup)}
%   \item[0.20] |\lst@ReplaceInArg|\meta{macro}\marg{replacement list}
%
%         替换列表的形式为
%         $a_1b_1$\ldots$a_nb_n$，其中每个 $a_i$ 和
%         $b_i$ 都是字符序列（必要时用花括号括起），
%         可以包含宏，但 $b_i$ 的第一个记号
%         不能等价于 |\@empty|。第一个宏内的每个序列
%         $a_i$ 都会被（局部地）替换为
%         $b_i$。后缀 |Arg| 指带花括号的\emph{第二参数}，
%         而不是（不带花括号的）宏。这提示我们取得的是`真正的'
%         参数，而不是指向参数的`指针'。
%
%     \item[0.20] |\lst@IfSubstring|\marg{字符
%     sequence}\meta{macro}\marg{then}\marg{else}
%
%         如果 \meta{character sequence} 是 \meta{macro} 内容的子串，
%         就执行 \meta{then}。否则调用 \meta{else}。
%
%     \item[0.12] |\lst@IfOneOf|\meta{字符
%     sequence}|\relax|\meta{macro}\marg{then}\marg{else}
%
%         这里 |\relax| 终止第一个参数，因为这样比把它
%         括在花括号里更快。\meta{macro} 包含逗号分隔的
%         标识符列表。如果字符序列是这些
%         标识符之一，就执行 \meta{then}，否则执行 \meta{else}。
%
%   \item[0.21] |\lst@Swap|\marg{tok1}\marg{tok2}
%
%         交换后面两个记号或参数的位置
%         \emph{不}插入花括号。例如，|\lst@Swap{abc}{def}|
%         展开为 |defabc|。
%
%   \item[0.18] |\lst@IfNextChars|\meta{macro}\marg{then}\marg{else}
%     \item[0.19] |\lst@IfNextCharsArg|\marg{字符
%         序列}\marg{then}\marg{else}
%
%         两个宏都根据（在三个参数之后）是否找到给定的字符
%         序列或给定宏的内容，来执行 \meta{then} 或 \meta{else}。
%         注意这些宏与 \LaTeX 的 |\@ifnextchar| 的一个重要
%         区别：我们去除参数后面的字符，直到能够
%         判定必须执行哪一部分。不过，我们把这些字符
%         保存在宏 |\lst@eaten| 中，因此可以通过 \meta{then}
%         或 \meta{else} 把它们插回。
%
%   \item[0.19] |\lst@IfNextCharActive|\marg{then}\marg{else}
%
%         若下一个字符是活动的，就执行 \meta{then}，
%         否则执行 \meta{else}。
%
%   \item[0.20] |\lst@DefActive|\meta{macro}\marg{character sequence}
%
%         把字符序列存入 \meta{macro}，但所有字符
%         都变成活动的。该字符串\emph{不得}包含开始分组、结束
%         分组或转义字符（|{}\|）；它可以包含含义不同（即 catcode 不同）的左花括号、右
%         花括号或反斜杠。如果 \meta{character sequence} 尚未被 \TeX 读入，
%         这条命令就完全是多余的，因为这样的 catcode 很容易
%         改动。这里明确允许字符已被读入，例如在
%     |\def\test{\lst@DefActive\temp{ABC}}|!
%
%         注意该宏会改变 |\lccode| 的 0--9 项而不恢复它们。
%
%   \item[0.20] |\lst@DefOther|\meta{macro}\marg{character sequence}
%
%         把 \meta{character sequence} 存入 \meta{macro}，但所有字符
%         的 catcode 都是 12。此外所有空格被移除，控制
%         序列被转换为其名称（不带前置
%         反斜杠）。例如，|\{ Chip \}| 得到 |{Chip}|，其中所有
%         catcode 都是 12——内部使用了原语 |\meaning|。
%
%     \iffalse
%   \item[0.19] |\lst@MakeActive|\marg{character sequence}
%
%         把字符序列存入 |\lst@arg|，限制条件与 |\lst@DefActive|
%         相同。事实上，后者的定义就使用了
%         这里的这个宏。  \fi
% \end{syntax}
%
%
% \subsection{字符表的操作}
%
% \begin{syntax}
%   \item[0.20] |\lst@SaveDef|\marg{character code}\meta{macro}
%
%         把指定字符的当前定义保存在
%         \meta{macro} 中。在重新定义某个字符之前，你应当总是先保存它的
%         定义！并使用保存的版本，而不是直接写
%         |\lst@Process|\ldots——该字符可能已经被
%         重新定义，因此不再等价于它的标准定义。
%
%     \item[0.20] |\lst@DefSaveDef|\marg{字符
%         码}\meta{macro}\meta{parameter text}\marg{definition}
%     \item[0.20] |\lst@LetSaveDef|\marg{字符
%         码}\meta{macro}\meta{token}
%
%         分别把 |\lst@SaveDef| 与 |\lst@Def| 或 |\lst@Let| 结合。
% \end{syntax}
% 当然，我不该忘记说明\emph{在哪里}修改字符
% 表。在 \hookname{SelectCharTable} 处的钩子材料做出永久改动，
% 即影响所有语言。下面两个键可用于任何
% 语言定义，并且只影响该特定语言。
% \begin{syntax}
% \item[0.20] |SelectCharTable=|\meta{\TeX\ code}
% \item[0.20] |MoreSelectCharTable=|\meta{\TeX\ code}
%
%             （额外）使用 \meta{\TeX\ code} 来选择字符表。
%             该代码在标准字符表选出之后执行，
%             但可能在其他方面做出更多改动之前执行。由于先前的
%             含义总是被保存并在新定义内执行，这
%             应该无害。
% \end{syntax}
% 下面是两个相当无用的例子。如果语言 |useless| 处于活动状态，
% 每个句点都会在终端和 |.log| 文件中
% 产生一条消息 `|.|'：
% \begin{verbatim}
%   \lstdefinelanguage{useless}
%       {SelectCharTable=\lst@DefSaveDef{46}% save chr(46) ...
%            \lsts@point             % ... in \lsts@point and ...
%            {\message{.}\lsts@point}% ... use new definition
%       }\end{verbatim}
% 如果你想数点数，可以这样写
% \begin{verbatim}
%   \newcount\lst@points % \global
%   \lst@AddToHook{Init}{\global\lst@points\z@}
%   \lst@AddToHook{DeInit}{\message{Number of points: \the\lst@points}}
%   \lstdefinelanguage[2]{useless}
%       {SelectCharTable=\lst@DefSaveDef{46}\lsts@point
%            {\global\advance\lst@points\@ne \lsts@point}
%       }\end{verbatim}
% |% \global| 表示所分配的计数器被全局使用。我们在每个
% 列表开头把计数器清零，在列表末尾显示
% 当前值的消息，每个处理过的句点都让
% 计数器加一。
%
% \begin{syntax}
%   \item[0.21] |\lst@CArg|\meta{active characters}|\relax|\meta{macro}
%
%         活动字符的字符串被分割为 \meta{1st}、\meta{2nd}
%         和 \marg{rest}。如果某一项不存在，就使用
%         空参数。然后调用 \meta{macro}，参数为
%         |{|\meta{1st}\meta{2nd}\marg{rest}|}|，外加一个尚未定义的控制
%         序列 \meta{save 1st}。该宏意在保存 \meta{1st} 的当前
%         定义，这样 \meta{1st} 就可以在不丢失信息的情况下
%         被重新定义。
%
%   \item[0.19] |\lst@CArgX|\meta{characters}|\relax|\meta{macro}
%
%         在调用 |\lst@CArg| 之前把 \meta{characters} 变成活动的。
%
%     \item[0.21] |\lst@CDef{|\meta{1st}\meta{2nd}\marg{rest}|}|\meta{save
%          1st}\marg{execute}\marg{pre}\marg{post}
%
%         应与 |\lst@CArg| 或 |\lst@CArgX| 配合使用，
%         即在那里作为 \meta{macro}。\meta{1st}、\meta{2nd} 和 \meta{rest}
%         必须是活动字符，\meta{save 1st} 必须是一个未定义的
%         控制序列。
%
%         每当宏包（在列表中）遇到字符 \meta{1st} 时，
%         就执行 \meta{execute}。如果宏包检测到整个字符串
%         \meta{1st}\meta{2nd}\meta{rest}，我们还会额外执行 \meta{pre}，
%         然后是该字符串，最后是 \meta{post}。
%
%     \item[0.21] |\lst@CDefX|\meta{1st}\meta{2nd}\marg{rest}\meta{save
%          1st}\marg{execute}\marg{pre}\marg{post}
%
%         同上，只是当我们遇到 \meta{1st}\meta{2nd}\meta{rest} 时，
%         执行 \meta{pre} 和 \meta{post} 而不执行原字符串。这
%         意味着该字符串被替换为 \meta{pre}\meta{post}（前面带有
%         \meta{execute}）。
% \end{syntax}
% 作为最后一个例子，下面是 |\lst@DefDelimB| 的定义。
% \begin{verbatim}
%    \gdef\lst@DefDelimB#1#2#3#4#5#6#7#8{%
%        \lst@CDef{#1}#2%
%            {#3}%
%            {\let\lst@bnext\lst@CArgEmpty
%             \lst@ifmode #4\else
%                 #5%
%                 \def\lst@bnext{#6{#7}{#8}}%
%             \fi
%             \lst@bnext}%
%            \@empty}\end{verbatim}
