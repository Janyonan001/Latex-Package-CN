% 行范围是已知的——它或者被显式设置（通过编号或
% 任意行范围标记），或者由默认值（1 和
% 999999）隐式给出。|\lst@GetLineInterval| 递归解析已知的行范围，
% 因为可能存在逗号分隔的成对列表。
%    \begin{macrocode}
\lst@AddToHook{Init}
{%
  \ifx\lst@linerange\@empty
      \edef\lst@linerange{{\lst@firstline}-{\lst@lastline},}%
  \fi%
  \lst@GetLineInterval%
}%
\def\lst@GetLineInterval{\expandafter\lst@GLI\lst@linerange\@nil}
%    \end{macrocode}
% 逗号分隔的成对列表的分割由以下完成
%    \begin{macrocode}
\def\lst@GLI#1,#2\@nil{% GLI: get line interval
%    \end{macrocode}
% 列表被分成两部分：列表的第一个元素（\#1）和
% 列表的其余部分（\#2），后者被存入 |\lst@linerange| 以便
% 稍后处理。
%    \begin{macrocode}
  \def\lst@linerange{#2}\lst@GLI@#1--\@nil%
}
%    \end{macrocode}
% 进一步解析由 |lst@GLI@| 完成，参数是 |#1--\@nil|，
% 即列表第一个元素加上一个哨兵。这个
% 参数用模板 |#1-#2-#3\@nil| 解析。
%
%    \begin{macrocode}
\def\lst@GLI@#1-#2-#3\@nil{%
%    \end{macrocode}
% 例如以`|12-21|'给出的行范围导致参数
% |12-21--\@nil|，因此被解析为 \#1\(\leftarrow\) |12|、
% \#2\(\leftarrow\)|21|、\#3\(\leftarrow\)|-|。
%
% 否则也可以用任意行范围标记定义范围，
% 如`|start-end|'，这导致参数
% |12-21--\@nil|，因此被解析为 \#1\(\leftarrow\) |12|、
% \#2\(\leftarrow\)|21|、\#3\(\leftarrow\)|-|。


% 首先我们测试行范围是否以数字（由 -、1、
% 2、3、\ldots 组成）或任意行范围标记开头。如果行范围
% 错误地以`|-|'字符开头，则参数 \#1 不被设置，于是
% 范围从 1 开始，给出也许符合预期的结果，但
% 行范围的定义必须总是至少由三部分组成：
% \meta{first}、`|-|'和 \meta{last}。
%    \begin{macrocode}
  \lst@IfNumber{#1}%
  {%
    \ifx\@empty#1\@empty
        \let\lst@firstline\@ne
    \else
        \def\lst@firstline{#1\relax}
    \fi
%    \end{macrocode}
% 现在我们知道行范围的起始编号。对于只由一个
% 编号组成的行范围，\#3 不被设置；在其他所有情况下 \#2 定义
% 最后一行（显式或隐式）。
%    \begin{macrocode}
    \ifx\@empty#3\@empty
        \def\lst@lastline{9999999\relax}
        \ifx\@empty#2\@empty
            \let\lst@lastline\lst@firstline
        \fi
    \else%
        \ifx\@empty#2\@empty
            \def\lst@lastline{9999999\relax}
        \else % doesn't happen(?)
            \def\lst@lastline{#2\relax}
        \fi
    \fi
  }%
%    \end{macrocode}
%        如果我们找到了任意行范围标记，就把 firstline 和 lastline 设为
%        9999999。这（几乎）阻止现在打印任何内容。
%    \begin{macrocode}
  {%
    \def\lst@firstline{9999999\relax}
    \let\lst@lastline\lst@firstline
%    \end{macrocode}
%        我们把前缀和后缀加到标记上。
%    \begin{macrocode}
    \let\lst@rangebegin\lst@rangebeginprefix
    \lst@AddTo\lst@rangebegin{#1}%
    \lst@Extend\lst@rangebegin\lst@rangebeginsuffix
    \ifx\@empty#3\@empty
        \let\lst@rangeend\lst@rangeendprefix
        \lst@AddTo\lst@rangeend{#1}
        \lst@Extend\lst@rangeend\lst@rangeendsuffix
    \else
        \ifx\@empty#2\@empty
            \let\lst@rangeend\@empty
        \else
            \let\lst@rangeend\lst@rangeendprefix
            \lst@AddTo\lst@rangeend{#2}%
            \lst@Extend\lst@rangeend\lst@rangeendsuffix
        \fi
    \fi
%    \end{macrocode}
% 下面的定义将在 \hookname{SelectCharTable} 钩子中执行，
% 并且如果我们已经在处理列表，就立即在这里执行。
%    \begin{macrocode}
    \global\def\lst@DefRange{%
      \expandafter\lst@CArgX\lst@rangebegin\relax\lst@DefRangeB}%
    \ifnum\lst@mode=\lst@Pmode \expandafter\lst@DefRange \fi%
  }%
}
%    \end{macrocode}
