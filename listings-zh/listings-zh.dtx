% \begin{macro}{\lst@MakeCaption}
% 在定义这个宏之前，我们确保其他一些控制序列
% 存在——\lsthelper{Adam~Prugel-Bennett}{2001/02/19}{\abovecaptionskip
% 在 slides.cls 中未定义}报告了 slides 文档类的问题。
% 特别地，我们分配上题注和下题注间距寄存器，并定义
% |\@makecaption|，它是 article 类中该定义的确切副本。
% 为遵守 LPPL：你应当在你的 \TeX\ 系统上有该类的副本，或者从 CTAN
% 取得副本，例如从 ftp 服务器
% \texttt{ftp.dante.de}.
%
% Axel Sommerfeldt 提出了若干关于题注和
% 标题的改进。第一项是把间距寄存器的定义与
% |\@makecaption|.
%    \begin{macrocode}
\@ifundefined{abovecaptionskip}{%
  \newskip\abovecaptionskip%
  \newskip\belowcaptionskip%
}{}
\@ifundefined{@makecaption}{%
  \long\def\@makecaption#1#2{%
    \vskip\abovecaptionskip%
    \sbox\@tempboxa{#1: #2}%
    \ifdim \wd\@tempboxa >\hsize%
        #1: #2\par%
    \else%
        \global \@minipagefalse%
        \hb@xt@\hsize{\hfil\box\@tempboxa\hfil}%
    \fi%
   \vskip\belowcaptionskip}%
}{}
%    \end{macrocode}
% |\fnum@lstlisting| 的引入也归功于 Axel。此前替换文本
% 直接在 |\lst@MakeCaption| 中使用。|\noindent| 已
% 被移到别处，并变成 |\@parboxrestore|，这是在
% \lsthelper{Frank~Mittelbach}{2004/02/13}{回复：信息：caption 与
% listings 之间的不兼容}的缺陷报告之后。\lsthelper{Karl Berry}{2019/08/18}{加粗的
%   "listings 1"？}请求能够自定义标签。于是
% |\lstlistingnamestyle| 被引入到 |\lstlistingname| 前面。
%    \begin{macrocode}
\def\fnum@lstlisting{%
  {\lstlistingnamestyle\lstlistingname
    \ifx\lst@@caption\@empty\else~\thelstlisting\fi}%
}
%    \end{macrocode}
% 硬编码扩展名难以使用不同的扩展名，例如用于
% 附录。\lsthelper{Markus Kohm}{2023/09/05}{扩展 listings 使其
% 也主动支持 tocbasic}建议改为定义并使用 |\ext@lstlisting|。
%    \begin{macrocode}
\def\ext@lstlisting{lol}
%    \end{macrocode}
% 题注只为显示样式列表设置——感谢
% \lsthelper{Peter~L\"offler}{2004/04/24}{pdfTeX 警告（dest）：名称 figure.1
% 已被引用但不存在}报告该缺陷，并感谢
% \lsthelper{Axel~Sommerfeldt}{2004/02/27}{Re: caption + listings + hyperref}
% 分析了该缺陷。
% 我们 |\refstepcounter| 列表计数器当且仅当 |\lst@@caption|
% 非空。否则我们确保正确的超引用，
% 见下面的 |\lst@HRefStepCounter|。我们每个列表做一次，即在
% 顶部。
%    \begin{macrocode}
\def\lst@MakeCaption#1{%
  \lst@ifdisplaystyle
    \ifx #1t \allowbreak%
        \ifx\lst@@caption\@empty\expandafter\lst@HRefStepCounter \else
                                \expandafter\refstepcounter
        \fi {lstlisting}%
        \ifx\lst@label\@empty\else \label{\lst@label}\fi
%    \end{macrocode}
% 下面的代码在 \lsthelper{Rolf~Niepraschk}{2003/06/11}{题注与
% 列表之间的分页}的缺陷报告之后，从 \hookname{Init} 钩子移到这里。此外 |\lst@name| 等的初始化
% 是在 \lsthelper{Werner~Struckmann}
% 的缺陷报告之后插入这里的。
% {2003/06/25}{undefined control sequence \lst@name}.
% 如果名字既不为空也不是单个空格，我们就做一个`lol'条目。但
% 我们先测试 |\lst@|(|@|)|caption| 和 |\lst@ifnolol|。
%    \begin{macrocode}
        \let\lst@arg\lst@intname \lst@ReplaceIn\lst@arg\lst@filenamerpl
        \global\let\lst@name\lst@arg \global\let\lstname\lst@name
        \lst@ifnolol\else
            \ifx\lst@@caption\@empty
                \ifx\lst@caption\@empty
                    \ifx\lst@intname\@empty \else \def\lst@temp{ }%
                    \ifx\lst@intname\lst@temp \else
                        \addcontentsline{\ext@lstlisting}{lstlisting}\lst@name
                    \fi\fi
                \fi
            \else
                \addcontentsline{\ext@lstlisting}{lstlisting}%
                    {\protect\numberline{\thelstlisting}\lst@@caption}%
            \fi
        \fi
    \fi
%    \end{macrocode}
% 我们当且仅当题注非空且用户在 |#1| $\in\{\mathtt t,\mathtt b\}$ 处
% 请求了题注时才制作题注。为了禁止题注（或标题）与
% 列表之间的分页，我们局部重新定义原语 |\vskip| 以插入 |\nobreak|。
% 注意我们允许在`上题注'之前和`下题注'之后
% 分页。另外，|\@makecaption| 调用中的 |\ignorespaces| 是为了与
% \LaTeX\ 在 |\@caption| 中的做法一致；AMSbook 类（也许还有其他类）
% 假定它存在，并在测试空题注时试图去掉它，从而引起了
% \lsthelper{Xiaobo~Peng}{2006/06/29}{使用 amsbook 类时不显示题注}
% 注意到的缺陷。
% \begin{TODO}
% 这次重新定义是一个暴力方法。有没有更好的办法？
% \end{TODO}
%    \begin{macrocode}
    \ifx\lst@caption\@empty\else
        \lst@IfSubstring #1\lst@captionpos
            {\begingroup \let\@@vskip\vskip
             \def\vskip{\afterassignment\lst@vskip \@tempskipa}%
             \def\lst@vskip{\nobreak\@@vskip\@tempskipa\nobreak}%
             \par\@parboxrestore\normalsize\normalfont % \noindent (AS)
             %%\ifx #1t\allowbreak \fi
             \ifx\lst@title\@empty
                 \lst@makecaption\fnum@lstlisting{%
                   \ignorespaces \lst@caption}
             \else
                 \lst@maketitle\lst@title % (AS)
             \fi
             \ifx #1b\allowbreak \fi
             \endgroup}{}%
    \fi
  \fi}
%    \end{macrocode}
% 我在 \lsthelper{Andreas~Matthias}{2000/01/04}{题注受 basicstyle 影响}
% 的缺陷报告之后插入了 |\normalsize|，
% 并在收到 \lsthelper{Sonja~Weidmann}{2000/02/01}{listings 与 caption 宏包
% 不兼容}的另一个报告之后把它移到 |\@makecaption| 之前。
% \end{macro}
%
% \begin{macro}{\lst@makecaption}
% \begin{macro}{\lst@maketitle}
% Axel 提出了第一个定义。另外两个是默认定义。
% 可以调整它们以使 \packagename{listings} 与其他
% 宏包和文档类兼容。
% Markus 建议也定义 |\@captype|，这样他的
% |\raggedlstlistingcaption| 就可以使用了。
%    \begin{macrocode}
\def\lst@makecaption{\def\@captype{lstlisting}\@makecaption}
\def\lst@maketitle{\@makecaption\lst@title@dropdelim}
\def\lst@title@dropdelim#1{\ignorespaces}
%    \end{macrocode}
% 下面的 \packagename{caption}(\packagename{2}) 支持同样来自
% Axel。
%    \begin{macrocode}
\AtBeginDocument{%
\@ifundefined{captionlabelfalse}{}{%
  \def\lst@maketitle{\captionlabelfalse\@makecaption\@empty}}%
\@ifundefined{caption@startrue}{}{%
  \def\lst@maketitle{\caption@startrue\@makecaption\@empty}}%
}
%    \end{macrocode}
% \end{macro}\end{macro}
