% \subsection{字符表}\label{dCharacterTables}
%
% 现在你知道汽车长什么样了，如果练习
% 一下，你就能拿到驾照。但如果你想对汽车做大
% 改动，就会遇到困难。所以让我们仔细观察，进入最
% 困难的部分：引擎。我们先看大局，然后
% 一步步填补细节。对我们来说，覆盖 \TeX 的
% 字符表是合适的。首先我们定义一个标准字符表，其中包含
% \begin{itemize}
% \item 字母：标识符由这些字符组成，
% \item 数字：用于标识符或数值常量的字符，
% \item 空格：被视为空白的字符，
% \item 制表符：被视为制表符的字符，
% \item 换页符：被视为换页字符的字符，以及
% \item 其他：所有其他字符。
% \end{itemize}
% 这个字符表会随当前编程语言而改变。
% 我们可以定义字符串和注释定界符或其他特殊字符。
% 第~\pageref{rStdCharTable} 页的表~\ref{rStdCharTable} 展示了标准
% 字符表。它可以用键 \keyname{alsoletter}、
% \keyname{alsodigit} 和 \keyname{alsoother} 修改。
%
% 这些`类'如何协同工作？假设当前字符
% 串是 `|tr|'。那么字母 `|y|' 只是追加这个字母，我们得到
% `|try|'。下一个非字母（且非数字）字符会触发
% 这些字符的输出。然后我们收集随后所有非字母字符，直到再次
% 遇到字母。这又触发非字母的输出，依此类推。内部每个
% 字符都按 \TeX 意义变成活动字符，并被定义为做正确
% 的事，例如我们说
% \begin{verbatim}
%    \def A{\lst@ProcessLetter A}\end{verbatim}
% 其中第一个 `|A|' 是活动的，第二个具有字母 catcode 11。
% 宏 |\lst@ProcessLetter| 取一个记号并把它当字母处理。
% 存在下列宏，其中最后三个不取显式参数。
% \begin{syntax}
% \item[0.18] |\lst@ProcessLetter| \meta{spec.\ token}
% \item[0.18] |\lst@ProcessDigit| \meta{spec.\ token}
% \item[0.18] |\lst@ProcessOther| \meta{spec.\ token}
% \item[0.18] |\lst@ProcessTabulator|
% \item[0.18] |\lst@ProcessSpace|
% \item[0.20] |\lst@ProcessFormFeed|
% \end{syntax}
% \meta{spec.\ token} 应当做两件事。通常它展开为
% 字符的可打印版本。但如果 |\lst@UM| 等价于
% |\@empty|，则 \meta{spec.\ token} 必须展开为一个\emph{字符记号}。
% 例如，井号通常展开为 |\#|，它是通过
% |\chardef| 定义，不是字符记号。但如果 |\lst@UM| 等价于
% |\@empty|，井号展开为字符 `|#|'（catcode 12）。注意：
% 对 |\lst@UM| 的\emph{改动必须是局部的}。不过，你应当
% 不需要自己做这类基础工作。\packagename{listings}
% 宏包提供了使用该特性的高级宏，
% 例如第~\ref{dKeywordsAndWorkingIdentifiers} 节中的 |\lst@InstallKeywords|。
%
% \begin{syntax}
% \item[0.18] |\lst@Def|\marg{character code}\meta{parameter text}\marg{definition}
% \item[0.18] |\lst@Let|\marg{character code}\meta{token}
%
%             定义指定的字符，或分别把 \meta{token} 赋给它。
%             不影响 catcode 表。如果你的定义带参数，要小心：
%             向前多读一个字符是不安全的。
%             此外，参数可以是\emph{任意的}；有时它是下一个
%             源代码字符，有时是 \packagename{listings} 宏包的某个代码，
%             例如 |\relax|、|\@empty|、|\else|、
%             |\fi| 等。因此不要对这样的参数使用 \TeX 的 ord 运算符 |`|，
%             例如不要写 |\ifnum`#1=65| 来测试 `|A|'。
%
%             |\lst@Def| 和 |\lst@Let| 相对较慢。标准字符表的真正定义
%             与下面的例子不同，但它
%             可以以如下内容开始
% \begin{verbatim}
%    \lst@Def{9}{\lst@ProcessTabulator}
%    \lst@Def{32}{\lst@ProcessSpace}
%    \lst@Def{48}{\lst@ProcessDigit 0}
%    \lst@Def{65}{\lst@ProcessLetter A}\end{verbatim}
%
%\iffalse
% \item[0.20] |\lst@activecharstrue|
% \item[0.20] |\lst@activecharsfalse|
%
%             控制选择字符表时是否同时让所有字符
%             变活动（标准/扩展）。这通常为真，因此是默认值。
%             只有 \packagename{fancyvrb} 接口会在局部把它设为 false。
%\fi
% \end{syntax}
% 目前这些就够了。第~\ref{dUsefulInternalDefinitions} 节
% 介绍操作字符表的高级定义，特别是
% 如何添加新的注释或字符串类型。
%
%
% \subsection{关于输出}
%
% \packagename{listings} 宏包用一些变量保存输出
% 数据。不建议写入这些变量。先从简单的说起。
% \begin{syntax}
% \item[0.17,,data] |\lst@lastother|
%
%             等于最后处理过的非标识符字符的 \meta{spec.\ token} 版本。
%             由于编程语言会重新定义标准
%             字符表，我们使用原始的 \meta{spec.\ token}。
%             例如，如果最后处理的是双引号，|\lst@lastother|
%             并不等价于进入和离开字符串模式的宏。
%             它等价于 |\lstum@"|，其中 |"| 属于该控制
%             序列。记住 \meta{spec.\ token} 要么展开为
%             可打印内容，要么展开为字符记号。
%
%             如果这样的字符不可用（例如在行首），|\lst@lastother| 等价于 |\@empty|。
%             有时在处理最后一个`其他'字符之后已经打印了标识符，
%             也就是说该字符已经离得很远。这种情况下 |\lst@lastother|
%             等于 |\relax|。
%
% \item[0.17] |\lst@outputspace|
%
%             用这个预定义的 \meta{spec.\ token}（显然对应字符码
%             32）来测试 |\lst@lastother|。
%
% \item[0.20] |\lstum@backslash|
%
%             用这个预定义的 \meta{spec.\ token}（对应字符码 92）来测试
%             |\lst@lastother|。在 |\lst@Def| 的替换文本中可以写
%             |\ifx| |\lst@lastother| |\lstum@backslash| \ldots\ 来测试
%             最后一个字符是否为反斜杠。
%
% \item[0.20] |\lst@SaveOutputDef|\marg{character code}\meta{macro}
%
%             把与 \meta{character code} 对应的 \meta{spec.\ token}
%             存入 \meta{macro}。这是取得可用于测试 |\lst@lastother| 的
%             正确含义的唯一安全方式，例如
%           |\lst@SaveOutputDef{"5C}\lstum@backslash|.
%
%             如果 \meta{character code} 不在 33 到 126（含）之间，
%             你会得到一个``runaway argument''错误。
% \end{syntax}
% 现在来看更多处理输出数据和
% 状态的宏。
% \begin{syntax}
% \item[1.0] |\lst@XPrintToken|
%
%             输出当前字符串并重置它。该宏会跟踪
%             这里描述的所有变量。
%
% \item[0.18,,token] |\lst@token|
%
%             包含当前字符串。每个`字符'通常
%             展开为它的可打印版本，但如果 |\lst@UM| 等价于
%             |\@empty|，它必须展开为字符记号。
%
% \item[0.12,,counter] |\lst@length|
%
%             是当前字符串的长度。
%
% \item[0.12,,dimension] |\lst@width|
%
%             是单个字符盒的宽度。
%
% \item[0.20,,global dimension] |\lst@currlwidth|
%
%             是到目前为止已打印行的宽度。
%
% \item[0.18,,global counter] |\lst@column|
% \item[0.12,,global counter] |\lst@pos|（非正）
%
%             |\lst@column|$-$|\lst@pos| 是到目前为止已打印行的长度。
%             我们用两个计数器，因为这简化了制表符处理：
%             |\lst@pos| 是`已打印行长度'模 \keyname{tabsize} 的一个非正
%             代表值。它通常不是最大的非正代表值。
%
% \item[0.20] |\lst@CalcColumn|
%
%             |\@tempcnta| 得到 |\lst@column| $-$ |\lst@pos| $+$ |\lst@length|。
%             这是当前列号减一，即从零起算的当前列
%             号。
%
% \item[0.18,,global dimension] |\lst@lostspace|
%
%             等于`丢失的'空间：期望的当前行宽减去实际行宽。
%             只要该尺寸为正，灵活列格式就可以使用
%             这个空间来修正列对齐。
% \end{syntax}
%
%
% \section{宏包扩展}\label{dPackageExtensions}
%
%
% \subsection{关键词和工作标识符}\label{dKeywordsAndWorkingIdentifiers}
%
% \aspectname{keywords} 方面定义两个主要宏。它们的
% 语法分别示于左侧。右侧是宏包
% 实际定义某些键的例子。
% \begin{syntax}
%   \item[0.21] \cs{lst@InstallFamily}
%
%     \marg{prefix}\syntaxfill \texttt k\\
%     \marg{name}\syntaxfill |{keywords}|\\
%     \marg{style name}\syntaxfill |{keywordstyle}|\\
%     \marg{style init}\syntaxfill |\bfseries|\\
%     \marg{default style name}\syntaxfill |{keywordstyle}|\\
%     \marg{working procedure}\syntaxfill |{}|\\
%     \meta{\alternative{l,o}}\syntaxfill |l|\\
%     \meta{\alternative{d,o}}\syntaxfill |d|
%
%         根据 \meta{working procedure} 是否为空，安装关键词类或
%         `工作'标识符类。
%
%         会定义三个键 \meta{name}、\keyname{more}\meta{name} 和
%         \keyname{delete}\meta{name}，以及（若非空）\meta{style name}。
%         后者的第一阶成员若不等价于 |\relax|，会用
%         \meta{style init} 初始化。如果用户让某个
%         类别样式未定义，则改用 \meta{default style name}。
%         因此，请确保这个样式总是已定义。在例子中，
%         第一阶 keywordstyle 被设为 |\bfseries|，并作为
%         所有其他类别的默认值。
%
%         如果 \meta{working procedure} 不为空，则在
%         遇到这样的（用户定义的）标识符时执行该代码。\meta{working procedure}
%         恰好接受一个参数，即实际标识符
%         所属的类别号。如果代码使用变量并需要
%         先前调用的值，你必须把这些变量定义为
%         |\global| 的。并不确定工作过程是否在
%         （单独的）分组内执行。
%
%         \texttt l 表示语言键，即每次选择语言时
%         列表都会被重置。\texttt o 表示`其他'键。关键词
%         或工作测试安装在 \hookname{DetectKeyword}
%         或 \hookname{Output} 钩子上，取决于
%     \meta{\alternative{d,o}}.
%
%   \item[0.20] \cs{lst@InstallKeywords}
%
%     \marg{prefix}\syntaxfill \texttt{cs}\\
%     \marg{name}\syntaxfill |{texcs}|\\
%     \marg{style name}\syntaxfill |{texcsstyle}|\\
%     \marg{style init}\syntaxfill |\relax|\\
%     \marg{default style name}\syntaxfill |{keywordstyle}|\\
%     \marg{working procedure}\syntaxfill see below\\
%     \meta{\alternative{l,o}}\syntaxfill |l|\\
%     \meta{\alternative{d,o}}\syntaxfill |d|
%
%         参数相同，功能相同，只有一个例外。该宏
%         只安装一个关键词类，而不是整个族。因此
%         \meta{working procedure} 的参数是固定的（目前
%         为空）。
%
%         例子中的工作过程读作
%         如下。
% \begin{verbatim}
%    {\ifx\lst@lastother\lstum@backslash
%         \let\lst@thestyle\lst@texcsstyle
%     \fi}\end{verbatim}
%    % \vspace*{-.5\baselineskip}
% 这个过程做什么？首先，只有当找到用户
% 提供的列表（或语言定义）中的关键词时它才被调用。该
% 过程现在检查前面是否有反斜杠，并相应地
% 设置输出样式。
%
% \iffalse
% \item[0.20] |\lst@InstallTest|\marg{prefix}\syntaxbreak
%     |\lst@|\meta{name}|@list||\lst@|\meta{name}~|\lst@g|\meta{name}|@list|^^A
%   |\lst@g|\meta{name}\syntaxbreak
%     |\lst@g|\meta{name}|@sty|~\meta{\alternative{w,s}}\meta{\alternative{d,o}}
%
%     根据 \meta{\alternative{w,s}} 安装`工作标识符'测试或关键词样式。
%     |\lst@g|\meta{name}|@sty| 包含工作过程或样式宏。注意
%     这些测试的行为取决于 \texttt{savemem} 选项。
%     关键词或工作测试安装在 \hookname{DetectKeyword}
%     或 \hookname{Output} 钩子上，取决于 \meta{\alternative{d,o}}。
%   \hookname{Output} hook according to \meta{\alternative{d,o}}.
%
%   ^^A Either each call of this macro or each different \meta{prefix}
%     插入 ^^A 另一个测试（取决于 \texttt{savemem} 选项）。
%
%     |\lst@|\meta{name} 包含当前标识符列表，
%     |\lst@|\meta{name}|@list| 是当前使用类别的
%     `|\lst@|\meta{$n_i$}|\lst@g|\meta{$n_i$}' 序列。如果没有使用其他类别，它
%     等于 |\lst@|\meta{name}|\lst@g|\meta{name}。全局版本
%     |\lst@g|\ldots\ 用于跟踪关键词。（这段
%     描述还需要改进。）
% \fi
% \end{syntax}
