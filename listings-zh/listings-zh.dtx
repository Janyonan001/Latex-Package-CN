% \subsubsection{catcode 的问题}
%
% \begin{macro}{\lst@nfss@catcodes}
% \lsthelper{Anders~Edenbrandt}{1997/04/22}{.fd 文件的预加载}发现了一个与
% \texttt{.fd} 文件有关的缺陷。由于我们改动 catcode 而这些文件是按需
% 读入的，我们必须在输入这些文件之前重置 catcode。我们
% 对 |\nfss@catcodes| 做局部重新定义。
%    \begin{macrocode}
\lst@AddToHook{Init}
    {\let\lsts@nfss@catcodes\nfss@catcodes
     \let\nfss@catcodes\lst@nfss@catcodes}
%    \end{macrocode}
% 在 \lsthelper
% {David~Aspinall}{2003/07/17}{在 tabular 内加载 .fd 文件产生
% 错误}报告缺陷之后，|&| 字符变成了 |\&|。
%    \begin{macrocode}
\def\lst@nfss@catcodes{%
    \lst@makeletter
        ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\relax
    \@makeother (\@makeother )\@makeother ,\@makeother :\@makeother\&%
    \@makeother 0\@makeother 1\@makeother 2\@makeother 3\@makeother 4%
    \@makeother 5\@makeother 6\@makeother 7\@makeother 8\@makeother 9%
    \@makeother =\lsts@nfss@catcodes}
%    \end{macrocode}
% 对 \lsthelper{Christian~Gudrian}
% {2000/11/16}{mathpple 的问题}所报告缺陷的调查表明，等号需要
% 具有`其他'catcode，如上所赋值。
% \lsthelper{Svend~Tollak~Munkejord}{2002/04/17}{宏包与
%   Lucida .fd 文件不兼容}报告了 Lucida .fd 文件的问题，而
% \lsthelper{Heiko~Oberdiek}{2002/04/17}{回复：listings 在 Lucida
% 字体下失败}分析了该缺陷，这导致上面以
% |\@makeaother (|.
%
% |\lst@makeletter| 这个名字是模仿 \LaTeX 的 |\@makeother|。
%    \begin{macrocode}
\def\lst@makeletter#1{%
    \ifx\relax#1\else\catcode`#111\relax \expandafter\lst@makeletter\fi}
%    \end{macrocode}
% \end{macro}
