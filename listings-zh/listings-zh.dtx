% \subsection{如何阅读参考}
%
% 命令、键和环境按如下方式呈现。
% \begin{syntax}
% \item[1.0,default,hints] \texttt{command}、\texttt{environment} 或
%       \keyname{key} 带 \meta{parameters}
%
%       本栏包含说明；这里我们描述其他栏。
%
%       如果存在，左页边的标签提供额外信息：
%       `\textit{addon}' 表示额外引入的功能，
%       `\textit{changed}' 表示修改过的键，
%       `\textit{data}' 表示仅包含数据的命令（因此可以通过
%       |\renewcommand| 调整），等等。有些键和功能标有 `\emph{bug}'
%       或 \dag 符号。这些功能将来可能更改或被移除，所以请谨慎使用。
%
%       如果有触及右页边的逐字文本，那就是预定义值。注意有些键对每个列表
%       都默认此值，即只能在单个列表上使用的键。
% \end{syntax}
% 关于参数，请记住以下几点：
% \begin{enumerate}
% \item 列表总是指逗号分隔的列表。你必须用花括号括住这样的列表。
%       否则你会和 \packagename{keyval} 宏包发生麻烦；它会抱怨未定义的键。
% \item 如果你在可选的 \oarg{key=value list} 内使用键的
%       \oarg{optional argument}，你必须用参数花括号括住键的整个值：
%       |\begin{lstlisting}[caption=|{\rstyle|{|}|[one]two|{\rstyle|}|}|]|。
% \item 方括号 `|[ ]|' 通常括住可选参数，必须逐字输入。
%       普通方括号 `[ ]' 总是表示可选参数，不要输入。因此 |[*]| 必须
%       原样输入，但 [|*|] 如果你使用这个参数就只得到 |*|。
% \item 竖线表示二选一，例如 ^^A
%       \meta{\alternative{true,false}} 允许 \texttt{true} 或
%       \texttt{false} 作为参数。
% \item 如果你想输入特殊字符 |{}#%\| 之一，该字符必须用反斜杠转义。
%       这意味着你必须写 |\}| 来表示单个字符`右花括号'——当然不是用于
%       结束参数字符。
% \end{enumerate}
%
%
% \subsection{排版列表}\label{rTypesettingListings}
%
% \begin{syntax}
%   \item[0.19] \rcmdname\lstset\marg{key=value list}
%
%     设置指定键的值，另见第
%     \ref{uTheKey=ValueInterface} 节。这些参数的值保持到
%     当前组结束为止。相反，下面所有可选的
%     \meta{键=值列表} 只修改单个
%     列表的参数。
%
%   \item[0.18]
%     \rcmdname\lstinline\oarg{key=value list}\meta{character}^^A
%     \meta{source code}\meta{same character}
%
%     作用类似 |\verb|，但会遵循当前活动的语言和样式。
%     这些列表使用灵活列，除非在可选参数中另有
%     要求；它们不支持边框或背景
%     色。你可以写 `|\lstinline!var i:integer;!|'，得到
%     `\lstinline!var i:integer;!'.
%
%     由于该命令会先向后查找可选参数，因此如果你想用 |[| 作为
%     \meta{字符}，就至少得提供一个空的可选参数。
%
%     \dag\ 为支持
%     语法 |\lstinline|\oarg{键=值列表}\marg{源代码}，已经实现了一个实验版本。你可以试用，
%     并反馈成功或失败的情况。一个已知限制是：
%     在另一个参数内部时，源代码的最后一个记号不能
%     是显式的空格记号——当然，在另一个参数内部使用列表本身
%     就是实验性的，参见第
%     \ref{rListingsInsideArguments} 节。
%
%     另一个限制是该功能不能用于
%     |tabular| 环境的单元格。变通方法见第~\ref{uListingsArguments} 节。
%
%     关于创建 |\lstinline| 命令简短别名的命令，另见第~\ref{rShortInline} 节。
%
%   \item[0.15] |\begin{|\texttt{\rstyle lstlisting}|}|\oarg{key=value
%           list}
%
%       \leavevmode\hspace*{-\leftmargini}|\end{|\texttt{\rstyle
%       lstlisting}|}|
%
%       把夹在中间的代码排版为行间列表。
%
%       与 \packagename{verbatim} 宏包的环境不同，
%       同一行上的 \LaTeX 代码以及环境结束之后的代码会被排版，
%       或者说被执行。
%
%     \item[0.1] \rcmdname\lstinputlisting\oarg{key=value list}\marg{file
%       name}
%
%       把独立的源代码文件排版为行间列表。
%   \end{syntax}
%
%
%   \subsection{选项}
%
% 以下各节描述了所有可用于影响列表外观的键。
%
%
% \subsubsection{查找文件}
%
% \begin{syntax}
%   \item[1.8, {}] \rkeyname{inputpath}|=|\meta{path}
%
%     定义 \meta{文件名} 所指文件所在的路径。
%
%     \rkeyname{inputpath} 会覆盖 |TEXINPUTS| 环境变量，
%     也就是说，如果某个文件位于
%     |TEXINPUTS| 给出的某个路径上，而 \meta{路径} 不在
%     |TEXINPUTS| 中，该文件就不会再被找到。
%
%     把 \rkeyname{inputpath} 作为 \rcmdname\lstinputlisting{} 的选项设置时，
%     会覆盖 \rcmdname\lstset 设定的值。
% \end{syntax}
%
%
% \subsubsection{空间与位置}
%
% \begin{syntax}
%   \item[0.20,floatplacement] \rkeyname{float}|=|[|*|]\meta{subset of
%     \textup{\texttt{tbph}}}\syntaxor\rkeyname{float}
%
%     只对单独的显示列表有意义，使它们可以
%     浮动。该参数控制 \LaTeX\ \emph{允许}把浮动体放在
%     哪里：当前页或下一页的顶部或底部，单独
%     的一页，或者就在列表所在处。
%
%     可选星号可用于在双栏文档中得到跨栏的
%     浮动体。
%
%   \item[0.21,tbp] \rkeyname{floatplacement}|=|\meta{place specifiers}
%
%     当 \keyname{float} 不带值时，就用它作为位置说明符。
%
%   \item[0.21,\medskipamount] \rkeyname{aboveskip}|=|\meta{dimension}
%   \item[0.21,\medskipamount] \rkeyname{belowskip}|=|\meta{dimension}
%
%     定义显示列表上下的间距。
%
%   \item[0.17,0pt,\dag] \rkeyname{lineskip}|=|\meta{dimension}
%
%     指定列表内各行之间的附加间距。
%
%   \item[0.18,c,\dag] \rkeyname{boxpos}|=|\meta{\alternative{b,c,t}}
%
%     有时 \packagename{listings} 宏包会给列表加上一个 |\hbox|——否则
%     它就无法正常打印甚至正确处理。这个
%     键决定相对于周围材料的垂直对齐方式：
%     底部基线、居中或顶部基线。
% \end{syntax}
%
%
% \subsubsection{打印范围}
%
% \begin{syntax}
%   \item[0.12,true]
%     \rkeyname{print}|=|\meta{\alternative{true,false}}\syntaxor\rkeyname{print}
%
%     控制是否排版单个显示列表。即使
%     设为 false，相应的标题仍会打印，标签仍会
%     定义。
%
%     注意：如果加载宏包时没有使用 \texttt{draft} 选项，你可以
%     把这个键与 |\lstset| 一起使用。反之，该键
%     可用于在使用 \texttt{draft} 选项时仍然排版特定的
%     列表。
%
%   \item[0.1,1] \rkeyname{firstline}|=|\meta{number}
%   \item[0.1,9999999] \rkeyname{lastline}|=|\meta{number}
%
%     只能用于单个列表。它们决定打印显示列表时所使用的实际
%     输入行。
%
%   \item[1.2;1.9]
%     \rkeyname{linerange}|={|\meta{first1}\texttt-\meta{last1}\texttt,^^A
%         \meta{first2}\texttt-\meta{last2}\texttt, 等等
%         |}|\label{uoption:linerange}
%
%     只能用于单个列表。给定的列表行范围
%     会被显示。各区间必须有序，且不能
%     相交。
%
%     事实上三元组 \meta{first}\texttt-\meta{last} 的每一部分都可以
%     省略。省略 \meta{first} 或 \meta{last} 意味着
%     范围从第 1 行开始、到 \meta{last} 结束，或从
%     \meta{first} 开始、到文件最后一行结束；单个数字
%     则意味着范围从该数字所给的行开始并结束于该行，
%     而省略 \meta{first} 或 \meta{last} 意味着范围
%     从第 1 行开始、到文件最后一行结束。
%
%   \item[1.8, true]
%     \rkeyname{consecutivenumbers}|=|\meta{\alternative{true,false}}^^A
%     \syntaxor\rkeyname{consecutivenumbers}\label{uoption:consecutivenumbers}
%
%     只能用于单个列表。只有同时使用了 \rkeyname{linerange} 时
%     它才有意义。默认值（true）意味着\emph{所有}行范围的
%     行号是连续编号的，
%     例如 1、2、3、……如果设为 false，不同范围会
%     各自编号（见第~\ref{uLineNumbers} 节）。
%
%   \item[0.20,false]
%     \rkeyname{showlines}|=|\meta{\alternative{true,false}}\syntaxor\rkeyname{showlines}
%
%     若为 true，宏包会在列表末尾打印空行。
%     否则这些行会被丢弃（但仍计入
%     行号计数）。
%
%   \item[1.0] \rkeyname{emptylines}|=|[|*|]\meta{number}
%
%     允许的空行最大数。如果空行块超过
%     \meta{number} 行，则只打印 \meta{number} 行。
%     不加可选星号时，省略空行会打乱行号；
%     加了星号，各行则保留其原始行号。
%
%   \item[0.19,0] \rkeyname{gobble}|=|\meta{number}
%
%     吃掉 \emph{环境}代码每行开头的 \meta{number} 个
%     字符。该键对 \cs{lstinline} 或 \cs{lstinputlisting}
%     不起作用。
%
%     制表符在被吃掉之前先展开为 \ikeyname{tabsize} 个空格。
%     字符数少于 \ikeyname{gobble} 的代码行
%     视为空行。切勿让环境结尾的缩进超过
%     该字符数。
% \end{syntax}
%
