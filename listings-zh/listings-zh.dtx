% \begin{macro}{\float@addtolists}
% \packagename{float} 宏包定义了一种通用方式，让宏包向除
% 标准 figure 和 table 列表之外的所有浮动体列表添加
% 内容（例如章名）。每个定义浮动体列表的
% 宏包都向 |\float@addtolists| 添加一条命令，然后
% 希望向所有浮动体列表添加内容的宏包（例如
% KOMA-script 文档类）就可以使用它，而不必知道可能存在的
% 所有列表。感谢 \lsthelper{Markus~Kohm}{2007/02/25}{-}
% 的建议。
%
% 不幸的是，\packagename{float} 用 |\newcommand| 定义它；因此
% 为避免冲突，我们必须在其加载之后重新定义它。
% |\AtBeginDocument| 是做到这一点的最简单方式。再次感谢
% Markus 的建议。
%    \begin{macrocode}
\AtBeginDocument{%
  \@ifundefined{KOMAClassName}{%
    \@ifundefined{float@addtolists}{%
      \gdef\float@addtolists#1{\addtocontents{\ext@lstlisting}{#1}}%
    }{%
      \let\orig@float@addtolists\float@addtolists
      \gdef\float@addtolists#1{%
        \addtocontents{\ext@lstlisting}{#1}%
        \orig@float@addtolists{#1}}}%
  }{}%
}%
%    \end{macrocode}
% \end{macro}
