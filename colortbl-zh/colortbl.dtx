%    >{\columncolor[gray]{0.8}[.5\tabcolsep][\tabcolsep]}l}
% \newcolumntype{H}{>{\columncolor[gray]{0.8}}l}
%
%
%^^A 3.3（如下方 verbatim 文本所用）效果最佳，
%^^A 但需要 1996 年 6 月版本的 dcolumn，因此这里使用 -1。
% \newcolumntype{C}{%
%     >{\columncolor{yellow}[.5\tabcolsep]}%
%       D{.}{\cdot}{-1}}
% \newcolumntype{I}{%^^A
%     >{\columncolor[gray]{0.8}[\tabcolsep][.5\tabcolsep]}%^^A
%                  D{.}{\cdot}{-1}}
%
% \setlength\minrowclearance{2pt}
% 开始之前先留出一点间距："\setlength\minrowclearance{2pt}"
%
% \begin{longtable}{ABC}
% \multicolumn{3}{E}{长表格示例}\\
% \multicolumn{2}{F}{前两列}&
