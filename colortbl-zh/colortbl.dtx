% \section{引言}
%
% 本宏包用于给表格上色（即在列内容后方添加彩色底纹）。在这一点上，
% 它与 Timothy Van Zandt 的 \textsf{colortab} 宏包有许多相似之处；
% 但二者的内部实现大不相同，此外 \textsf{colortab}
% 还能配合 \LaTeX\ 之外其他排版格式的表格结构使用。
% 本宏包则要求使用 \LaTeX（及其 \textsf{color} 与
% \textsf{array} 宏包）。
%
% 首先给出一个标准的 \textsf{tabular} 表格，以便对照。
% \begin{center}
%\begin{minipage}{.75\textwidth}
%\begin{verbatim}
% \begin{tabular}{|l|c|}
%  一&二\\
%  三&四
%  \end{tabular}
%\end{verbatim}
%\end{minipage}
% {\bfseries
%  \begin{tabular}{|l|c|}
%  一&二\\
%  三&四
%  \end{tabular}}
% \end{center}
%
% \section{\cs{columncolor} 命令}
%
% 下面的示例展示了本宏包所引入的
% "\columncolor" 命令的各种用法。所有示例都保留了由 "|" 指定的竖线，
% 以便更清楚地看出各列的位置；尽管在实际使用中，你可能并不希望同时出现彩色
% 底纹 \emph{和} 竖线。
%
% 本宏包提供 "\columncolor" 命令，它应当（只）在 ">" 列格式说明符的
% 参数中使用，用于在指定列后方添加彩色底纹。它既可用于 \textsf{array}
% 或 \textsf{tabular} 的主"导言区"参数中，也可用于
% "\multicolumn" 格式说明中。
%
% 基本格式为：\\
% "\columncolor"\oarg{颜色模式}\marg{颜色}
%                          \oarg{左侧伸出量}\oarg{右侧伸出量}
%
% 第一个参数（若使用可选参数则为前两个）是标准的 \textsf{color}
% 宏包参数，与 "\color" 所用的相同。
%
% 最后两个参数控制底纹超出该列最宽内容的距离。
% 若省略 \emph{右侧伸出量} 参数，则默认取
% \emph{左侧伸出量} 的值；若两者都省略，则默认为
%  "\tabcolsep"（在 \textsf{tabular} 中）或 "\arraycolsep"
% （在 \textsf{array} 中）。
%
% 若两个伸出量都设为 "0pt"，效果如下：
% \begin{center}
%\begin{minipage}{.75\textwidth}
%\begin{verbatim}
%|>{\columncolor[gray]{.8}[0pt]}l|
%>{\color{white}%
%  \columncolor[gray]{.2}[0pt]}l|
%\end{verbatim}
%\end{minipage}
% {\bfseries
% \begin{tabular}{%
%   |>{\columncolor[gray]{.8}[0pt]}l|
%   >{\color{white}%
%     \columncolor[gray]{.2}[0pt]}l|
%   }
% 一&二\\
%  三&四
%  \end{tabular}}
% \end{center}
% 采用默认伸出量 "\tabcolsep" 时产生如下效果：
%\begin{center}
%\begin{minipage}{.75\textwidth}
%\begin{verbatim}
%|>{\columncolor[gray]{.8}}l|
%>{\color{white}%
%  \columncolor[gray]{.2}}l|
%\end{verbatim}
%\end{minipage}
% {\bfseries
% \begin{tabular}{%
%   |>{\columncolor[gray]{.8}}l|
%   >{\color{white}%
%     \columncolor[gray]{.2}}l|
%   }
% 一&二\\
%  三&四
%  \end{tabular}}
% \end{center}
% 你或许想要介于这两种极端之间的效果。
% 取值 ".5\tabcolsep" 时产生如下效果
% \begin{center}
%\begin{minipage}{.75\textwidth}
%\begin{verbatim}
%|>{\columncolor[gray]{.8}[.5\tabcolsep]}l|
% >{\color{white}%
%   \columncolor[gray]{.2}[.5\tabcolsep]}l|
%\end{verbatim}
%\end{minipage}
% {\bfseries
% \begin{tabular}{%
%   |>{\columncolor[gray]{.8}[.5\tabcolsep]}l|
%   >{\color{white}\columncolor[gray]{.2}[.5\tabcolsep]}l|
%   }
% 一&二\\
%  三&四
%  \end{tabular}}
% \end{center}
%
%
% 本宏包应能与大多数兼容 \textsf{array} 宏包语法的其他宏包配合使用。
% 如下例所示，它尤其可以与 \textsf{longtable} 和 \textsf{dcolumn}
% 协同工作。
%\errorcontextlines10
