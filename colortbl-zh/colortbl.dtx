^^A                     \@height\p@\@depth\p@
%    \end{macrocode}
%
%    \begin{macrocode}
                \hskip\@tempdima\@plus  1fill
        \kern-\@tempdimc
%    \end{macrocode}
% 再加入胶状间距，恰好抵消上述引线。
%    \begin{macrocode}
        \hskip-\wd\z@ \@plus -1fill }
%    \end{macrocode}
% \end{macro}
