%  P 列&另一列&12.34\\
% \multicolumn{1}{G}{合计}&
% \multicolumn{1}{H}{（错误）}&
% \multicolumn{1}{I}{100.6}\\
%  第一列中的一段较长文字&乙&1.2\\
