% \begin{macro}{\CT@@do@color}
% 本宏包的核心：添加彩色底纹。
%
% 插入一条指定颜色的引线，其自然宽度为
% 条目宽度加上指定伸出量及 1fill 伸缩量。
% 两侧以负 kern 包围，使总自然宽度不受伸出量影响。
%    \begin{macrocode}
\def\CT@@do@color{%
  \global\let\CT@do@color\relax
        \@tempdima\wd\z@
        \advance\@tempdima\@tempdimb
        \advance\@tempdima\@tempdimc
        \kern-\@tempdimb
        \leaders\vrule
%    \end{macrocode}
% 为便于用 xdvi（不支持颜色）快速调试，限制线条的尺寸，
% 以便同时看清文字。
