% \section{简介}
% |fgruler| 宏包可在每一页（或当前页）的前景层以绝对位置绘制水平和垂直标尺。
% 借此您可以检查页面版式尺寸。
% 您也可以在正文中绘制各种标尺。
%
% \medskip\noindent
% |fgruler| 宏包依赖以下宏包：|kvoptions|、|etoolbox|、|xcolor|、|graphicx|、|eso-pic|。
%
% \section{加载宏包}
% 使用以下命令加载宏包：
% \begin{flushleft}
% \commandinline|\usepackage[!<宏包选项>!]{fgruler}|
% \end{flushleft}
% 或
% \begin{flushleft}
% \commandinline|\usepackage{fgruler}|\\
% \commandinline|\setfgruler{!<宏包选项>!}|
% \end{flushleft}
% |\setfgruler| 命令也可在正文中使用。
% 
% \section{宏包选项}\label{sec:options}
% 默认情况下，|fgruler| 宏包在每一页的前景层绘制一个方形标尺。
% 以下宏包选项用于设置这些标尺的参数。
% \begin{description}
% \item\commandinline|unit=!<单位>!|\\
% 标尺单位。\commandinline|!<单位>!| 可取的值：
% \begin{description}
% \item\commandinline|cm| 公制标尺（厘米）。默认值。
% \item\commandinline|in| 英制标尺（英寸）。
% \end{description}
%
% \item\commandinline|type=!<类型名称>!|\\
% 决定标尺的原点、方向和长度。\commandinline|!<类型名称>!| 可取的值：
% \begin{description}
% \item\commandinline|upperleft| 默认值。方形标尺（原点：纸张左上角；方向：向下和向右；长度：纸张尺寸）。参见示例 \ref{example:upperleft}。
% \item\commandinline|upperright| 方形标尺（原点：纸张右上角；方向：向下和向左；长度：纸张尺寸）。参见示例 \ref{example:upperright}。
% \item\commandinline|lowerleft| 方形标尺（原点：纸张左下角；方向：向上和向右；长度：纸张尺寸）。参见示例 \ref{example:lowerleft}。
% \item\commandinline|lowerright| 方形标尺（原点：纸张右下角；方向：向上和向左；长度：纸张尺寸）。参见示例 \ref{example:lowerright}。
% \item\commandinline|upperleftT| 方形标尺（原点：文本区域左上角；方向：向下和向右；长度：文本区域尺寸）。参见示例 \ref{example:upperleftT}。
% \item\commandinline|upperrightT| 方形标尺（原点：文本区域右上角；方向：向下和向左；长度：文本区域尺寸）。参见示例 \ref{example:upperrightT}。
% \item\commandinline|lowerleftT| 方形标尺（原点：文本区域左下角；方向：向上和向右；长度：文本区域尺寸）。参见示例 \ref{example:lowerleftT}。
% \item\commandinline|lowerrightT| 方形标尺（原点：文本区域右下角；方向：向上和向左；长度：文本区域尺寸）。参见示例 \ref{example:lowerrightT}。
% \item\commandinline|alledges| 在纸张所有边缘都绘制标尺。
% 顶部标尺原点：纸张左上角（方向：向右）。
% 底部标尺原点：纸张左下角（方向：向右）。
% 左侧标尺原点：纸张左上角（方向：向下）。
% 右侧标尺原点：纸张右上角（方向：向下）。长度：纸张尺寸。参见示例 \ref{example:alledges}。
% \item\commandinline|alledges*| 与 |alledges| 选项类似，但底部标尺原点为纸张右下角（方向：向左），
% 左侧标尺原点为纸张左下角（方向：向上）。
% 参见示例 \ref{example:alledges*}。
% \item\commandinline|alledgesT| 与 |alledges| 选项类似，但绘制在文本区域的边缘。参见示例 \ref{example:alledgesT}。
% \item\commandinline|alledgesT*| 与 |alledges*| 选项类似，但绘制在文本区域的边缘。参见示例 \ref{example:alledgesT*}。
% \item\commandinline|user| 每一对 \commandinline|!<单位>!|--\commandinline|!<类型名称>!| 都会激活一个 \commandinline|\fgrulertype{!<单位>!}{!<类型名称>!}| 命令。
% 因此 \commandinline|\fgrulertype{!<单位>!}{user}| 的展开结果决定了此选项的效果。
% 在使用 \commandinline|\fgrulerdefuser{!<代码>!}| 命令后，它将变为 \commandinline|!<代码>!|，
% 其中在 \commandinline|!<代码>!| 中您必须以 \commandinline|\fgrulerunit| 引用单位。
% 例如，在执行\\ |\fgrulerdefuser{\fgrulertype{\fgrulerunit}{alledges}}|\\ 之后，|type=user| 选项将等价于 |type=alledges|。
% 另请参见示例 \ref{example:user-first}--\ref{example:user-last}。
% \item\commandinline|none| 不绘制标尺。
% \end{description}
%
% \item\commandinline|type={!<类型名称列表>!}|\\
% \commandinline|!<类型名称列表>!| 是以逗号分隔的有效类型名称列表。
% 这些类型将被组合使用。
% 例如 |type={alledges,alledgesT}|。
% 结果参见示例 \ref{example:combining}。
%
% \item\commandinline|hshift=!<长度>!|\\
% 当 \commandinline|!<类型名称>!| 为 |upperleft|、|lowerleft|、|upperright| 或 |lowerright| 时，标尺的水平偏移。
% 当 \commandinline|!<类型名称>!| 为 |upperleft| 或 |lowerleft| 时，偏移方向向右。
% 当 \commandinline|!<类型名称>!| 为 |upperright| 或 |lowerright| 时，偏移方向向左。
% 默认值：|hshift=0cm|。
% 参见示例 \ref{example:shift-first}--\ref{example:shift-last}。
%
% \item\commandinline|vshift=!<长度>!|\\
% 当 \commandinline|!<类型名称>!| 为 |upperleft|、|lowerleft|、|upperright| 或 |lowerright| 时，标尺的垂直偏移。
% 当 \commandinline|!<类型名称>!| 为 |upperleft| 或 |upperright| 时，偏移方向向下。
% 当 \commandinline|!<类型名称>!| 为 |lowerleft| 或 |lowerright| 时，偏移方向向上。
% 默认值：|vshift=0cm|。
% 参见示例 \ref{example:shift-first}--\ref{example:shift-last}。
%
% \item\commandinline|color=!<颜色名称>!|\\
% 标尺颜色（参见 |xcolor| 宏包）。默认值：|color=black|。
% 参见示例 \ref{example:showframe-color}。
%
% \item\commandinline|numsep=!<长度>!|\\
% 数字与标尺之间的间距。默认值：|numsep=3pt|。
%
% \item\commandinline|markthick=!<长度>!|\\
% 刻度线粗细。默认值：|markthick=0.4pt|。
%
% \item\commandinline|marklength=!<长度>!|\\
% 整数单位处的刻度线长度（参见红色刻度）：
% {\fgrulernoborderline\fgrulercaptioncm{}\fgrulerthickcm{}{}{1pt}\fgrulercolorcm{}{}{red}\ruler{rightup}{3cm}}
% 默认值：|marklength=2mm|。其他刻度的长度参见第 \ref{sec:additional} 节。
%
% \item\commandinline|numfont=!<字体类型>!|\\
% 数字字体类型。默认值：|numfont=\scriptsize\sffamily|。此选项仅可用于 |\setfgruler| 和 |\fgruler*| 命令（参见第 \ref{sec:currentpage} 节）。
%
% \item\commandinline|showframe| 或 \commandinline|showframe=true|\\
% 绘制可见的文本区域和边注区域框线，以及页眉和页脚线。
% 其颜色和粗细由 |color| 和 |markthick| 选项决定。
% 参见示例 \ref{example:showframe-color}。
%
% \item\commandinline|showframe=false|\\
% 停用 |showframe| 选项。
%
% \item\commandinline|nonefgrulers|\\
% 终止前景层上所有标尺的绘制，包括由 |\fgruler| 或 |\fgruler*| 生成的标尺（参见第 \ref{sec:currentpage} 节）。
% 但由 |\ruler| 和 |\squareruler| 绘制的标尺（参见第 \ref{sec:intext} 节）不会消失。
% 此外它还会停用 |showframe| 选项。
% 在此情况下，|fgruler| 宏包不会加载 |eso-pic| 宏包。
% 此选项仅在导言区有效。
%
% 建议在以下两种情况下使用：
% \begin{itemize}
% \item 仅在正文中绘制标尺，不需要检查功能时。
% \item 临时暂停检查功能时。
% \end{itemize}
%
% |type=none| 与 |nonefgrulers| 选项并不相同。区别在于：
% \begin{itemize}
% \item |type=none| 不会终止 |\fgruler| 和 |\fgruler*| 命令以及 |showframe| 选项。
% \item |type=none| 可在文档任意位置修改。
% \item 如果使用 |type=none| 选项而不使用 |nonefgrulers|，|fgruler| 宏包仍会加载 |eso-pic| 宏包。
% \end{itemize}
% \end{description}
% 
% \section{在当前页前景层绘制标尺}\label{sec:currentpage}
% \begin{description}
% \item\commandinline|\fgruler[!<单位!>]{!<类型名称>!}{!<水平偏移>!}{!<垂直偏移>!}|\\
% 在本命令展开所在页的前景层绘制一个方形标尺。
% 您可以在同一页使用多个 |\fgruler| 命令。
%
% 宏包选项（参见第 \ref{sec:options} 节）对此命令同样有效，但 |type|、|hshift| 和 |vshift| 除外。
%
% 如果在导言区使用了 |nonefgrulers| 宏包选项，此命令无效。
% \begin{description}
% \item\commandinline|!<单位!>| 选项：
% \commandinline|cm|、\commandinline|in|（参见第 \ref{sec:options} 节）。
% 其默认值与 |unit=|\commandinline|!<单位!>| 宏包选项指定的值相同。
%
% \item\commandinline|!<类型名称!>| 参数：
% \commandinline|upperleft|、\commandinline|upperright|、\commandinline|lowerleft|、\commandinline|lowerright|（参见第 \ref{sec:options} 节）。
%
% \item\commandinline|!<水平偏移>!|
% 水平偏移量。
% 当 \commandinline|!<类型名称>!| 为 |upperleft| 或 |lowerleft| 时偏移方向向右，否则向左。
%
% \item\commandinline|!<垂直偏移>!|
% 垂直偏移量。
% 当 \commandinline|!<类型名称>!| 为 |upperleft| 或 |upperright| 时偏移方向向下，否则向上。
% \end{description}
%
% 示例：|\fgruler[in]{upperright}{1in}{2.5in}|
% \end{description}
% \begin{description}
% \item\commandinline|\fgruler*[!<宏包选项!>]{!<类型名称>!}|\\
% 在本命令展开所在页的前景层绘制一个标尺。
% 您可以在同一页使用多个 |\fgruler*| 命令。
%
% 宏包选项（参见第 \ref{sec:options} 节）对此命令同样有效，但 |type| 除外。
%
% 如果在导言区使用了 |nonefgrulers| 宏包选项，此命令无效。
% \begin{description}
% \item\commandinline|!<宏包选项!>|
% 第 \ref{sec:options} 节中的所有选项，但 |type|、|showframe| 和 |nonefgrulers| 除外。
%
% \item\commandinline|!<类型名称!>|
% 第 \ref{sec:options} 节中 |type| 选项的所有可能值，但 |none| 值除外。
% \end{description}
%
% 示例：|\fgruler*[color=red,type=in]{alledges}|
%
% 请注意以下两条命令等价：\\
% |\fgruler*[unit=in,hshift=1in,vshift=2.5in]{upperright}|\\
% |\fgruler[in]{upperright}{1in}{2.5in}|
% \end{description}
% 
% \section{在正文中绘制标尺}\label{sec:intext}
% \begin{description}
% \item\commandinline|\ruler[!<单位!>]{!<类型名称>!}{!<长度>!}|\\
% 绘制一个水平或垂直标尺。
% 标尺底部与周围文本的基线对齐。
% 宏包选项（参见第 \ref{sec:options} 节）对此命令无效。
% \begin{description}
% \item\commandinline|!<单位!>| 选项：\\
% \commandinline|cm| 公制标尺（厘米）。默认选项。\\
% \commandinline|in| 英制标尺（英寸）。
%
% \item\commandinline|!<类型名称!>| 参数：\\
% \commandinline|downright | 方向：向下。数字在右侧。\\
% \commandinline|downleft  | 方向：向下。数字在左侧。\\
% \commandinline|upright   | 方向：向上。数字在右侧。\\
% \commandinline|upleft    | 方向：向上。数字在左侧。\\
% \commandinline|rightdown | 方向：向右。数字在下侧。\\
% \commandinline|rightup   | 方向：向右。数字在上侧。\\
% \commandinline|leftdown  | 方向：向左。数字在下侧。\\
% \commandinline|leftup    | 方向：向左。数字在上侧。\\
% \commandinline|taperight | 卷尺（方向：向右）。参见示例 \ref{example:tape}。\\
% \commandinline|tapeleft  | 卷尺（方向：向左）。参见示例 \ref{example:tape}。
%
% \item\commandinline|!<长度>!|
% 标尺长度。
% \end{description}
%
% 示例：|\ruler{rightdown}{5cm}| \ruler{rightdown}{5cm}
%
% \item\commandinline|\ruler*[!<单位!>]{!<类型名称>!}{!<长度>!}|\\
% 与 |\ruler| 类似，但标尺顶部与周围文本的基线对齐。
%
% 示例：
% |\ruler*{taperight}{5cm}|
% \ruler*{taperight}{5cm}
%
% \item\commandinline|\squareruler[!<单位!>]{!<类型名称>!}{!<宽度>!}{!<高度>!}|\\
% 绘制一个方形标尺。
% 方形标尺底部与周围文本的基线对齐。
