%
% 示例：|{\fgrulerstartnumh{5}\squareruler{lowerleft}{3cm}{1cm}}| {\fgrulerstartnumh{5}\squareruler{lowerleft}{3cm}{1cm}}
%
% \item\commandinline|\fgrulerstartnumv{!<数字>!}|\\
% \commandinline|!<数字>!| 为非负整数，作为垂直标尺上的起始数字。
% 默认值：|\fgrulerstartnumv{0}|
%
% 示例：|{\fgrulerstartnumv{5}\squareruler{lowerleft}{3cm}{1cm}}| {\fgrulerstartnumv{5}\squareruler{lowerleft}{3cm}{1cm}}
%
% \item\commandinline|\fgrulernoborderline|\\
% 默认情况下，标尺的一侧有边框线。
