% \begin{description}
% \item\commandinline|!<单位!>| 选项：\\
% \commandinline|cm| 公制标尺（厘米）。默认选项。\\
% \commandinline|in| 英制标尺（英寸）。
%
% \item\commandinline|!<类型名称!>| 参数：\\
% \commandinline|upperleft | 方向：向下和向右。\\
% \commandinline|upperright| 方向：向下和向左。\\
% \commandinline|lowerleft | 方向：向上和向右。\\
% \commandinline|lowerright| 方向：向上和向左。
%
% \item\commandinline|!<宽度>!|
% 方形标尺宽度。
%
% \item\commandinline|!<高度>!|
% 方形标尺高度。
% \end{description}
%
% 示例：
